#Область КД3_РедакторКодаКлиент

Процедура КД3_ОбработчикПриОткрытии(Форма) Экспорт
	
	Если рк_РедакторКодаКлиент.ИспользоватьРедактор(Форма) Тогда
		Форма.ПодключитьОбработчикОжидания("Подключаемый_КД3_ОбработчикОжиданияПроверитьИзменениеОбъекта", 1, Ложь);
	КонецЕсли;
	
	ОбщиеПараметры = рк_РедакторКодаКлиентСервер.ОбщиеПараметры(Форма);
	Если ОбщиеПараметры.КД3_ИмяКонтекста = "Конвертации" И НЕ ОбщиеПараметры.КД3_ЭтоКонвертацияXDTO Тогда
		// Для конвертации XDTO форма сразу открывается на странице с обработчиками и нужно вызвать инициализацию при смене страницы
		рк_РедакторКодаКлиент.ОбработчикПриСменеСтраницы(Форма, Форма.Элементы.ОбработчикиXML.ТекущаяСтраница);
		
	ИначеЕсли ОбщиеПараметры.КД3_ИмяКонтекста = "Запросы" ИЛИ (НЕ ОбщиеПараметры.КД3_ЭтоКонвертацияXDTO И ОбщиеПараметры.КД3_ИмяКонтекста = "Алгоритмы") Тогда
		// Для запросов и алгоритмов конвертации XML добавляются две страницы для обработчки флага "Использовать при загрузке"
		рк_РедакторКодаКлиент.ОбработчикПриСменеСтраницы(Форма, Форма.Элементы.КД3_СтраницыОбработчики.ТекущаяСтраница);
		
	КонецЕсли;
	
КонецПроцедуры

Процедура КД3_ОбработчикОбработкаОповещения(Форма, ИмяСобытия, Параметры, Источник) Экспорт
	
	Если ИмяСобытия = "ИзмененСтатусЗахвата" И ИспользоватьРедактор(Форма) И Источник = Форма.Объект.Ссылка И Форма.СовместнаяРабота Тогда
		// При изменении захвата всегда перечитывается объект и обновляются обработчики
		Для Каждого ЭлементСписка Из рк_РедакторКодаКлиентСервер.ПараметрыВсехРедакторов(Форма) Цикл
			ОбновитьТекстРедактораПоРеквизитуТекст(Форма, ЭлементСписка.Значение);
		КонецЦикла;
		
		// ОбработчикИзмененияТолькоПросмотрФормы(Форма);
		ОбщиеПараметры = рк_РедакторКодаКлиентСервер.ОбщиеПараметры(Форма);
		Для Каждого ЭлементСписка Из рк_РедакторКодаКлиентСервер.ПараметрыВсехРедакторов(Форма) Цикл
			ПараметрыРедактора = ЭлементСписка.Значение;
			
			ЭлементHTML = Форма.Элементы.Найти(ПараметрыРедактора.ИмяЭлементаHTML);
			ТолькоПросмотр = Форма.ТолькоПросмотр ИЛИ ЭлементHTML.ТолькоПросмотр;
			РедакторView = View(Форма, ПараметрыРедактора);
			Если РедакторView.getReadOnly() <> ТолькоПросмотр Тогда
				РедакторView.setReadOnly(ТолькоПросмотр);
				
				Если НЕ ТолькоПросмотр И ОбщиеПараметры.ПодсказкаПоМетаданным Тогда
					ИнициализироватьМетаданныеРедактора(Форма, ПараметрыРедактора);
				КонецЕсли;
			КонецЕсли;
			
		КонецЦикла;
	КонецЕсли;
	
	рк_РедакторКодаКлиент.ОбработчикОбработкаОповещения(Форма, ИмяСобытия, Параметры, Источник);
	
КонецПроцедуры

Процедура КД3_ОбновитьЛокальныйКонтекстКонвертации(Форма) Экспорт
	
	ОбщиеПараметры = рк_РедакторКодаКлиентСервер.ОбщиеПараметры(Форма);
	
	ЗначениеПараметры = Новый Соответствие;
	ЗначениеПараметры[Ложь] = Новый Структура;
	Если НЕ ОбщиеПараметры.КД3_ЭтоКонвертацияXDTO Тогда
		ЗначениеПараметры[Истина] = Новый Структура;
	КонецЕсли;
	
	Для Каждого СтрокаПараметра Из Форма.Объект.Параметры Цикл
		ДляКорреспондента = СтрокаПараметра.ИспользуетсяПриЗагрузке ИЛИ СтрокаПараметра.ПередаватьПараметрПриВыгрузке;
		ЗначениеПараметры[ДляКорреспондента].Вставить(СтрокаПараметра.Параметр);
	КонецЦикла;
	
	Для Каждого ЭлементСписка Из рк_РедакторКодаКлиентСервер.ПараметрыВсехРедакторов(Форма) Цикл
		ПараметрыРедактора = ЭлементСписка.Значение;
		
		Если ОбщиеПараметры.КД3_ЭтоКонвертацияXDTO Тогда
			рк_РедакторКодаВызовСервера.ДобавитьПеременную(ПараметрыРедактора.АдресКонтекст, "КомпонентыОбмена.ПараметрыКонвертации", ЗначениеПараметры[Ложь]);
		Иначе
			рк_РедакторКодаВызовСервера.ДобавитьПеременную(ПараметрыРедактора.АдресКонтекст, "Параметры", ЗначениеПараметры[ПараметрыРедактора.КД3_ДляКорреспондента]);
		КонецЕсли;
		
		рк_РедакторКодаКлиент.ИнициализироватьКонтекст(Форма, ПараметрыРедактора);
		
	КонецЦикла;
	
КонецПроцедуры

Процедура КД3_ИспользуетсяПриЗагрузкеПриИзменении(Форма) Экспорт
	
	Если ИспользоватьРедактор(Форма) Тогда
		Если Форма.Объект.ИспользуетсяПриЗагрузке Тогда
			Если ОбновитьРеквизитТекстПоТекстуРедактора(Форма, Форма.Элементы.КД3_ОбработчикПриВыгрузке) Тогда
				ОбновитьТекстРедактораПоРеквизитуТекст(Форма, Форма.Элементы.КД3_ОбработчикПриЗагрузке);
			КонецЕсли;
		Иначе
			Если ОбновитьРеквизитТекстПоТекстуРедактора(Форма, Форма.Элементы.КД3_ОбработчикПриЗагрузке) Тогда
				ОбновитьТекстРедактораПоРеквизитуТекст(Форма, Форма.Элементы.КД3_ОбработчикПриВыгрузке);
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	// Имитация переключения страницы обработчиков
	Если Форма.Объект.ИспользуетсяПриЗагрузке Тогда
		ТекущаяСтраница = Форма.Элементы.КД3_ОбработчикПриЗагрузкеСтраница;
	Иначе
		ТекущаяСтраница = Форма.Элементы.КД3_ОбработчикПриВыгрузкеСтраница;
	КонецЕсли;
	Форма.Элементы.КД3_СтраницыОбработчики.ТекущаяСтраница = ТекущаяСтраница;
	
	ОбработчикПриСменеСтраницы(Форма, ТекущаяСтраница);
	
КонецПроцедуры

#КонецОбласти

#Область ПрограммныйИнтерфейс

#Область Инициализация

Функция ИспользоватьРедактор(Форма, НовоеЗначение = Неопределено) Экспорт
	
	ОбщиеПараметры = рк_РедакторКодаКлиентСервер.ОбщиеПараметры(Форма);
	Если НовоеЗначение = Неопределено Тогда
		НовоеЗначение = ОбщиеПараметры <> Неопределено И ОбщиеПараметры.ИспользоватьРедактор;
	ИначеЕсли ОбщиеПараметры <> Неопределено Тогда
		ОбщиеПараметры.ИспользоватьРедактор = НовоеЗначение;
	КонецЕсли;
	Возврат НовоеЗначение;
	
КонецФункции

Процедура ОбработчикПриСменеСтраницы(Форма, ИмяСтраницыИлиСтраница) Экспорт
	
	ПараметрыРедактора = НайтиРедакторНаСтранице(Форма, ИмяСтраницыИлиСтраница);
	Если ПараметрыРедактора <> Неопределено Тогда
		Если ИспользоватьРедактор(Форма) Тогда
			УстановитьВебСтраницуРедактора(Форма, ПараметрыРедактора);
		Иначе
			// Сохранение последнего видимого редактора для установки его веб-страницы при включении редактора,
			// т.к. при включении редактора не будет вызвано событие ПриСменеСтраницы
			ОбщиеПараметры = рк_РедакторКодаКлиентСервер.ОбщиеПараметры(Форма);
			ОбщиеПараметры.Вставить("ПоследнийРедакторНаСтранице", ПараметрыРедактора.ИмяЭлементаHTML);
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

Функция ОбработчикПередЗаписью(Форма) Экспорт
	
	Если НЕ ИспользоватьРедактор(Форма) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	ЕстьИзменения = Ложь;
	
	Для Каждого ЭлементСписка Из рк_РедакторКодаКлиентСервер.ПараметрыВсехРедакторов(Форма) Цикл
		ПараметрыРедактора = ЭлементСписка.Значение;
		Если ОбновитьРеквизитТекстПоТекстуРедактора(Форма, ПараметрыРедактора) Тогда
			ЕстьИзменения = Истина;
		КонецЕсли;
	КонецЦикла;
	
	Возврат ЕстьИзменения;
	
КонецФункции

Процедура ОбработчикОбработкаОповещения(Форма, ИмяСобытия, Параметры, Источник) Экспорт
	
	Если Источник <> Неопределено И Источник <> Форма Тогда
		Возврат; // Это и именение настроек другой формы
	КонецЕсли;
	
	Если ИмяСобытия = "рк_ИзменениеИспользоватьРедактор" Тогда
		ОбновитьИспользоватьРедактор(Форма, Источник = Неопределено, Параметры);
	КонецЕсли;
	Если ИмяСобытия = "рк_ИзменениеПодсказкаПоМетаданным" Тогда
		ОбновитьПодсказкаПоМетаданным(Форма, Источник = Неопределено, Параметры);
	КонецЕсли;
	Если ИмяСобытия = "рк_ИзменениеНастройки" Тогда
		ОбновитьНастройки(Форма, Источник = Неопределено);
	КонецЕсли;
	Если ИмяСобытия = "рк_ИзменениеНастройкиКонфигурации" Тогда
		ОбновитьНастройкиКонфигурации(Форма, Источник = Неопределено, Параметры);
	КонецЕсли;
	
КонецПроцедуры

// Обработчик события ДокументСформирован поля HTML.
// Вызывать из обработчика события ДокументСформирован.
// 
// Параметры:
//   Форма - ФормаКлиентскогоПриложения
//   ИмяЭлементаHTML - Строка - если не указано, берется из формы
//
// Пример:
//   &НаКлиенте
//   Процедура HTMLДокументСформирован(Элемент)
//       рк_РедакторКодаКлиент.ОбработчикДокументСформирован(ЭтаФорма);
//   КонецПроцедуры
//
Процедура ОбработчикДокументСформирован(Форма, ИмяИлиЭлементHTML, ОтложеннаяИнициализация = Ложь) Экспорт
	
	ИнициализироватьРедактор(Форма, ИмяИлиЭлементHTML, ОтложеннаяИнициализация);
	
КонецПроцедуры

Процедура ОбработчикДокументСформированОтложено(Форма) Экспорт
	
	ОбщиеПараметры = рк_РедакторКодаКлиентСервер.ОбщиеПараметры(Форма);
	
	ОтложенаяИнициализация =  рк_РедакторКодаКлиентСервер.СвойствоСтруктуры(ОбщиеПараметры, "ОтложенаяИнициализация", Новый Массив);
	
	Для Каждого ИмяЭлементаHTML Из ОтложенаяИнициализация Цикл
		ИнициализироватьМетаданныеРедактора(Форма, ИмяЭлементаHTML);
	КонецЦикла;
	
КонецПроцедуры

// Обработчик события ПриНажатии поля HTML.
// Вызывать из обработчика события ПриНажатии (OnClick).
// 
// Параметры:
//   Форма - ФормаКлиентскогоПриложения
//   ДанныеСобытия - Структура
//   ИмяЭлементаHTML - Строка - если не указано, берется из формы
//
// Пример:
//   &НаКлиенте
//   Процедура HTMLПриНажатии(Элемент, ДанныеСобытия, СтандартнаяОбработка)
//       рк_РедакторКодаКлиент.ОбработчикПриНажатии(ЭтаФорма, ДанныеСобытия);
//   КонецПроцедуры
//
//Процедура ОбработчикПриНажатии(Форма, ДанныеСобытия, ИмяИлиЭлементHTML = Неопределено) Экспорт
Процедура ОбработчикПриНажатии(Форма, ИмяИлиЭлементHTML, ДанныеСобытия, ОбработчикиСобытий = Неопределено) Экспорт
	
	ОбработатьСобытиеРедактора(Форма, ИмяИлиЭлементHTML, ДанныеСобытия, ОбработчикиСобытий);
	
КонецПроцедуры

Функция ПроверитьИзменениеОбъекта(Форма, НоваяВерсияДанных) Экспорт
	
	ОбщиеПараметры = рк_РедакторКодаКлиентСервер.ОбщиеПараметры(Форма);
	Если ОбщиеПараметры = Неопределено Тогда
		Возврат Ложь; // Редактор не используется
	КонецЕсли;
	
	ТекущаяВерсияДанных = Неопределено;
	Если ОбщиеПараметры.Свойство("ВерсияДанныхОбъекта", ТекущаяВерсияДанных) И ТекущаяВерсияДанных = НоваяВерсияДанных Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Если ТекущаяВерсияДанных = Неопределено Тогда
		ОбщиеПараметры.Вставить("ВерсияДанныхОбъекта", НоваяВерсияДанных);
		Возврат Ложь;
	КонецЕсли;
	
	Для Каждого ЭлементСписка Из рк_РедакторКодаКлиентСервер.ПараметрыВсехРедакторов(Форма) Цикл
		ПараметрыРедактора = ЭлементСписка.Значение;
		Если НЕ ПараметрыРедактора.Свойство("ФлагНеИнициализирован") Тогда
			ТекстОбработчика = рк_РедакторКодаКлиент.ПолучитьЗначениеРеквизитаТекст(Форма, ПараметрыРедактора);
			РедакторView = рк_РедакторКодаКлиент.View(Форма, ПараметрыРедактора);
			РедакторView.updateText(ТекстОбработчика);
		КонецЕсли;
	КонецЦикла;
	
	ОбщиеПараметры.Вставить("ВерсияДанныхОбъекта", НоваяВерсияДанных);
	
	Возврат Истина;
	
КонецФункции

Процедура ПереключитьРедакторыНаHTML(Форма) Экспорт
	
	ИспользоватьРедактор(Форма, Истина);
	
	ОбщиеПараметры = рк_РедакторКодаКлиентСервер.ОбщиеПараметры(Форма);
	ВсеРедакторы = рк_РедакторКодаКлиентСервер.ПараметрыВсехРедакторов(Форма);
	
	Если ОбщиеПараметры.Свойство("ПоследнийРедакторНаСтранице") Тогда
		// На форме есть обработчик установки веб-страницы редактора при переключении на его страницу
		// Установка веб-страницы для редактора, который должен был бы видимым при последнем переключении страницы
		ПараметрыРедактора = рк_РедакторКодаКлиентСервер.ПараметрыРедактора(Форма, ОбщиеПараметры.ПоследнийРедакторНаСтранице);
		УстановитьВебСтраницуРедактора(Форма, ПараметрыРедактора);
	Иначе
		Для Каждого ЭлементСписка Из ВсеРедакторы Цикл
			ПараметрыРедактора = ЭлементСписка.Значение;
			УстановитьВебСтраницуРедактора(Форма, ПараметрыРедактора);
		КонецЦикла;
	КонецЕсли;
	
	Для Каждого ЭлементСписка Из ВсеРедакторы Цикл
		ПараметрыРедактора = ЭлементСписка.Значение;
		
		ЭлементHTML = Форма.Элементы.Найти(ПараметрыРедактора.ИмяЭлементаHTML);
		Если ЭлементHTML.Видимость Тогда
			Возврат; // Элемент HTML уже видимый
		КонецЕсли;
		
		Если ПараметрыРедактора.Свойство("ИмяЭлементаТекст") Тогда
			Форма.Элементы.Найти(ПараметрыРедактора.ИмяЭлементаТекст).Видимость = Ложь;
		КонецЕсли;
		ЭлементHTML.Видимость = Истина;
	КонецЦикла;
	
КонецПроцедуры

Процедура ПереключитьРедакторыНаТекст(Форма) Экспорт
	
	ЕстьЭлементТекст = Ложь; // Связанных текстовых элементов может и не быть
	
	Для Каждого ЭлементСписка Из рк_РедакторКодаКлиентСервер.ПараметрыВсехРедакторов(Форма) Цикл
		ПараметрыРедактора = ЭлементСписка.Значение;
		
		Если ПараметрыРедактора.Свойство("ИмяЭлементаТекст") Тогда
			ОбновитьРеквизитТекстПоТекстуРедактора(Форма, ПараметрыРедактора);
			
			Форма.Элементы.Найти(ПараметрыРедактора.ИмяЭлементаТекст).Видимость = Истина;
			Форма.Элементы.Найти(ПараметрыРедактора.ИмяЭлементаHTML).Видимость = Ложь;
			
			ЕстьЭлементТекст = Истина;
		КонецЕсли;
		
	КонецЦикла;
	
	Если ЕстьЭлементТекст Тогда
		ИспользоватьРедактор(Форма, Ложь);
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область РаботаСТекстом

Функция Модифицированность(Форма, Редактор = Неопределено) Экспорт
	
	Возврат View(Форма, Редактор).isContentModified();
	
КонецФункции

Процедура СброситьМодифицированность(Форма, Редактор = Неопределено) Экспорт
	
	View(Форма, Редактор).resetContentModified();
	
КонецПроцедуры

Процедура ОчиститьТекст(Форма, Редактор = Неопределено) Экспорт
	
	View(Форма, Редактор).eraseText();
	
КонецПроцедуры

// Получает текст из редактора
// 
// Параметры:
//   Форма - ФормаКлиентскогоПриложения
//   ИмяИлиЭлементHTML - Строка, ПолеФормы
//
// Возвращаемое значение:
//   Строка - текст из редактора
//
Функция ПолучитьТекст(Форма, Редактор = Неопределено) Экспорт
	
	Возврат View(Форма, Редактор).getText();
	
КонецФункции

// Устанавливает текст в редактор
// 
// Параметры:
//   Форма - ФормаКлиентскогоПриложения
//   Текст - Строка - текст для установки
//   Позиция - Число - позиция курсора (0 - в начало, -1 - в конец)
//   УчитыватьОтступПервойСтроки - Булево
//   ИмяИлиЭлементHTML - Строка, ПолеФормы
//
Процедура УстановитьТекст(Форма, Текст, Позиция = 0, УчитыватьОтступПервойСтроки = Ложь, Редактор = Неопределено) Экспорт
	
	View(Форма, Редактор).setText(Текст, Позиция, УчитыватьОтступПервойСтроки);
	
КонецПроцедуры

// Устанавливает режим языка редактора
// 
// Параметры:
//   Форма - ФормаКлиентскогоПриложения
//   РежимЯзыка - Строка - "bsl", "bsl_query", "dcs_query", "xml", "json", "yaml"
//   ИмяИлиЭлементHTML - Строка, ПолеФормы
//
// Пример:
//   рк_РедакторКодаКлиент.УстановитьРежимЯзыка(ЭтотОбъект, "json");
//
Процедура УстановитьРежимЯзыка(Форма, РежимЯзыка, Редактор = Неопределено) Экспорт
	
	View(Форма, Редактор).setLanguageMode(РежимЯзыка);
	
КонецПроцедуры

#КонецОбласти

#Область НастройкиРедактора

// Применяет настройки к редактору.
// 
// Параметры:
//   Форма - ФормаКлиентскогоПриложения
//   Настройки - Структура - настройки из хранилища
//   ИмяЭлементаHTML - Строка
//
Процедура ПрименитьНастройки(Форма, Настройки, Редактор)
	
	РедакторView = View(Форма, Редактор);
	
	// Тема
	Если Настройки.Свойство("Тема") И ЗначениеЗаполнено(Настройки.Тема) Тогда
		РедакторView.setTheme(Настройки.Тема);
	КонецЕсли;
	
	// Быстрые подсказки
	Если Настройки.Свойство("БыстрыеПодсказки") Тогда
		РедакторView.enableQuickSuggestions(Настройки.БыстрыеПодсказки);
	КонецЕсли;
	
	// Карта кода
	Если Настройки.Свойство("КартаКода") Тогда
		РедакторView.minimap(Настройки.КартаКода);
	КонецЕсли;
	
	// Пробелы и табуляции
	Если Настройки.Свойство("ПробелыИТабуляции") Тогда
		РедакторView.renderWhitespace(Настройки.ПробелыИТабуляции);
	КонецЕсли;
	
	// Строка состояния
	Если Настройки.Свойство("СтрокаСостояния") И Настройки.СтрокаСостояния Тогда
		РедакторView.showStatusBar();
	Иначе
		РедакторView.hideStatusBar();
	КонецЕсли;
	
	// Язык подсказок
	Если Настройки.Свойство("ЯзыкПодсказок") И Настройки.ЯзыкПодсказок = "en" Тогда
		РедакторView.switchLang();
	КонецЕсли;
	
	// Отключение встроенных сниппетов
	Если Настройки.Свойство("ОтключитьВстроенныеСниппеты") И Настройки.ОтключитьВстроенныеСниппеты Тогда
		РедакторView.clearSnippets();
	КонецЕсли;
	
	// Загрузка сниппетов из файла шаблонов (.st)
	//Если Настройки.Свойство("ПутьКШаблонамКода") И ЗначениеЗаполнено(Настройки.ПутьКШаблонамКода) Тогда
	//	ЗагрузитьСниппетыИзФайла(Форма, Настройки.ПутьКШаблонамКода, ИмяЭлементаHTML);
	//КонецЕсли;
	
	// Включаем поддержку отладки в редакторе
	РедакторView.setUsingDebugger(Ложь);
	
КонецПроцедуры

// Открывает форму настроек редактора. После завершения редактирования могут быть отправлены оповещения в обработчик формы "Обработка оповещения"
// "ИзменениеИспользоватьРедактор", "рк_ИзменениеНастройки", "рк_ИзменениеНастройкиКонфигурации", если были изменены соответствующие настройки
//
// Параметры:
//  ВладелецФормы - Неопределено, Форма - если форма указана, то настройки редактуруются только для указанной формы, иначе как глобальные
//      При сохранении настроек, если настройки были изменены, то будут отправлены оповещения с Источник = ВладелецФормы
//  Конфигурация - Неопределено, Любое значение - вместе с ВладелецФормы определяет порядок редактирования настроек конфигурации (каталог исходников и т.п.). Варианты:
//      1. Редактирование глобальных настроек текущей конфигурации - ВладелецФормы и Конфигурация = Неопределено
//      2. Редактирование настроек текущей конфигурации в форме с обновлением при изменении глобальных настроек - ВладелецФормы указан, Конфигурация = Неопределено, есть настройки конфигурации рк_РедакторКодаКлиентСервер.ОбщиеПараметры(Форма).Конфигурации[Неопределено]
//      3. Редактирование настроек произвольной конфигурации в форме с обновлением при изменении настроек этой конфигурации - ВладелецФормы и Конфигурация указаны, есть настройки конфигурации рк_РедакторКодаКлиентСервер.ОбщиеПараметры(Форма).Конфигурации[Конфигурация]
//      4. Настройки конфигурации в форме не редактируются - ВладелецФормы и Конфигурация указаны, нет настроек в рк_РедакторКодаКлиентСервер.ОбщиеПараметры(Форма).Конфигурации[Конфигурация]
//      При сохранении настроек, если настройки конфигурации были изменены, то для вариантов 1-3 будет отправлено оповещение "рк_ИзменениеНастройкиКонфигурации" с Параметры.Конфигурация
//  ВозможноОтключениеРедактора - Булево - Истина, если доступна опция "Использовать редактор", Ложь - если на форме только редакторы HTML
//
Процедура ОткрытьНастройкиРедактора(ВладелецФормы = Неопределено, Конфигурация = Неопределено) Экспорт
	
	ПараметрыФормы = Новый Структура;
	
	ПараметрыФормы.Вставить("НеДоступноОтключениеРедактора", Ложь);
	
	Если ВладелецФормы = Неопределено Тогда
		РежимОткрытия = Неопределено;
	Иначе
		РежимОткрытия = РежимОткрытияОкнаФормы.БлокироватьОкноВладельца;
		
		// Проверка возможности отключение редактора при наличии связанных элементов Текст
		ВсеРедакторы = рк_РедакторКодаКлиентСервер.ПараметрыВсехРедакторов(ВладелецФормы);
		Если ВсеРедакторы <> Неопределено Тогда
			ПараметрыФормы.НеДоступноОтключениеРедактора = Истина;
			Для Каждого ЭлементСписка Из ВсеРедакторы Цикл
				Если ЭлементСписка.Значение.Свойство("ИмяЭлементаТекст") Тогда
					ПараметрыФормы.НеДоступноОтключениеРедактора = Ложь;
					Прервать; // Найден редактор, который может быть переключен в режим Текст
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
		
		ОбщиеПараметры = рк_РедакторКодаКлиентСервер.ОбщиеПараметры(ВладелецФормы);
		Если ОбщиеПараметры = Неопределено Тогда
			Возврат; // Владелец формы не содержит редакторы
		КонецЕсли;
		ПараметрыФормы.Вставить("ИспользоватьРедактор", ОбщиеПараметры.ИспользоватьРедактор);
		ПараметрыФормы.Вставить("АдресНастройки", ОбщиеПараметры.АдресНастройки);
		ПараметрыФормы.Вставить("АдресНастройкиКонфигурации", ОбщиеПараметры.НастройкиКонфигурации[Конфигурация]);
	КонецЕсли;
	
	ОткрытьФорму("ОбщаяФорма.рк_НастройкиРедактораКода", ПараметрыФормы, ВладелецФормы,,,,, РежимОткрытия);
	
КонецПроцедуры

#КонецОбласти

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

#Область Инициализация

Процедура ИнициализироватьРедактор(Форма, Редактор, ОтложеннаяИнициализация)
	
	ПараметрыРедактора = рк_РедакторКодаКлиентСервер.ПараметрыРедактора(Форма, Редактор);
	
	РедакторView = View(Форма, ПараметрыРедактора);
	Если РедакторView = Неопределено Тогда
		Возврат; // Страница редактора не отобразилась корректно
	КонецЕсли;
	
	ОбщиеПараметры = рк_РедакторКодаКлиентСервер.ОбщиеПараметры(Форма);
	
	Настройки = ПолучитьИзВременногоХранилища(ОбщиеПараметры.АдресНастройки);
	Если ПараметрыРедактора.Свойство("АдресНастройки") Тогда
		// Замена глобальных настроек на постоянные настройки, заданных для редактора
		ЗаполнитьЗначенияСвойств(Настройки, ПолучитьИзВременногоХранилища(ПараметрыРедактора.АдресНастройки));
	КонецЕсли;
	
	Если НЕ ПараметрыРедактора.Свойство("ФлагНеИнициализирован") Тогда
		
		// Повторное отображение инициализированного редактора
		ОбновитьТекстРедактораПоРеквизитуТекст(Форма, ПараметрыРедактора);
		
		Если ПараметрыРедактора.Свойство("ФлагНетНастроек") Тогда
			ПрименитьНастройки(Форма, Настройки, ПараметрыРедактора.ИмяЭлементаHTML);
			ПараметрыРедактора.Удалить("ФлагНетНастроек");
		КонецЕсли;
		
		Возврат;
	КонецЕсли;
	
	// Инициализация редактора
	
	Инфо = Новый СистемнаяИнформация;
	
	РедакторView.init(Инфо.ВерсияПриложения);
	
	РедакторView.setOption("autoResizeEditorLayout", Истина);
	РедакторView.setOption("renderQueryDelimiters", Истина);
	РедакторView.hideScrollX();
	РедакторView.hideScrollY();
	
	ТолькоПросмотр = Форма.ТолькоПросмотр ИЛИ Форма.Элементы.Найти(ПараметрыРедактора.ИмяЭлементаHTML).ТолькоПросмотр;
	Если ТолькоПросмотр Тогда
		РедакторView.setReadOnly(Истина);
	КонецЕсли;
	
	// Генерация нового события EVENT_CONTENT_MODIFIED
	РедакторView.setOption("generateContentModifiedEvent", Истина);
	
	ПрименитьНастройки(Форма, Настройки, ПараметрыРедактора.ИмяЭлементаHTML);
	
	Если ПараметрыРедактора.Свойство("РежимЯзыка") Тогда
		РедакторView.setLanguageMode(ПараметрыРедактора.РежимЯзыка);
	Иначе
		РедакторView.setLanguageMode("bsl");
	КонецЕсли;
	
	РедакторView.clearMetadata();
	
	ПараметрыРедактора.Удалить("ФлагНеИнициализирован");
	
	ОбновитьТекстРедактораПоРеквизитуТекст(Форма, ПараметрыРедактора);
	
	// Инициализация метаданных
	
	Если НЕ ОбщиеПараметры.ПодсказкаПоМетаданным Тогда
		Возврат;
	КонецЕсли;
	
	Если ОтложеннаяИнициализация Тогда
		ОтложенаяИнициализация = рк_РедакторКодаКлиентСервер.СвойствоСтруктуры(ОбщиеПараметры, "ОтложенаяИнициализация", Новый Массив);
		Если ОтложенаяИнициализация.Найти(ПараметрыРедактора.ИмяЭлементаHTML) = Неопределено Тогда
			ОтложенаяИнициализация.Добавить(ПараметрыРедактора.ИмяЭлементаHTML);
		КонецЕсли;
	Иначе
		ИнициализироватьМетаданныеРедактора(Форма, ПараметрыРедактора.ИмяЭлементаHTML);
	КонецЕсли;
	
КонецПроцедуры

Процедура ИнициализироватьМетаданныеРедактора(Форма, Редактор)
	
	ПараметрыРедактора = рк_РедакторКодаКлиентСервер.ПараметрыРедактора(Форма, Редактор);
	
	Если НЕ ПараметрыРедактора.Свойство("ФлагНетМетаданных") Тогда
		Возврат; // Метаданные уже загружены
	КонецЕсли;
	
	ИнициализироватьКонтекст(Форма, ПараметрыРедактора);
	
	АдресГлобальныйКонтекст = ИнициализироватьГлобальныйКонтекст(Форма, ПараметрыРедактора.Конфигурация);
	Если АдресГлобальныйКонтекст = Неопределено Тогда
		Возврат; // Запущено получение в фоне или произошла ошибка
	Конецесли;
	
	РедакторView = View(Форма, ПараметрыРедактора);
	Если РедакторView = Неопределено Тогда
		Возврат; // Редактор не инициализирован
	КонецЕсли;
	
	РезультатыЗапроса = ПолучитьИзВременногоХранилища(АдресГлобальныйКонтекст);
	ОбработатьРезультатыЗапросаМетаданных(РедакторView, РезультатыЗапроса);

	ПараметрыРедактора.Удалить("ФлагНетМетаданных");
	
КонецПроцедуры

Процедура СброситьМетаданныеРедактора(Форма, Редактор) Экспорт
	
	ПараметрыРедактора = рк_РедакторКодаКлиентСервер.ПараметрыРедактора(Форма, Редактор);
	
	РедакторView = View(Форма, ПараметрыРедактора);
	РедакторView.clearMetadata();
	
	ПараметрыРедактора.Вставить("ФлагНетМетаданных");
	
КонецПроцедуры

Процедура ИнициализироватьКонтекст(Форма, Редактор) Экспорт
	
	ПараметрыРедактора = рк_РедакторКодаКлиентСервер.ПараметрыРедактора(Форма, Редактор);
	
	РедакторView = View(Форма, ПараметрыРедактора);
	
	Если ПараметрыРедактора.Свойство("АдресКонтекст") Тогда
		РезультатыЗапроса = ПолучитьИзВременногоХранилища(ПараметрыРедактора.АдресКонтекст);
		ОбработатьРезультатыЗапросаМетаданных(РедакторView, РезультатыЗапроса);
	КонецЕсли;
	
КонецПроцедуры

Функция ИнициализироватьГлобальныйКонтекст(Форма, Конфигурация)
	
	ОбщиеПараметры = рк_РедакторКодаКлиентСервер.ОбщиеПараметры(Форма);
	
	АдресГлобальныйКонтекст = ОбщиеПараметры.ГлобальныйКонтекст[Конфигурация];
	Если АдресГлобальныйКонтекст <> Неопределено Тогда
		Возврат АдресГлобальныйКонтекст; // Глобальный контекс уже получен
	КонецЕсли;
	
	ИнициализацияКонфигураций = рк_РедакторКодаКлиентСервер.СвойствоСтруктуры(ОбщиеПараметры, "ИнициализацияКонфигураций", Новый Соответствие);
	Если ИнициализацияКонфигураций[Конфигурация] <> Неопределено Тогда
		Возврат Неопределено; // Получение контекста уже запущено в фоне
	КонецЕсли;
	
	Результат = рк_РедакторКодаВызовСервера.ИнициализироватьГлобальныйКонтекст(ОбщиеПараметры.НастройкиКонфигурации[Конфигурация], Форма.УникальныйИдентификатор);
	
	Если Результат.Статус = "Выполнено" Тогда
		ОбщиеПараметры.ГлобальныйКонтекст[Конфигурация] = Результат.АдресРезультата;
		Возврат Результат.АдресРезультата;
	КонецЕсли;
	
	Если Результат.Статус = "Ошибка" Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Если Результат.Статус = "Выполняется" Тогда
		
		Попытка
			МодульДлительныеОперацииКлиент = Вычислить("ДлительныеОперацииКлиент");
		Исключение
			Возврат Неопределено;
		КонецПопытки;
	
		ИнициализацияКонфигураций[Конфигурация] = Результат.ИдентификаторЗадания;
		
		ДополнительныеПараметры = Новый Структура;
		ДополнительныеПараметры.Вставить("Форма", Форма);
		ДополнительныеПараметры.Вставить("Конфигурация", Конфигурация);
		
		ОповещениеОЗавершении = Новый ОписаниеОповещения("ИнициализироватьГлобальныйКонтекстЗавершение", ЭтотОбъект, ДополнительныеПараметры);
		
		ПараметрыОжидания = МодульДлительныеОперацииКлиент.ПараметрыОжидания(Форма);
		ПараметрыОжидания.ВыводитьОкноОжидания = Ложь;
		
		МодульДлительныеОперацииКлиент.ОжидатьЗавершение(Результат, ОповещениеОЗавершении, ПараметрыОжидания);
	КонецЕсли;
	
	Возврат Неопределено;
	
КонецФункции
 
Процедура ИнициализироватьГлобальныйКонтекстЗавершение(Результат, ОписаниеЗадания) Экспорт
	
	Если Результат = Неопределено ИЛИ Результат.Статус = "Отменено" Тогда
		Возврат;
	КонецЕсли;
	
	Если Результат.Статус = "Ошибка" Тогда
		Возврат;
	КонецЕсли;
	
	ОбщиеПараметры = рк_РедакторКодаКлиентСервер.ОбщиеПараметры(ОписаниеЗадания.Форма);
	
	// Сохранение адреса глобального контекста на случай инициализации еще не готовых редакторов
	ОбщиеПараметры.ГлобальныйКонтекст[ОписаниеЗадания.Конфигурация] = Результат.АдресРезультата;
	
	// Обновление метаданных редакторов с конфигурацией ОписаниеЗадания.Конфигурация
	
	РезультатыЗапроса = ПолучитьИзВременногоХранилища(Результат.АдресРезультата);
	
	Для Каждого ЭлементСписка Из рк_РедакторКодаКлиентСервер.ПараметрыВсехРедакторов(ОписаниеЗадания.Форма) Цикл
		ПараметрыРедактора = ЭлементСписка.Значение;
		
		Если ПараметрыРедактора.Конфигурация = ОписаниеЗадания.Конфигурация И НЕ ПараметрыРедактора.Свойство("ФлагНеИнициализирован") Тогда
			РедакторView = View(ОписаниеЗадания.Форма, ПараметрыРедактора);
			ОбработатьРезультатыЗапросаМетаданных(РедакторView, РезультатыЗапроса);
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

Функция НайтиРедакторНаСтранице(Форма, ИмяСтраницыИлиСтраница)
	
	ПараметрыВсехРедакторов = рк_РедакторКодаКлиентСервер.ПараметрыВсехРедакторов(Форма);
	
	ИмяЭлементаСтраница = рк_РедакторКодаКлиентСервер.НормализоватьИмяЭлемента(ИмяСтраницыИлиСтраница);
	
	Для Каждого ЭлементСписка Из ПараметрыВсехРедакторов Цикл
		ПараметрыРедактора = ЭлементСписка.Значение;
		Если ПараметрыРедактора.Свойство("ФлагНетВебСтраницы") И ПараметрыРедактора.Свойство("ИмяЭлементаСтраница")
		   И ПараметрыРедактора.ИмяЭлементаСтраница = ИмяЭлементаСтраница Тогда
			Возврат ПараметрыРедактора;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Неопределено;
	
КонецФункции

Процедура УстановитьВебСтраницуРедактора(Форма, Редактор)
	
	ПараметрыРедактора = рк_РедакторКодаКлиентСервер.ПараметрыРедактора(Форма, Редактор);
	
	Если НЕ ПараметрыРедактора.Свойство("ФлагНетВебСтраницы") Тогда
		Возврат; // Веб-страница установлена
	КонецЕсли;
	
	ОбщиеПараметры = рк_РедакторКодаКлиентСервер.ОбщиеПараметры(Форма);
	
	Если НЕ ОбщиеПараметры.Свойство("АдресФайлыРедактора") Тогда
		ОбщиеПараметры.Вставить("АдресФайлыРедактора", рк_РедакторКодаВызовСервера.ПодготовитьФайлыРедактора(Форма.УникальныйИдентификатор));
	КонецЕсли;
	
	ФайлыРедактора = ПолучитьИзВременногоХранилища(ОбщиеПараметры.АдресФайлыРедактора);
	
	Форма[ПараметрыРедактора.РеквизитHTML] = ФайлыРедактора["index.html"];
	ПараметрыРедактора.Удалить("РеквизитHTML"); // Больше он не понадобится
	
	ПараметрыРедактора.Удалить("ФлагНетВебСтраницы");
	
	Если ПараметрыРедактора.Свойство("ИмяЭлементаСтраница") Тогда
		ПараметрыРедактора.Удалить("ИмяЭлементаСтраница");
	КонецЕсли;
	
	
КонецПроцедуры

Процедура ОбновитьТекстРедактораПоРеквизитуТекст(Форма, Редактор = Неопределено) Экспорт
	
	ПараметрыРедактора = рк_РедакторКодаКлиентСервер.ПараметрыРедактора(Форма, Редактор);
	Если ПараметрыРедактора = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если НЕ ПараметрыРедактора.Свойство("ФлагНеИнициализирован") И ПараметрыРедактора.Свойство("РеквизитТекст") Тогда
		View(Форма, ПараметрыРедактора.ИмяЭлементаHTML).updateText(Вычислить(СтрШаблон("Форма.%1", ПараметрыРедактора.РеквизитТекст)));
	КонецЕсли;
	
КонецПроцедуры

Функция ОбновитьРеквизитТекстПоТекстуРедактора(Форма, Редактор = Неопределено) Экспорт
	
	ПараметрыРедактора = рк_РедакторКодаКлиентСервер.ПараметрыРедактора(Форма, Редактор);
	Если ПараметрыРедактора = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	
	ЕстьИзменения = Ложь;
	
	Если НЕ ПараметрыРедактора.Свойство("ФлагНеИнициализирован") И ПараметрыРедактора.Свойство("РеквизитТекст") Тогда
		
		РедакторView = View(Форма, ПараметрыРедактора.ИмяЭлементаHTML);
		Если РедакторView.isContentModified() Тогда
			НовыйТекст = РедакторView.getText();
			УстановитьЗначениеРеквизитаТекст(Форма, НовыйТекст, ПараметрыРедактора);
			РедакторView.resetContentModified();
			ЕстьИзменения = Истина;
		КонецЕсли;
	КонецЕсли;
	
	Возврат ЕстьИзменения;
	
КонецФункции

Функция ПолучитьЗначениеРеквизитаТекст(Форма, Редактор = Неопределено) Экспорт
	
	ПараметрыРедактора = рк_РедакторКодаКлиентСервер.ПараметрыРедактора(Форма, Редактор);
	
	Если НЕ ПараметрыРедактора.Свойство("РеквизитТекст") Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Возврат Вычислить(СтрШаблон("Форма.%1", ПараметрыРедактора.РеквизитТекст));
	
КонецФункции

Процедура УстановитьЗначениеРеквизитаТекст(Форма, НовыйТекст, Редактор = Неопределено) Экспорт
	
	ПараметрыРедактора = рк_РедакторКодаКлиентСервер.ПараметрыРедактора(Форма, Редактор);
	
	Если НЕ ПараметрыРедактора.Свойство("РеквизитТекст") Тогда
		Возврат;
	КонецЕсли;
	
	ПозТочки = СтрНайти(ПараметрыРедактора.РеквизитТекст, ".", НаправлениеПоиска.СКонца);
	Если ПозТочки = 0 Тогда
		Форма[ПараметрыРедактора.РеквизитТекст] = НовыйТекст;
	Иначе
		// Для реквизитов "Объект.ИмяРеквизита"
		ОбъектРеквизита = Вычислить(СтрШаблон("Форма.%1", Лев(ПараметрыРедактора.РеквизитТекст, ПозТочки - 1)));
		ИмяРеквизита = Сред(ПараметрыРедактора.РеквизитТекст, ПозТочки + 1);
		ОбъектРеквизита[ИмяРеквизита] = НовыйТекст;
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область НастройкиРедактора

Процедура ОбновитьИспользоватьРедактор(Форма, ГлобальныеНастройки, НовоеЗначение)
	
	ОбщиеПараметры = рк_РедакторКодаКлиентСервер.ОбщиеПараметры(Форма);
	
	Если ГлобальныеНастройки И НЕ ОбщиеПараметры.ГлобальныеНастройки Тогда
		Возврат; // Изменены глобальные настройки, а для формы уже используются свои настройки
	КонецЕсли;
	ОбщиеПараметры.ГлобальныеНастройки = ГлобальныеНастройки;
	
	Если ОбщиеПараметры.ИспользоватьРедактор = НовоеЗначение Тогда
		Возврат;
	КонецЕсли;
	
	Если НовоеЗначение Тогда
		ПереключитьРедакторыНаHTML(Форма);
	Иначе
		ПереключитьРедакторыНаТекст(Форма);
	КонецЕсли;
	
КонецПроцедуры

Процедура ОбновитьПодсказкаПоМетаданным(Форма, ГлобальныеНастройки, НовоеЗначение)
	
	ОбщиеПараметры = рк_РедакторКодаКлиентСервер.ОбщиеПараметры(Форма);
	
	Если ГлобальныеНастройки И НЕ ОбщиеПараметры.ГлобальныеНастройки Тогда
		Возврат; // Изменены глобальные настройки, а для формы уже используются свои настройки
	КонецЕсли;
	ОбщиеПараметры.ГлобальныеНастройки = ГлобальныеНастройки;
	
	Если ОбщиеПараметры.ПодсказкаПоМетаданным = НовоеЗначение Тогда
		Возврат;
	КонецЕсли;
	
	ОбщиеПараметры.ПодсказкаПоМетаданным = НовоеЗначение;
	
	Если НовоеЗначение Тогда
		
		// При включении подсказки по метаданным загружаются метаданные во все редакторы без метаданных
		ВсеРедакторы = рк_РедакторКодаКлиентСервер.ПараметрыВсехРедакторов(Форма);
		Для Каждого ЭлементСписка Из ВсеРедакторы Цикл
			ПараметрыРедактора = ЭлементСписка.Значение;
			Если НЕ ПараметрыРедактора.Свойство("ФлагНеИнициализирован") Тогда
				ИнициализироватьМетаданныеРедактора(Форма, ПараметрыРедактора);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
КонецПроцедуры

Процедура ОбновитьНастройки(Форма, ГлобальныеНастройки)
	
	ОбщиеПараметры = рк_РедакторКодаКлиентСервер.ОбщиеПараметры(Форма);
	
	АдресНастроек = ОбщиеПараметры.АдресНастройки;
	Если АдресНастроек = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если ГлобальныеНастройки И НЕ ОбщиеПараметры.ГлобальныеНастройки Тогда
		Возврат; // Изменены глобальные настройки, а для формы уже используются свои настройки
	КонецЕсли;
	ОбщиеПараметры.ГлобальныеНастройки = ГлобальныеНастройки;
	
	Если ГлобальныеНастройки Тогда
		// Заполнение текущих настроек для формы по глобальным
		рк_РедакторКодаВызовСервера.ОбновитьНастройки(АдресНастроек);
	КонецЕсли;
	
	ВсеРедакторы = рк_РедакторКодаКлиентСервер.ПараметрыВсехРедакторов(Форма);
	Если ОбщиеПараметры.ИспользоватьРедактор Тогда
		// Применение новых настроек
		НовыеНастройки = ПолучитьИзВременногоХранилища(АдресНастроек);
		Для Каждого ЭлементСписка Из ВсеРедакторы Цикл
			ПараметрыРедактора = ЭлементСписка.Значение;
			Если НЕ ПараметрыРедактора.Свойство("ФлагНеИнициализирован") Тогда
				ПрименитьНастройки(Форма, НовыеНастройки, ПараметрыРедактора);
			КонецЕсли;
		КонецЦикла;
	Иначе
		// Сейчас настройки обновить не возможно. Обновление произойдет при включении использования редактора
		Для Каждого ЭлементСписка Из ВсеРедакторы Цикл
			ПараметрыРедактора = ЭлементСписка.Значение;
			Если НЕ ПараметрыРедактора.Свойство("ФлагНеИнициализирован") Тогда
				ПараметрыРедактора.Вставить("ФлагНетНастроек");
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
КонецПроцедуры

Процедура ОбновитьНастройкиКонфигурации(Форма, ГлобальныеНастройки, Конфигурация)
	
	ОбщиеПараметры = рк_РедакторКодаКлиентСервер.ОбщиеПараметры(Форма);
	
	АдресНастроек = ОбщиеПараметры.НастройкиКонфигурации[Конфигурация];
	Если АдресНастроек = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если ГлобальныеНастройки И НЕ ОбщиеПараметры.ГлобальныеНастройки Тогда
		Возврат; // Изменены глобальные настройки, а для формы уже используются свои настройки
	КонецЕсли;
	ОбщиеПараметры.ГлобальныеНастройки = ГлобальныеНастройки;
	
	Если ГлобальныеНастройки Тогда
		// Обновление настроек для формы по глобальным
		рк_РедакторКодаВызовСервера.ОбновитьНастройкиКонфигурации(АдресНастроек);
	КонецЕсли;
	
	// Удаление старых данных глобального контекста и общих реквизитов
	АдресГлобальныйКонтекст = ОбщиеПараметры.ГлобальныйКонтекст[Конфигурация];
	Если АдресГлобальныйКонтекст <> Неопределено Тогда
		УдалитьИзВременногоХранилища(АдресГлобальныйКонтекст);
		ОбщиеПараметры.ГлобальныйКонтекст.Удалить(Конфигурация);
	КонецЕсли;
	АдресОбщиеРеквизиты = ОбщиеПараметры.ОбщиеРеквизиты[Конфигурация];
	Если АдресОбщиеРеквизиты <> Неопределено Тогда
		УдалитьИзВременногоХранилища(АдресОбщиеРеквизиты);
		ОбщиеПараметры.ОбщиеРеквизиты.Удалить(Конфигурация);
	КонецЕсли;
	
	ВсеРедакторы = рк_РедакторКодаКлиентСервер.ПараметрыВсехРедакторов(Форма);
	
	// Сброс метаданных конфигурации у редакторов для пакетного обновления глобального контекста в фоне
	Для Каждого ЭлементСписка Из ВсеРедакторы Цикл
		ПараметрыРедактора = ЭлементСписка.Значение;
		Если ПараметрыРедактора.Конфигурация = Конфигурация И НЕ ПараметрыРедактора.Свойство("ФлагНетМетаданных") Тогда
			СброситьМетаданныеРедактора(Форма, ПараметрыРедактора);
		КонецЕсли;
	КонецЦикла;
	
	Если НЕ ОбщиеПараметры.ИспользоватьРедактор ИЛИ НЕ ОбщиеПараметры.ПодсказкаПоМетаданным Тогда
		Возврат; // Глобальный контекст будет загружен при включении использования редактора
	КонецЕсли;
	
	Если ИнициализироватьГлобальныйКонтекст(Форма, Конфигурация) = Неопределено Тогда
		Возврат; // Запущено формирование в фоне или произошла ошибка
	КонецЕсли;
	
	Для Каждого ЭлементСписка Из ВсеРедакторы Цикл
		ПараметрыРедактора = ЭлементСписка.Значение;
		Если ПараметрыРедактора.Конфигурация = Конфигурация И НЕ ПараметрыРедактора.Свойство("ФлагНеИнициализирован") Тогда
			ИнициализироватьМетаданныеРедактора(Форма, ПараметрыРедактора);
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти

#Область ВспомогательныеФункции

// Получает объект defaultView документа HTML-редактора.
// 
// Параметры:
//   Форма - ФормаКлиентскогоПриложения - форма с полем HTML
//   ЭлементИлиИмя - Строка, ЭлементФормы - элемент формы или его имя
//
// Возвращаемое значение:
//   Произвольный - объект defaultView документа
//
Функция View(Форма, Редактор) Экспорт
	
	ПараметрыРедактора = рк_РедакторКодаКлиентСервер.ПараметрыРедактора(Форма, Редактор);
	
	Попытка
		Возврат Форма.Элементы[ПараметрыРедактора.ИмяЭлементаHTML].Документ.defaultView;
	Исключение
		Возврат Неопределено;
	КонецПопытки;
	
КонецФункции

#КонецОбласти

#Область ОбработкаСобытийРедактора

// Параметры:
//  Форма
//  ИмяИлиЭлементHTML
//  ДанныеСобытия
//  ОбработчикСобытий - ОписаниеОповещения, Неопределено - дополнительный обработчик событий на форме

Процедура ОбработатьСобытиеРедактора(Форма, Редактор, ДанныеСобытия, ОбработчикиСобытий)
	
	ПараметрыРедактора = рк_РедакторКодаКлиентСервер.ПараметрыРедактора(Форма, Редактор);
	
	РедакторView = View(Форма, ПараметрыРедактора);
	
	Если РедакторView = Неопределено ИЛИ РедакторView.events_queue = Неопределено ИЛИ РедакторView.events_queue.length = 0 Тогда
		Возврат; // Редактор еще не инициализирован или нет событий
	КонецЕсли;
	
	#Если ВебКлиент Тогда
		// Получить реквизиты событий из РедакторView.events_queue или из ДанныеСобытия невозможно.
		// Поэтому получение списка событий в виде строки JSON и преобразование ее в массив на стороне 1С
		ТестJSON = РедакторView.getEvents();
		Попытка
			ОчередьСобытий = ВебКлиентПрочитатьJSON(ТестJSON, 1);
		Исключение
			ПоказатьПредупреждение(, "ВебКлиент. Ошибка разбора JSON. События " + ТестJSON);
		КонецПопытки;
	#Иначе
		ОчередьСобытий = Новый Массив;
		Пока РедакторView.events_queue.length <> 0 Цикл
			Событие = РедакторView.events_queue.shift();
			ОчередьСобытий.Добавить(Событие);
		КонецЦикла;
	#КонецЕсли
	
	Для Каждого Событие Из ОчередьСобытий Цикл
		
		ИмяСобытия = Событие.event;
		
		Если ИмяСобытия = "EVENT_GET_METADATA" Тогда
			Триггер = Событие.params.trigger;
			ПараметрыЗапроса = НРег(Событие.params.metadata);
			
			РезультатыЗапроса = ОбработатьСобытиеПолученияМетаданных(Форма, ПараметрыРедактора, ПараметрыЗапроса);
			ДанныеОбновлены = ОбработатьРезультатыЗапросаМетаданных(РедакторView, РезультатыЗапроса);
			
			// Вызываем автодополнение, если это был триггер suggestion
			Если ДанныеОбновлены И Триггер = "suggestion" Тогда
				РедакторView.triggerSuggestions();
			КонецЕсли;
			
			// Обновляем сниппет, если это был триггер snippet
			Если Триггер = "snippet" Тогда
				РедакторView.updateSnippetByGUID(Событие.params.snippet_guid);
			КонецЕсли;
			
		ИначеЕсли ИмяСобытия = "EVENT_QUERY_CONSTRUCT" Тогда
			ОбработатьСобытиеКонструктораЗапроса(РедакторView, Событие.params);
			
		ИначеЕсли ИмяСобытия = "EVENT_FORMAT_CONSTRUCT" Тогда
			ОбработатьСобытиеКонструктораФорматнойСтроки(РедакторView, Событие.params);
			
		ИначеЕсли ИмяСобытия = "EVENT_CONTENT_MODIFIED" Тогда
			// В отличии от типовой bsl_console это событие генерируется при изменении текста один раз.
			//Для сброса признака модифицированности внутри редактора вызвать рк_РедакторКодаКлиент.СброситьМодифицированность();
			Форма.Модифицированность = Истина;
			
		ИначеЕсли ИмяСобытия = "EVENT_ON_LINK_CLICK" Тогда
			Если СтрНайти(Событие.params.href, "e1cib") > 0 Тогда
				ПерейтиПоНавигационнойСсылке(Событие.params.href);
			КонецЕсли;
			
		КонецЕсли;
		
		Если ОбработчикиСобытий <> Неопределено Тогда
			ОбработчикСобытия = ОбработчикиСобытий[ИмяСобытия];
			Если ОбработчикСобытия <> Неопределено Тогда
				ВыполнитьОбработкуОповещения(ОбработчикСобытия, Событие);
			КонецЕсли;
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

#Если ВебКлиент Тогда

Функция ВебКлиентПрочитатьJSON(ТекстJSON, Поз)
	
	Символ = Сред(ТекстJSON, Поз, 1);
	Если Символ = """" Тогда
		Значение = ВебКлиентСтрокаJSON(ТекстJSON, Поз);
	ИначеЕсли Символ = "{" Тогда
		Значение = ВебКлиентСтруктураJSON(ТекстJSON, Поз);
	ИначеЕсли Символ = "[" Тогда
		Значение = ВебКлиентМассивJSON(ТекстJSON, Поз);
	ИначеЕсли КодСимвола(Символ) >= 48 И КодСимвола(Символ) <= 57 Тогда // 0 - 48, 9 - 57
		Значение = ВебКлиентЧислоJSON(ТекстJSON, Поз);
	ИначеЕсли Сред(ТекстJSON, Поз, 5) = "false" Тогда
		Поз = Поз + 5;
		Значение = Ложь;
	ИначеЕсли Сред(ТекстJSON, Поз, 4) = "true" Тогда
		Поз = Поз + 4;
		Значение = Истина;
	КонецЕсли;
	
	Возврат Значение;
	
КонецФункции

Функция ВебКлиентМассивJSON(ТекстJSON, Поз)
	
	Результат = Новый Массив;
	
	Поз = Поз + 1; // "["
	Пока Поз < СтрДлина(ТекстJSON) Цикл
		Результат.Добавить(ВебКлиентПрочитатьJSON(ТекстJSON, Поз));
		Символ = Сред(ТекстJSON, Поз, 1); // "," или "]"
		Поз = Поз + 1;
		Если Символ = "]" Тогда
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

Функция ВебКлиентСтруктураJSON(ТекстJSON, Поз)
	
	Результат = Новый Структура;
	
	Поз = Поз + 1; // "{"
	Пока Поз < СтрДлина(ТекстJSON) Цикл
		Ключ = ВебКлиентСтрокаJSON(ТекстJSON, Поз);
		Поз = Поз + 1; // ":"
		Значение = ВебКлиентПрочитатьJSON(ТекстJSON, Поз);
		Результат.Вставить(Ключ, Значение);
		
		Символ = Сред(ТекстJSON, Поз, 1); // "," или "}"
		Поз = Поз + 1;
		Если Символ = "}" Тогда
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

Функция ВебКлиентСтрокаJSON(ТекстJSON, Поз)
	
	Поз = Поз + 1; // "
	НачПоз = Поз;
	Поз = СтрНайти(ТекстJSON, """", , Поз) + 1;
	Возврат Сред(ТекстJSON, НачПоз, Поз - НачПоз - 1);
	
КонецФункции

Функция ВебКлиентЧислоJSON(ТекстJSON, Поз)
	
	НачПоз = Поз;
	Поз = Поз + 1;
	Пока Поз < СтрДлина(ТекстJSON) Цикл
		КодСимвола = КодСимвола(Сред(ТекстJSON, Поз, 1));
		Если КодСимвола < 48 ИЛИ КодСимвола > 57 Тогда // 0 - 48, 9 - 57
			Прервать;
		КонецЕсли;
		Поз = Поз + 1;
	КонецЦикла;
	
	Возврат Число(Сред(ТекстJSON, НачПоз, Поз - НачПоз));
	
КонецФункции

#КонецЕсли

Функция ОбработатьСобытиеПолученияМетаданных(Форма, ПараметрыРедактора, СтрокаИлиМассивПараметровЗапроса)
	
	РезультатыЗапроса = Новый Соответствие;
	
	ОбщиеПараметры = рк_РедакторКодаКлиентСервер.ОбщиеПараметры(Форма);
	Если НЕ ОбщиеПараметры.ПодсказкаПоМетаданным Тогда
		Возврат РезультатыЗапроса;
	КонецЕсли;
	
	Если ТипЗнч(СтрокаИлиМассивПараметровЗапроса) = Тип("Строка") Тогда
		ПараметрыЗапроса = СтрРазделить(СтрокаИлиМассивПараметровЗапроса, ",");
	Иначе
		ПараметрыЗапроса = СтрокаИлиМассивПараметровЗапроса;
	КонецЕсли;
	
	АдресНастройкиКонфигурации = ОбщиеПараметры.НастройкиКонфигурации[ПараметрыРедактора.Конфигурация];
	АдресОбщиеРеквизиты = ОбщиеПараметры.ОбщиеРеквизиты[ПараметрыРедактора.Конфигурация];
	АдресРезультатыЗапроса = рк_РедакторКодаВызовСервера.ОбработатьЗапросМетаданных(СтрСоединить(ПараметрыЗапроса, ","), АдресНастройкиКонфигурации, АдресОбщиеРеквизиты);
	Для Каждого КлючИЗначение Из ПолучитьИзВременногоХранилища(АдресРезультатыЗапроса) Цикл
		РезультатыЗапроса.Вставить(КлючИЗначение.Ключ, КлючИЗначение.Значение);
	КонецЦикла;
	
	Возврат РезультатыЗапроса;
	
КонецФункции

Функция ПрочитатьМетаданныеИзКеша(РезультатыЗапроса, ПараметрыЗапроса, Конфигурация)
	
	КешКонфигурации = КешКонфигурации(Конфигурация);
	
	Для Индекс = -ПараметрыЗапроса.ВГраница() По 0 Цикл
		ПараметрЗапроса = ПараметрыЗапроса[-Индекс];
		РезультатЗапроса = КешКонфигурации[ПараметрЗапроса];
		Если РезультатЗапроса <> Неопределено Тогда
			РезультатыЗапроса.Вставить(ПараметрЗапроса, РезультатЗапроса);
			ПараметрыЗапроса.Удалить(-Индекс);
		КонецЕсли;
	КонецЦикла;
	
КонецФункции

Функция ЗаписатьМетаданныеВКеш(РезультатыЗапроса, Конфигурация)
	
	КешКонфигурации = КешКонфигурации(Конфигурация);
	
	Для Каждого КлючИЗначение Из РезультатыЗапроса Цикл
		КешКонфигурации[КлючИЗначение.Ключ] = КлючИЗначение.Значение;
	КонецЦикла;
	
КонецФункции

Функция КешКонфигурации(Конфигурация)
	
	КешМетаданных = ПараметрыПриложения["рк_Метаданные"];
	Если КешМетаданных = Неопределено Тогда
		КешМетаданных = Новый Соответствие;
		ПараметрыПриложения["рк_Метаданные"] = КешМетаданных;
	КонецЕсли;
	КешКонфигурации = КешМетаданных[Конфигурация];
	Если КешКонфигурации = Неопределено Тогда
		КешКонфигурации = Новый Соответствие;
		КешМетаданных[Конфигурация] = КешКонфигурации;
	КонецЕсли;
	Возврат КешКонфигурации;
	
КонецФункции

Функция ОбработатьРезультатыЗапросаМетаданных(РедакторView, РезультатыЗапроса)
	
	ДанныеОбновлены = Ложь;
	
	Для Каждого КлючИЗначение Из РезультатыЗапроса Цикл
		
		РезультатЗапроса = КлючИЗначение.Значение;
		Если РезультатЗапроса = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		Если РезультатЗапроса.Тип = "Метаданные" Тогда
			Попытка
				Успешно = РедакторView.updateMetadata(РезультатЗапроса.Данные, РезультатЗапроса.Адрес);
				Если ТипЗнч(Успешно) = Тип("Булево") Тогда
					ДанныеОбновлены = ДанныеОбновлены ИЛИ Успешно;
				КонецЕсли;
			Исключение
				Инфо = ИнформацияОбОшибке();
			КонецпоПытки;
			
		ИначеЕсли СтрНачинаетсяС(РезультатЗапроса.Тип, "Модуль") Тогда
			
			Для Каждого ЭлементСписка Из РезультатЗапроса.Данные Цикл
				ТекстМодуля = ЭлементСписка.Значение;
				ЭтоРасширение = ЭлементСписка.Пометка;
				Попытка
					КоличествоМетодов = РедакторView.updateModuleWithExtension(РезультатЗапроса.Адрес, ТекстМодуля, ЭтоРасширение, РезультатЗапроса.Обработан);
					Если ТипЗнч(КоличествоМетодов) = Тип("Число") Тогда
						ДанныеОбновлены = Истина;
					КонецЕсли;
				Исключение
					Инфо = ИнформацияОбОшибке();
				КонецПопытки;
			КонецЦикла;
			
		ИначеЕсли РезультатЗапроса.Тип = "Контекст" Тогда
			Попытка
				Успешно = РедакторView.updateCustomContext(РезультатЗапроса.Данные);
				Если ТипЗнч(Успешно) = Тип("Булево") Тогда
					ДанныеОбновлены = ДанныеОбновлены ИЛИ Успешно;
				КонецЕсли;
			Исключение
				Инфо = ИнформацияОбОшибке();
			КонецПопытки;
			
		КонецЕсли;
	КонецЦикла;
	
	Возврат ДанныеОбновлены;
	
КонецФункции

Асинх Процедура ОбработатьСобытиеКонструктораЗапроса(РедакторView, ПараметрыЗапроса)
	
	Позиция = Неопределено;
	
	Если НЕ ЗначениеЗаполнено(ПараметрыЗапроса) Тогда
		
		ТекстВопроса = "Не найден текст запроса." + Символы.ПС + "Создать новый запрос?";
		Если Ждать ВопросАсинх(ТекстВопроса, РежимДиалогаВопрос.ДаНет) <> КодВозвратаДиалога.Да Тогда
			Возврат;
		КонецЕсли;
		
		ТекстЗапроса = "";
	Иначе
		Позиция = ПараметрыЗапроса.range;
		
		ТекстЗапроса = СтрЗаменить(ПараметрыЗапроса.text, "|", "");
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, """""", "$");
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, """", "");
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "$", """");
	КонецЕсли;
	
	Конструктор = Новый КонструкторЗапроса;
	
	Если НЕ ПустаяСтрока(ТекстЗапроса) Тогда
		Попытка
			Конструктор.Текст = ТекстЗапроса;
		Исключение
			ПоказатьПредупреждение(, "Ошибка в тексте запроса:" + Символы.ПС + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
			Возврат;
		КонецПопытки;
	КонецЕсли;
	
	Текст = Ждать Конструктор.ОткрытьАсинх();
	Если Текст = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	// Проверяем режим запроса
	Попытка
		РежимЗапроса = РедакторView.queryMode;
	Исключение
		РежимЗапроса = Ложь;
	КонецПопытки;
	
	Если Не РежимЗапроса Тогда
		Текст = СтрЗаменить(Текст, Символы.ПС, Символы.ПС + "|");
		Текст = СтрЗаменить(Текст, """", """""");
		Текст = """" + Текст + """";
	КонецЕсли;
	
	// Используем setText с позицией (range) для вставки в нужное место
	РедакторView.setText(Текст, Позиция, Истина);
	
КонецПроцедуры

Асинх Процедура ОбработатьСобытиеКонструктораФорматнойСтроки(РедакторView, ПараметрыСтроки)
	
	Позиция = Неопределено;
	
	Если ПараметрыСтроки = Неопределено Тогда
		
		ТекстВопроса = "Форматная строка не найдена." + Символы.ПС + "Создать новую форматную строку?";
		Если Ждать ВопросАсинх(ТекстВопроса, РежимДиалогаВопрос.ДаНет) <> КодВозвратаДиалога.Да Тогда
			Возврат;
		КонецЕсли;
		
		ФорматнаяСтрока = "";
	Иначе
		Позиция = ПараметрыСтроки.range;
		ФорматнаяСтрока = СтрЗаменить(СтрЗаменить(ПараметрыСтроки.text, "|", ""), """", "");
	КонецЕсли;
	
	Конструктор = Новый КонструкторФорматнойСтроки;
	
	Если НЕ ПустаяСтрока(ФорматнаяСтрока) Тогда
		Попытка
			Конструктор.Текст = ФорматнаяСтрока;
		Исключение
			ПоказатьПредупреждение(, "Ошибка в тексте форматной строки:" + Символы.ПС + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
			Возврат;
		КонецПопытки;
	КонецЕсли;
	
	ФорматнаяСтрока = Ждать Конструктор.ОткрытьАсинх();
	
	Если ФорматнаяСтрока <> Неопределено Тогда
		ФорматнаяСтрока = СтрЗаменить(ФорматнаяСтрока, "'", "");
		ФорматнаяСтрока = """" + ФорматнаяСтрока + """";
		// Используем setText с позицией (range) для вставки в нужное место
		РедакторView.setText(ФорматнаяСтрока, Позиция, Ложь);
	КонецЕсли;
	
КонецПроцедуры

