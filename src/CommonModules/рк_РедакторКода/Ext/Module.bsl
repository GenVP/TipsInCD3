#Область Инициализация

Функция ПодготовитьФайлыРедактора(УникальныйИдентификаторФормы) Экспорт
	
	СлужебныеНастройки = СлужебныеНастройки();
	Если СлужебныеНастройки.МакетРедактора = "рк_РедакторКода" Тогда
		Возврат ПодготовитьФайлыРедактораОбычный(УникальныйИдентификаторФормы);
	ИначеЕсли СлужебныеНастройки.МакетРедактора = "рк_РедакторКодаУпакованный" Тогда
		Возврат ПодготовитьФайлыРедактораУпакованный(УникальныйИдентификаторФормы);
	КонецЕсли;
	
	Возврат Неопределено; // Не известный макет файлов редактора
	
КонецФункции

// Получение и подготовка веб-страниц на основе уже измененных веб-страниц и общих скриптов
// Описание процесса изменения веб-страниц и объединения скриптов см. ПодготовитьФайлыРедактораОбычный()
//
Функция ПодготовитьФайлыРедактораУпакованный(УникальныйИдентификаторФормы)
	
	// Извлечение файлов исходников редактора из макета
	
	Если рк_РедакторКодаКлиентСервер.СравнитьВерсиюПлатформы("8.3.26") Тогда
		МенеджерАрхива = Новый ("ЧтениеФайлаАрхива");
	Иначе
		МенеджерАрхива = Новый ("ЧтениеZipФайла");
	КонецЕсли;
	
	КаталогВременныхФайлов = ПолучитьИмяВременногоФайла();
	СоздатьКаталог(КаталогВременныхФайлов);
	
	ДвоичныеДанныеАрхива = ПолучитьОбщийМакет("рк_РедакторКодаУпакованный");
	
	МенеджерАрхива.Открыть(ДвоичныеДанныеАрхива.ОткрытьПотокДляЧтения());
	МенеджерАрхива.ИзвлечьВсе(КаталогВременныхФайлов);
	МенеджерАрхива.Закрыть();
	МенеджерАрхива = Неопределено;
	
	ДвоичныеДанныеАрхива = Неопределено;
	
	// Подготовка таблицы файлов и веб-страниц исходников редактора
	
	ФайлыПрочие = Новый Соответствие;
	ВебСтраницы = Новый Соответствие;
	
	НайденныеФайлы = НайтиФайлы(КаталогВременныхФайлов, "*.*", Истина);
	
	ДлинаКорневогоПути = СтрДлина(КаталогВременныхФайлов);
	Для Каждого НайденныйФайл Из НайденныеФайлы Цикл
		
		Если НайденныйФайл.ЭтоКаталог() Тогда
			Продолжить;
		КонецЕсли;
		
		ИмяФайла = СтрЗаменить(Сред(НайденныйФайл.ПолноеИмя, ДлинаКорневогоПути + 2), "\", "/");
		
		Если НайденныйФайл.Расширение = ".html" Тогда
			
			ЧтениеТекста = Новый ЧтениеТекста(НайденныйФайл.ПолноеИмя);
			ДанныеФайла = ЧтениеТекста.Прочитать();
			ЧтениеТекста.Закрыть();
			
			ВебСтраницы[ИмяФайла] = ДанныеФайла;
		Иначе
			ФайлыПрочие[ИмяФайла] = Новый ДвоичныеДанные(НайденныйФайл.ПолноеИмя);
		КонецЕсли;
		
	КонецЦикла;
	
	УдалитьФайлы(КаталогВременныхФайлов);
	
	// Подготовка веб-страниц
	
	Для Каждого ОписаниеВебСтраницы Из ВебСтраницы Цикл
		
		ТекстHTML = ОписаниеВебСтраницы.Значение;
		
		Для Каждого ОписаниеФайла Из ФайлыПрочие Цикл
			
			ДанныеФайла = ОписаниеФайла.Значение;
			ИмяФайла = ОписаниеФайла.Ключ;
			
			ТекстЭлемента = СтрШаблон("src=""%1""", ИмяФайла);
			ПозСтроки = СтрНайти(ТекстHTML, ТекстЭлемента);
			Если ПозСтроки > 0 Тогда
				// Замены ссылки с файлом на ссылку с адресом временного хранилища. При открытии страницы будет вызов сервера
				АдресФайла = ПоместитьВоВременноеХранилище(ДанныеФайла, УникальныйИдентификаторФормы);
				НовыйТекстЭлемента = СтрШаблон("src=""%1""", АдресФайла);
				ТекстHTML = СтрЗаменить(ТекстHTML, ТекстЭлемента, НовыйТекстЭлемента);
			КонецЕсли;
		КонецЦикла;
		
		ВебСтраницы[ОписаниеВебСтраницы.Ключ] = ТекстHTML;
		
	КонецЦикла;
	
	Возврат ВебСтраницы;
	
КонецФункции

// Подготовка веб-страниц и объединение скриптов для отображения веб-страницы в виде одного файла
//
Функция ПодготовитьФайлыРедактораОбычный(УникальныйИдентификаторФормы)
	
	СлужебныеНастройки = СлужебныеНастройки();
	
	// Извлечение файлов исходников редактора из макета
	
	Если рк_РедакторКодаКлиентСервер.СравнитьВерсиюПлатформы("8.3.26") Тогда
		МенеджерАрхива = Новый ("ЧтениеФайлаАрхива");
	Иначе
		МенеджерАрхива = Новый ("ЧтениеZipФайла");
	КонецЕсли;
	
	КаталогВременныхФайлов = ПолучитьИмяВременногоФайла();
	СоздатьКаталог(КаталогВременныхФайлов);
	
	ДвоичныеДанныеАрхива = ПолучитьОбщийМакет("рк_РедакторКода");
	
	МенеджерАрхива.Открыть(ДвоичныеДанныеАрхива.ОткрытьПотокДляЧтения());
	МенеджерАрхива.ИзвлечьВсе(КаталогВременныхФайлов);
	МенеджерАрхива.Закрыть();
	МенеджерАрхива = Неопределено;
	
	ДвоичныеДанныеАрхива = Неопределено;
	
	// Подготовка таблицы файлов и веб-страниц исходников редактора
	
	ФайлыСтилей = Новый Соответствие;
	ФайлыПрочие = Новый Соответствие;
	ВебСтраницы = Новый Соответствие;
	
	НайденныеФайлы = НайтиФайлы(КаталогВременныхФайлов, "*.*", Истина);
	
	// Имена файлов js, которые будут объединены в единый скрипт в указанной последовательности
	
	ИсключитьФайлы = Новый Массив;
	ОбщиеСкрипты = Новый Массив;
	
	ОбщиеСкрипты.Добавить("tingle.js");
	
	ОбщиеСкрипты.Добавить("vs/loader.js");
	
	Если СлужебныеНастройки.ЯзыкКонсоли = "ru" Тогда
		ФайлыПрочие["#config#"] = "require.config({'vs/nls':{availableLanguages:{'*':'ru'}}});";
		ОбщиеСкрипты.Добавить("#config#");
		ОбщиеСкрипты.Добавить("vs/editor/editor.main.nls.ru.js");
		ИсключитьФайлы.Добавить("vs/editor/editor.main.nls.js");
	Иначе
		ОбщиеСкрипты.Добавить("vs/editor/editor.main.nls.js");
		ИсключитьФайлы.Добавить("vs/editor/editor.main.nls.ru.js");
	КонецЕсли;
	
	Если СлужебныеНастройки.ПоддержкаXML Тогда
		ОбщиеСкрипты.Добавить("vs/basic-languages/xml/xml.js");
	КонецЕсли;
	Если СлужебныеНастройки.ПоддержкаJSON Тогда
		ОбщиеСкрипты.Добавить("vs/basic-languages/json/json.js");
	КонецЕсли;
	Если СлужебныеНастройки.ПоддержкаYAML Тогда
		ОбщиеСкрипты.Добавить("vs/basic-languages/yaml/yaml.js");
	КонецЕсли;
	
	ОбщиеСкрипты.Добавить("vs/editor/editor.main.js");
	
	ОбщиеСкрипты.Добавить("bslMetadata.js");
	ОбщиеСкрипты.Добавить("bslGlobals.js");
	ОбщиеСкрипты.Добавить("snippets.js");
	ОбщиеСкрипты.Добавить("bsl_helper.js");
	ОбщиеСкрипты.Добавить("bsl_language.js");
	ОбщиеСкрипты.Добавить("actions.js");
	ОбщиеСкрипты.Добавить("bslQuery.js");
	ОбщиеСкрипты.Добавить("bslDCS.js");
	ОбщиеСкрипты.Добавить("colors.js");
	ОбщиеСкрипты.Добавить("finder.js");
	ОбщиеСкрипты.Добавить("parsers.js");
	ОбщиеСкрипты.Добавить("editor.js");
	
	ДлинаКорневогоПути = СтрДлина(КаталогВременныхФайлов);
	Для Каждого НайденныйФайл Из НайденныеФайлы Цикл
		
		Если НайденныйФайл.ЭтоКаталог() Тогда
			Продолжить;
		КонецЕсли;
		
		ИмяФайла = СтрЗаменить(Сред(НайденныйФайл.ПолноеИмя, ДлинаКорневогоПути + 2), "\", "/");
		
		Если НайденныйФайл.Расширение = ".html" Тогда
			
			ЧтениеТекста = Новый ЧтениеТекста(НайденныйФайл.ПолноеИмя);
			ВебСтраницы[ИмяФайла] = ЧтениеТекста.Прочитать();
			ЧтениеТекста.Закрыть();
			
		ИначеЕсли НайденныйФайл.Расширение = ".css" Тогда
			
			ЧтениеТекста = Новый ЧтениеТекста(НайденныйФайл.ПолноеИмя, КодировкаТекста.UTF8);
			ФайлыСтилей[ИмяФайла] = ЧтениеТекста.Прочитать();
			ЧтениеТекста.Закрыть();
			
		ИначеЕсли НайденныйФайл.Расширение = ".js" И ОбщиеСкрипты.Найти(ИмяФайла) <> Неопределено Тогда
			
			ЧтениеТекста = Новый ЧтениеТекста(НайденныйФайл.ПолноеИмя, КодировкаТекста.UTF8);
			ФайлыПрочие[ИмяФайла] = ЧтениеТекста.Прочитать();
			ЧтениеТекста.Закрыть();
			
		ИначеЕсли ИсключитьФайлы.Найти(ИмяФайла) = Неопределено Тогда
			ФайлыПрочие[ИмяФайла] = Новый ДвоичныеДанные(НайденныйФайл.ПолноеИмя);
		КонецЕсли;
		
	КонецЦикла;
	
	УдалитьФайлы(КаталогВременныхФайлов);
	
	// Изменение файлов

	// Удаление из css загрузки шрифта из файла, т.к. он добавлен ранее в "decorations.css"
	ФайлыСтилей["vs/editor/editor.main.css"] = СтрЗаменить(ФайлыСтилей["vs/editor/editor.main.css"], "@font-face{font-family:codicon;src:url(../base/browser/ui/codiconLabel/codicon/codicon.ttf) format(""truetype"")}", "");
	
	// Удаление зависимости "editor.main.js" от "vs/editor/editor.main.css", т.к. стили будут вставлены в веб-страницу, а в загрузчике используется обработчик после загрузки элемента CSS
	// Зависимость заменяется на предыдущую, а не удаляется, т.к. код editor.main.js использует номер зависимости в массиве зависимостей
	ФайлыПрочие["vs/editor/editor.main.js"] = СтрЗаменить(ФайлыПрочие["vs/editor/editor.main.js"], "vs/css!vs/editor/editor.main", "vs/nls!vs/editor/editor.main");
	
	Если СлужебныеНастройки.ПоддержкаJSON Тогда
		ТекстФайла = ФайлыПрочие["vs/editor/editor.main.js"];
		// Удаление строки с описанием форматов json через WebWorker
		// Удаление зависимости в define от удаленного описания json
		ПозНачала = СтрНайти(ТекстФайла, "define(""vs/language/json/monaco.contribution""");
		ПозКонца = СтрНайти(ТекстФайла, Символы.ПС, НаправлениеПоиска.СНачала, ПозНачала);
		ТекстФайла = Лев(ТекстФайла, ПозНачала - 1) + СтрЗаменить(Сред(ТекстФайла, ПозКонца + 1), ",""vs/language/json/monaco.contribution""", "");
		// Добавление упрощенного кода формата json без использования WebWorker (по аналогии с кодом формата xml) перед кодом формата xml. define добавлять не надо, т.к. блок с описанием xml входит в блок общих define форматов
		ТекстПоиска = ",define(""vs/basic-languages/xml/xml.contribution""";
		ТекстЗамены = ",define(""vs/basic-languages/json/json.contribution"",[""require"",""exports"",""../_.contribution""],(function(e,i,t){""use strict"";Object.defineProperty(i,""__esModule"",{value:!0}),t.registerLanguage({id:""json"",extensions:["".json""],aliases:[""JSON"", ""json""],mimetypes:[""application/json""],loader:function(){return new Promise((function(i,t){e([""./json""],i,t)}))}})}))"
			+ ТекстПоиска;
		ФайлыПрочие["vs/editor/editor.main.js"] = СтрЗаменить(ТекстФайла, ТекстПоиска, ТекстЗамены);
	КонецЕсли;
	
	// Подготовка файла общего скрипта
	
	ИмяФайлаОбщегоСкрипта = ПолучитьИмяВременногоФайла();
	ЗаписьТекста = Новый ЗаписьТекста(ИмяФайлаОбщегоСкрипта, КодировкаТекста.UTF8);
	
	Для Каждого ИмяФайла Из ОбщиеСкрипты Цикл
		ДанныеФайла = ФайлыПрочие[ИмяФайла];
		Если ДанныеФайла = Неопределено Тогда
			Продолжить; // Сообщить("Не найден файл " + ИмяФайла);
		КонецЕсли;
		ЗаписьТекста.Записать(ДанныеФайла);
		ЗаписьТекста.Записать(Символы.ПС);
		ФайлыПрочие[ИмяФайла] = Неопределено;
	КонецЦикла;
	ЗаписьТекста.Закрыть();
	// Замена загрузки loader.js на общий скрипт
	ФайлыПрочие["vs/loader.js"] = Новый ДвоичныеДанные(ИмяФайлаОбщегоСкрипта);
	
	УдалитьФайлы(ИмяФайлаОбщегоСкрипта);
	
	// Подготовка веб-страниц для использования в 1С
	
	Для Каждого ОписаниеВебСтраницы Из ВебСтраницы Цикл
		
		ТекстHTML = ОписаниеВебСтраницы.Значение;
		
		Для Каждого ОписаниеФайла Из ФайлыПрочие Цикл
			
			ДанныеФайла = ОписаниеФайла.Значение;
			ИмяФайла = ОписаниеФайла.Ключ;
			
			ТекстЭлемента = СтрШаблон("src=""%1""", ИмяФайла);
			ПозСтроки = СтрНайти(ТекстHTML, ТекстЭлемента);
			Если ПозСтроки > 0 Тогда
				НачПоз = СтрНайти(ТекстHTML, "<script", НаправлениеПоиска.СКонца, ПозСтроки);
				КонПоз = СтрНайти(ТекстHTML, ">", НаправлениеПоиска.СНачала, ПозСтроки, 2);
				ПолныйТекстЭлемента = Сред(ТекстHTML, НачПоз, КонПоз - НачПоз + 1);
				Если ДанныеФайла = Неопределено Тогда
					// Файл добавлен в общий скрипт - удаление ссылки загрузки
					ТекстHTML = СтрЗаменить(ТекстHTML, ПолныйТекстЭлемента, "");
				Иначе
					// Замены ссылки с файлом на ссылку с адресом временного хранилища
					АдресФайла = ПоместитьВоВременноеХранилище(ДанныеФайла, УникальныйИдентификаторФормы);
					НовыйТекстЭлемента = СтрШаблон("<script async=""async"" src=""%1""></script>", АдресФайла);
					ТекстHTML = СтрЗаменить(ТекстHTML, ПолныйТекстЭлемента, НовыйТекстЭлемента);
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
		
		// Замена файлов CSS на веб-странице
		
		Для Каждого ОписаниеСтиля Из ФайлыСтилей Цикл
			
			ТекстФайлаСтиля = ОписаниеСтиля.Значение;
			ПолноеИмяФайла = ОписаниеСтиля.Ключ;
			
			ТекстЭлемента = СтрШаблон("href=""%1""", ПолноеИмяФайла);
			ПозСтроки = СтрНайти(ТекстHTML, ТекстЭлемента);
			Если ПозСтроки > 0 Тогда
				НачПоз = СтрНайти(ТекстHTML, "<link", НаправлениеПоиска.СКонца, ПозСтроки);
				КонПоз = СтрНайти(ТекстHTML, ">", НаправлениеПоиска.СНачала, ПозСтроки);
				ПолныйТекстЭлемента = Сред(ТекстHTML, НачПоз, КонПоз - НачПоз + 1);
				
				НовыйТекстЭлемента = СтрШаблон("<style>%1</style>", ТекстФайлаСтиля);
				ТекстHTML = СтрЗаменить(ТекстHTML, ПолныйТекстЭлемента, НовыйТекстЭлемента);
			КонецЕсли;
			
		КонецЦикла;
		
		ВебСтраницы[ОписаниеВебСтраницы.Ключ] = ТекстHTML;
	КонецЦикла;
	
	Возврат ВебСтраницы;
	
КонецФункции

// Нормализует параметры инициализации
//
// Параметры:
//   ПараметрыИнициализации - Строка, ЭлементФормы, Структура, Неопределено - параметры инициализации
//
// Возвращаемое значение:
//   Массив - Нормализованные параметры. Массив структур рк_РедакторКода.ПараметрыИнициализации()
//     *Имя - ЭлементФорм - Элемент редактора на форме
//     *ЗаменитьЭлементНаФорме - Булево - Истина, если в Имя элемент формы с текстовым полем, которое нужно заменить на редактор
//     *ПереопределитьНастройки - Структура рк_РедакторКода.НастройкиПоУмолчанию(). Все текущие настройки с учетом переданныых в ПараметрыИнициализации
//
Функция НормализоватьПараметрыИнициализации(Форма, НовыеРедакторы)
	
	НормализованныеПараметры = Новый Массив;
	
	Если ТипЗнч(НовыеРедакторы) = Тип("Массив") Тогда
		МассивПараметров = НовыеРедакторы;
	Иначе
		МассивПараметров = Новый Массив;
		МассивПараметров.Добавить(НовыеРедакторы);
	КонецЕсли;
	Для Каждого ИмяИлиЭлементИлиПараметры Из МассивПараметров Цикл
		
		Если ТипЗнч(ИмяИлиЭлементИлиПараметры) = Тип("Структура") Тогда
			// Переданы готовые параметры инициализации
			ПараметрыЭлемента = ИмяИлиЭлементИлиПараметры;
		Иначе
			ПараметрыЭлемента = НовыеПараметрыИнициализации();
			
			Если ТипЗнч(ИмяИлиЭлементИлиПараметры) = Тип("Строка") Тогда
				Элемент = Форма.Элементы.Найти(ИмяИлиЭлементИлиПараметры);
			Иначе
				Элемент = ИмяИлиЭлементИлиПараметры;
			КонецЕсли;
			Если Элемент.Вид = ВидПоляФормы.ПолеHTMLДокумента Тогда
				ПараметрыЭлемента.ЭлементHTML = ИмяИлиЭлементИлиПараметры;
			Иначе
				ПараметрыЭлемента.ЭлементТекст = ИмяИлиЭлементИлиПараметры;
			КонецЕсли;
		КонецЕсли;
		
		НормализованныеПараметры.Добавить(ПараметрыЭлемента);
	КонецЦикла;
	
	Для Каждого ПараметрыЭлемента Из НормализованныеПараметры Цикл
		
		Если ТипЗнч(ПараметрыЭлемента.ЭлементТекст) = Тип("Строка") Тогда
			Элемент = Форма.Элементы.Найти(ПараметрыЭлемента.ЭлементТекст);
			Если Элемент = Неопределено Тогда
				ВызватьИсключение СтрШаблон(НСтр("ru='Не найден элемент Текст %1'"), ПараметрыЭлемента.ЭлементТекст);
			КонецЕсли;
			ПараметрыЭлемента.ЭлементТекст = Элемент;
		КонецЕсли;
		Если ПараметрыЭлемента.ЭлементТекст <> Неопределено И ПараметрыЭлемента.РеквизитТекст = Неопределено Тогда
			ПараметрыЭлемента.РеквизитТекст = ПараметрыЭлемента.ЭлементТекст.ПутьКДанным;
		КонецЕсли;
		
		Если ТипЗнч(ПараметрыЭлемента.ЭлементHTML) = Тип("Строка") Тогда
			Элемент = Форма.Элементы.Найти(ПараметрыЭлемента.ЭлементHTML);
			Если Элемент = Неопределено Тогда
				ВызватьИсключение СтрШаблон(НСтр("ru='Не найден элемент HTML %1'"), ПараметрыЭлемента.ЭлементHTML);
			КонецЕсли;
			ПараметрыЭлемента.ЭлементHTML = Элемент;
		КонецЕсли;
		Если ПараметрыЭлемента.ЭлементHTML <> Неопределено И ПараметрыЭлемента.РеквизитHTML = Неопределено Тогда
			ПараметрыЭлемента.РеквизитHTML = ПараметрыЭлемента.ЭлементHTML.ПутьКДанным;
		КонецЕсли;
		
		Если ТипЗнч(ПараметрыЭлемента.ЭлементСтраница) = Тип("Строка") Тогда
			Элемент = Форма.Элементы.Найти(ПараметрыЭлемента.ЭлементСтраница);
			Если Элемент = Неопределено Тогда
				ВызватьИсключение СтрШаблон(НСтр("ru='Не найден элемент-страница %1'"), ПараметрыЭлемента.ЭлементСтраница);
			КонецЕсли;
			ПараметрыЭлемента.ЭлементСтраница = Элемент;
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат НормализованныеПараметры;
	
КонецФункции

Процедура ДобавитьРеквизитыФормы(Форма, НормализованныеПараметры)
	
	НовыеРеквизиты = Новый Массив;
	
	КлючПроверки = Новый УникальныйИдентификатор;
	Для Каждого КлючИЗначение Из рк_РедакторКодаКлиентСервер.ИменаСлужебныхРеквизитов() Цикл
		ИмяРеквизита = КлючИЗначение.Значение.Имя;
		ТекстФорма = Новый Структура(ИмяРеквизита, КлючПроверки);
		ЗаполнитьЗначенияСвойств(ТекстФорма, Форма);
		Если ТекстФорма[ИмяРеквизита] = КлючПроверки Тогда
			НовыеРеквизиты.Добавить(Новый РеквизитФормы(ИмяРеквизита, КлючИЗначение.Значение.Тип));
		КонецЕсли;
	КонецЦикла;
	
	Для Каждого ПараметрыЭлемента Из НормализованныеПараметры Цикл
		Если ПараметрыЭлемента.РеквизитHTML = Неопределено Тогда
			ПараметрыЭлемента.РеквизитHTML = "рк_HTML" + СтрЗаменить(Новый УникальныйИдентификатор, "-", "");
			НовыеРеквизиты.Добавить(Новый РеквизитФормы(ПараметрыЭлемента.РеквизитHTML, Новый ОписаниеТипов("Строка")));
		КонецЕсли;
	КонецЦикла;
	
	Если НовыеРеквизиты.Количество() > 0 Тогда
		Форма.ИзменитьРеквизиты(НовыеРеквизиты);
	КонецЕсли;
	
КонецПроцедуры

Функция ДобавитьРедакторы(Форма, НормализованныеПараметры)
	
	ИспользоватьРедактор = рк_РедакторКодаКлиентСервер.ОбщиеПараметры(Форма).ИспользоватьРедактор;
	
	КонфигурацииРедакторов = Новый Массив;
	
	Для Каждого ПараметрыЭлемента Из НормализованныеПараметры Цикл
		
		Если ПараметрыЭлемента.ЭлементHTML = Неопределено Тогда
			Если ПараметрыЭлемента.ЭлементТекст = Неопределено Тогда
				Продолжить; // Не передан заменяемый элемент Текст
			КонецЕсли;
			// Добавление нового элемента HTML редактора кода для замены элемента Текст
			Если ПараметрыЭлемента.ЭлементСтраница = Неопределено Тогда
				// Добавление элемента HTML в группу элемента Текст
				ЭлементРедактора = Форма.Элементы.Вставить(ПараметрыЭлемента.РеквизитHTML, Тип("ПолеФормы"), ПараметрыЭлемента.ЭлементТекст.Родитель, ПараметрыЭлемента.ЭлементТекст);
			Иначе
				// Добавление элемента HTML на указанную страницу
				ЭлементРедактора = Форма.Элементы.Добавить(ПараметрыЭлемента.РеквизитHTML, Тип("ПолеФормы"), ПараметрыЭлемента.ЭлементСтраница);
			КонецЕсли;
			ЭлементРедактора.Вид = ВидПоляФормы.ПолеHTMLДокумента;
			ЭлементРедактора.ПутьКДанным = ПараметрыЭлемента.РеквизитHTML;
			ЭлементРедактора.ПоложениеЗаголовка = ПоложениеЗаголовкаЭлементаФормы.Нет;
			ЭлементРедактора.Видимость = Ложь;
			ЭлементРедактора.УстановитьДействие("ДокументСформирован", "Подключаемый_рк_ДокументСформирован");
			ЭлементРедактора.УстановитьДействие("ПриНажатии", "Подключаемый_рк_ПриНажатии");
			ЭлементРедактора.ТолькоПросмотр = ПараметрыЭлемента.ЭлементТекст.ТолькоПросмотр;
			
			ПараметрыЭлемента.ЭлементHTML = ЭлементРедактора;
		КонецЕсли;
		
		ПараметрыРедактора = рк_РедакторКодаКлиентСервер.ПараметрыРедактора(Форма, ПараметрыЭлемента.ЭлементHTML);
		ПараметрыРедактора.РеквизитHTML = ПараметрыЭлемента.РеквизитHTML;
		
		Если НЕ ПустаяСтрока(ПараметрыЭлемента.РеквизитТекст) Тогда
			ПараметрыРедактора.Вставить("РеквизитТекст", ПараметрыЭлемента.РеквизитТекст);
			ПараметрыРедактора.Вставить("ИмяЭлементаТекст", ПараметрыЭлемента.ЭлементТекст.Имя);
		КонецЕсли;
		
		Если ПараметрыЭлемента.ЭлементСтраница <> Неопределено Тогда
			// Веб-страница редактора будет установлена при обработке события ОбработчикПриСменеСтраницы, когда ТекущаяСтраница равна указанной
			ПараметрыРедактора.Вставить("ИмяЭлементаСтраница", рк_РедакторКодаКлиентСервер.НормализоватьИмяЭлемента(ПараметрыЭлемента.ЭлементСтраница));
		КонецЕсли;
		
		Если ПараметрыЭлемента.РежимЯзыка <> "bsl" Тогда
			ПараметрыРедактора.Вставить("РежимЯзыка", ПараметрыЭлемента.РежимЯзыка);
		КонецЕсли;
		
		ПараметрыРедактора.Конфигурация = ПараметрыЭлемента.Конфигурация;
		
		Если ПараметрыЭлемента.Параметры.Количество() > 0 Тогда
			// Произвольные внешние параметры добавляются в параметры редактора
			Для Каждого КлючИЗначение Из ПараметрыЭлемента.Параметры Цикл
				ПараметрыРедактора.Вставить(КлючИЗначение.Ключ, КлючИЗначение.Значение);
			КонецЦикла;
		КонецЕсли;
		
		Если ИспользоватьРедактор Тогда
			// Переключение на элемент редактора HTML
			Если ПараметрыЭлемента.ЭлементТекст <> Неопределено Тогда
				ПараметрыЭлемента.ЭлементТекст.Видимость = Ложь;
			КонецЕсли;
			ПараметрыЭлемента.ЭлементHTML.Видимость = Истина;
		КонецЕсли;
		
		// Постоянные настройки, которые заменяют общие при обновлении настроек
		Если ПараметрыЭлемента.Настройки.Количество() > 0 Тогда
			ПараметрыРедактора.Вставить("АдресНастройки", ПоместитьВоВременноеХранилище(ПараметрыЭлемента.Настройки, Форма.УникальныйИдентификатор));
		КонецЕсли;
		
		Если КонфигурацииРедакторов.Найти(ПараметрыРедактора.Конфигурация) = Неопределено Тогда
			КонфигурацииРедакторов.Добавить(ПараметрыРедактора.Конфигурация);
		КонецЕсли;
		
		Если ПараметрыЭлемента.Контекст.Количество() > 0 Тогда
			РезультатыЗапроса = Новый Соответствие;
			РезультатыЗапроса.Вставить("#locals", Новый Структура("Тип,Данные", "Контекст", ДанныеВJSON(ПараметрыЭлемента.Контекст)));
			ПараметрыРедактора.Вставить("АдресКонтекст", ПоместитьВоВременноеХранилище(РезультатыЗапроса, Форма.УникальныйИдентификатор));
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат КонфигурацииРедакторов;
	
КонецФункции

Процедура СохранитьНастройкиКонфигураций(Форма, КонфигурацииРедакторов, НастройкиКонфигураций)
	
	ОбщиеПараметры = рк_РедакторКодаКлиентСервер.ОбщиеПараметры(Форма);
	
	Если НастройкиКонфигураций = Неопределено Тогда
		НастройкиКонфигураций = Новый Соответствие;
		НастройкиКонфигураций[Неопределено] = НастройкиКонфигурации(); // Настройки текущей конфигурации
	КонецЕсли;
	
	Для Каждого Конфигурация Из КонфигурацииРедакторов Цикл
		НастройкиКонфигурации = НастройкиКонфигураций[Конфигурация];
		ОбщиеПараметры.НастройкиКонфигурации[Конфигурация] = ПоместитьВоВременноеХранилище(НастройкиКонфигурации, Форма.УникальныйИдентификатор);
		Если НастройкиКонфигурации.ВнешниеМетаданные Тогда
			ОбщиеПараметры.ОбщиеРеквизиты[Конфигурация] = ПоместитьВоВременноеХранилище(Неопределено, Форма.УникальныйИдентификатор);
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

Процедура УстановитьВебСтраницыРедакторов(Форма, ОбщиеПараметры)
	
	ВсеРедактора = рк_РедакторКодаКлиентСервер.ПараметрыВсехРедакторов(Форма);
	
	ЕстьУстановкаВебСтраницы = Ложь;
	Для Каждого ЭлементСписка Из ВсеРедактора Цикл
		ПараметрыРедактора = ЭлементСписка.Значение;
		Если НЕ ПараметрыРедактора.Свойство("ИмяЭлементаСтраница") Тогда
			ЕстьУстановкаВебСтраницы = Истина; // Для редактора не указана его элемент-страница - веб-страница устанавливается сразу
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	Если НЕ ЕстьУстановкаВебСтраницы Тогда
		Возврат; // Получение файлов редактора будет выполняться на клиенте при первом переключении на редактор
	КонецЕсли;
	
	ФайлыРедактора = ПодготовитьФайлыРедактора(Форма.УникальныйИдентификатор);
	Если ФайлыРедактора = Неопределено Тогда
		Возврат; // не удалось подготовить файлы редактора
	КонецЕсли;
	ОбщиеПараметры.Вставить("АдресФайлыРедактора", ПоместитьВоВременноеХранилище(ФайлыРедактора, Форма.УникальныйИдентификатор));
	
	ТекстHTML = ФайлыРедактора["index.html"];
	
	Для Каждого ЭлементСписка Из ВсеРедактора Цикл
		ПараметрыРедактора = ЭлементСписка.Значение;
		Если НЕ ПараметрыРедактора.Свойство("ИмяЭлементаСтраница") Тогда
			Форма[ПараметрыРедактора.РеквизитHTML] = ТекстHTML;
			ПараметрыРедактора.Удалить("РеквизитHTML"); // Имя реквизита больше не нужно
			ПараметрыРедактора.Удалить("ФлагНетВебСтраницы");
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

Функция ЗаданиеИнициализироватьГлобальныйКонтекст(НастройкиКонфигурации) Экспорт
	
	ПараметрыЗапроса = Новый Массив;
	ПараметрыЗапроса.Добавить("#globals");
	
	РезультатыЗапроса = Новый Соответствие;
	ОбработатьЗапросМетаданных(РезультатыЗапроса, ПараметрыЗапроса, НастройкиКонфигурации);
	
	Возврат РезультатыЗапроса;
	
КонецФункции

#КонецОбласти

#Область ОбщиеМетаданные

Процедура ОбработатьЗапросМетаданных(РезультатыЗапроса, ПараметрыЗапроса, НастройкиКонфигурации) Экспорт
	
	Для Каждого ПараметрЗапроса Из ПараметрыЗапроса Цикл
		
		РезультатЗапроса = Неопределено;
		
		Если ПараметрЗапроса = "#globals" ИЛИ ПараметрЗапроса = "общиемодули" Тогда
			
			Если РезультатыЗапроса["#globals"] <> Неопределено Тогда
				Продолжить;
			КонецЕсли;
			
			КоллекцияГлобальныеМодули = Новый Массив;
			
			РезультатЗапроса = КоллекцияОбъектовМетаданных("общиемодули", НастройкиКонфигурации, КоллекцияГлобальныеМодули);
			РезультатыЗапроса.Вставить("общиемодули", РезультатЗапроса);
			
			РезультатЗапроса = ТекстыОбщегоМодуля(КоллекцияГлобальныеМодули, НастройкиКонфигурации);
			РезультатыЗапроса.Вставить("#globals", РезультатЗапроса);
			
		Иначе
			ЧастиЗапроса = СтрРазделить(ПараметрЗапроса, ".");
			Если НРег(ЧастиЗапроса[0]) = "module" Тогда
				
				Если ЧастиЗапроса.Количество() = 4 Тогда
					// Текст модуля объекта или модуля менеджера (например "module.manager.справочники.номенклатура." или "module.object.справочники.номенклатура."
					РезультатЗапроса = ТекстыМодуляОбъекта(ЧастиЗапроса[2], ЧастиЗапроса[3], НРег(ЧастиЗапроса[1]), НастройкиКонфигурации);
				Иначе
					// Текст общего модуля (например, "общегоназначения"
					РезультатЗапроса = ТекстыОбщегоМодуля(ЧастиЗапроса[1], НастройкиКонфигурации);
				КонецЕсли;
				
			ИначеЕсли ЧастиЗапроса.Количество() = 1 Тогда
				
				// Запрос содержимого коллекции метаданных (например, "справочники")
				РезультатЗапроса = КоллекцияОбъектовМетаданных(ПараметрЗапроса, НастройкиКонфигурации);
				
			ИначеЕсли ЧастиЗапроса.Количество() = 2 Тогда
				
				// Запрос конкретного объекта метаданных (например, "справочники.номенклатура")
				РезультатЗапроса = ОписаниеОбъектаМетаданных(ЧастиЗапроса[0], ЧастиЗапроса[1], НастройкиКонфигурации);
				
			КонецЕсли;
			
			Если РезультатЗапроса <> Неопределено Тогда
				РезультатыЗапроса.Вставить(ПараметрЗапроса, РезультатЗапроса);
			КонецЕсли;
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

Функция ОбработатьМодули(ТекстыМодуля, ОбработчикМодулей) Экспорт
	
	Результат = Новый СписокЗначений;
	
	ДанныеМодуля = Новый Структура;
	ДанныеМодуля.Вставить("module", Новый Структура);
	ДанныеМодуля.Вставить("count", 0);
	
	Для Каждого ЭлементСписка Из ТекстыМодуля Цикл
		Если ОбработчикМодулей = "RegExp" Тогда
			рк_ОбработчикМодулейRegExp.ЗаполнитьМетодыМодуля(ДанныеМодуля, ЭлементСписка.Значение, ЭлементСписка.Пометка);
		КонецЕсли;
	КонецЦикла;
	
	Результат.Добавить(ДанныеВJSON(ДанныеМодуля));
	
	Возврат Результат;
	
КонецФункции

// Получает список объектов определённой коллекции метаданных в формате консоли кода
//
Функция КоллекцияОбъектовМетаданных(ИмяКоллекции, НастройкиКонфигурации, ГлобальныеМодули = Неопределено)
	
	Перем Маппинг;
	
	ИмяКоллекцииРедактора = МаппингConsole(ИмяКоллекции, Маппинг);
	Если ИмяКоллекцииРедактора = Неопределено Тогда
		Возврат Неопределено; // Объект не поддерживается в консоли
	КонецЕсли;
	
	СписокОбъектов = Новый Структура;
	ЭтоОбщиеМодули = ГлобальныеМодули <> Неопределено;
	
	Если НастройкиКонфигурации.ВнешниеМетаданные Тогда
		Коллекция = Новый СписокЗначений;
		
		ИмяКаталогаКоллекции = МаппингМнEng(ИмяКоллекции, Маппинг);
		
		Если НастройкиКонфигурации.ЭтоИсходникиEDT Тогда
			ИмяКаталогаКоллекции = "src" + ПолучитьРазделительПути() + ИмяКаталогаКоллекции;
		КонецЕсли;
		
		ПрочитатьОбъектыКоллекцииXML(Коллекция, НастройкиКонфигурации.ПутьКИсходникамКонфигурации + ИмяКаталогаКоллекции, ЭтоОбщиеМодули, НастройкиКонфигурации.ЭтоИсходникиEDT);
		
		Для Каждого ПутьКИсходникамРасширения Из НастройкиКонфигурации.ПутьКИсходникамРасширений Цикл
			ПрочитатьОбъектыКоллекцииXML(Коллекция, ПутьКИсходникамРасширения + ИмяКаталогаКоллекции, ЭтоОбщиеМодули, НастройкиКонфигурации.ЭтоИсходникиEDT);
		КонецЦикла;
		
		Для Каждого ЭлементСписка Из Коллекция Цикл
			// Пометка ЭлементСписка - признак глобального модуля
			Если ЭтоОбщиеМодули И ЭлементСписка.Пометка Тогда
				ГлобальныеМодули.Добавить(ЭлементСписка.Значение);
			Иначе
				СписокОбъектов.Вставить(ЭлементСписка.Значение, Новый Структура);
			КонецЕсли;
		КонецЦикла;
	Иначе
		Попытка
			Для Каждого ОбъектМД Из Метаданные[ИмяКоллекции] Цикл
				Если ЭтоОбщиеМодули И ОбъектМД.Глобальный Тогда
					ГлобальныеМодули.Добавить(ОбъектМД.Имя);
				Иначе
					СписокОбъектов.Вставить(ОбъектМД.Имя, Новый Структура);
				КонецЕсли;
			КонецЦикла;
		Исключение
			Инфо = ИнформацияОбОшибке();
		КонецПопытки;
	КонецЕсли;
	
	Результат = Новый Структура;
	Результат.Вставить("Тип", "Метаданные");
	Результат.Вставить("Адрес", СтрШаблон("%1.items", ИмяКоллекцииРедактора));
	Результат.Вставить("Данные", ДанныеВJSON(СписокОбъектов));
	
	Возврат Результат;
	
КонецФункции

// Получает описание конкретного объекта метаданных в формате консоли кода
//
Функция ОписаниеОбъектаМетаданных(ИмяКоллекции, ИмяОбъекта, НастройкиКонфигурации)
	
	Если НастройкиКонфигурации.ВнешниеМетаданные Тогда
		ОписаниеОбъекта = ОписаниеОбъектаМетаданныхXML(ИмяКоллекции, ИмяОбъекта, НастройкиКонфигурации);
	Иначе
		ОписаниеОбъекта = ОписаниеОбъектаМетаданныхИБ(ИмяКоллекции, ИмяОбъекта);
	КонецЕсли;
	
	Если ОписаниеОбъекта = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Результат = Новый Структура;
	Результат.Вставить("Тип", "Метаданные");
	Результат.Вставить("Адрес", СтрШаблон("%1.items.%2", ОписаниеОбъекта.ИмяКоллекцииРедактора, ОписаниеОбъекта.ИмяОбъектаМетаданных));
	Результат.Вставить("Данные", ДанныеВJSON(ОписаниеОбъекта.Данные));
	
	Возврат Результат;
	
КонецФункции

// Читает текст общего модуля из файла исходников.
// 
// Параметры:
//   НастройкиКонфигурации - Структура
//   ИмяМодуля - Строка - имя модуля
//
// Возвращаемое значение:
//   Структура, Неопределено - данные модуля
//
Функция ТекстыОбщегоМодуля(ИмяМодуляИлиМассив, НастройкиКонфигурации)
	
	Если ПустаяСтрока(НастройкиКонфигурации.ПутьКИсходникамКонфигурации) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Результат = Новый Структура;
	Результат.Вставить("Данные", Новый СписокЗначений);
	Результат.Вставить("Тип", "Модуль");
	Результат.Вставить("Обработан", Ложь);
	
	Если ТипЗнч(ИмяМодуляИлиМассив) = Тип("Массив") Тогда
		ИменаМодулей = ИмяМодуляИлиМассив;
		Глобальный = Истина;
		
		Результат.Вставить("Адрес", "globalfunctions");
	Иначе
		ИменаМодулей = Новый Массив;
		ИменаМодулей.Добавить(ИмяМодуляИлиМассив);
		Глобальный = Ложь;
		
		Результат.Вставить("Адрес", СтрШаблон("commonModules.items.%1", НРег(ИмяМодуляИлиМассив)));
	КонецЕсли;
	
	РазделительПути = ПолучитьРазделительПути();
	
	Для Каждого ИмяМодуля Из ИменаМодулей Цикл
		
		Если НастройкиКонфигурации.ЭтоИсходникиEDT Тогда
			ИмяФайлаБезКаталога = СтрШаблон("src%1CommonModules%1%2%1Module.bsl", РазделительПути, ИмяМодуля);
		Иначе
			ИмяФайлаБезКаталога = СтрШаблон("CommonModules%1%2%1Ext%1Module.bsl", РазделительПути, ИмяМодуля);
		КонецЕсли;
		
		ПрочитатьТекстыМодуля(Результат.Данные, ИмяФайлаБезКаталога, Глобальный, НастройкиКонфигурации);
	КонецЦикла;
	
	Если ЗначениеЗаполнено(НастройкиКонфигурации.ОбработчикМодулей) Тогда
		Результат.Данные = ОбработатьМодули(Результат.Данные, НастройкиКонфигурации.ОбработчикМодулей);
		Результат.Обработан = Истина;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Читает текст модуля объекта (менеджера или объекта) из файла исходников.
// 
// Параметры:
//   КаталогИсходногоКода - Строка - путь к каталогу с исходниками
//   ТипМодуля - Строка - "manager" или "object"
//   КоллекцияМетаданных - Строка - имя коллекции
//   ИмяОбъекта - Строка - имя объекта метаданных
//
// Возвращаемое значение:
//   Структура, Неопределено - данные модуля
//
Функция ТекстыМодуляОбъекта(ИмяКоллекции, ИмяОбъекта, ТипМодуля, НастройкиКонфигурации)
	
	Перем Маппинг;
	
	Если ПустаяСтрока(НастройкиКонфигурации.ПутьКИсходникамКонфигурации) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	// TODO сделать в bsl_console поиск модулей по имени в нижнем регистре как и для других объектов чтобы не читать файл с описанием модуля
	
	ИмяОбъектаМетаданных = Неопределено;
	
	// Получение имени объекта как в метаданных, так как в редакторе сведения хранятся для этого имени
	Если НастройкиКонфигурации.ВнешниеМетаданные Тогда
		РазделительПути = ПолучитьРазделительПути();
		
		ИмяКаталогаМодуля = МаппингМнEng(ИмяКоллекции, Маппинг);
		
		Если НастройкиКонфигурации.ЭтоИсходникиEDT Тогда
			ИмяФайлаБезКаталога = СтрШаблон("src%1%2%1%3%1%3.mdo", РазделительПути, ИмяКаталогаМодуля, ИмяОбъекта);
		Иначе
			ИмяФайлаБезКаталога = СтрШаблон("%2%1%3.xml", РазделительПути, ИмяКаталогаМодуля, ИмяОбъекта);
		КонецЕсли;
		
		ОписаниеОбъекта = Новый Структура("Name");
		Попытка
			ПрочитатьКраткиеСведенияОбъектаXML(НастройкиКонфигурации.ПутьКИсходникамКонфигурации + ИмяФайлаБезКаталога, ОписаниеОбъекта, НастройкиКонфигурации.ЭтоИсходникиEDT);
		Исключение
			Инфо = ИнформацияОбОшибке();
		КонецПопытки;
		Если ОписаниеОбъекта.Name = Неопределено Тогда
			// Поиск объекта метаданных среди расширений
			Для Каждого ПутьКИсходникамРасширения Из НастройкиКонфигурации.ПутьКИсходникамРасширений Цикл
				Попытка
					ПрочитатьКраткиеСведенияОбъектаXML(ПутьКИсходникамРасширения + ИмяФайлаБезКаталога, ОписаниеОбъекта, НастройкиКонфигурации.ЭтоИсходникиEDT);
				Исключение
				КонецПопытки;
				Если ОписаниеОбъекта.Name <> Неопределено Тогда
					Прервать; // Найден объект метаданных
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
		Если ОписаниеОбъекта.Name = Неопределено Тогда
			Возврат Неопределено;
		КонецЕсли;
		ИмяОбъектаМетаданных = ОписаниеОбъекта.Name;
	Иначе
		Попытка
			ИмяОбъектаМетаданных = Метаданные[ИмяКоллекции][ИмяОбъекта].Имя;
		Исключение
			Инфо = ИнформацияОбОшибке();
			Возврат Неопределено;
		КонецПопытки;
	КонецЕсли;
	
	// Получение текстов модуля (из конфигурации и расширений)
	РазделительПути = ПолучитьРазделительПути();
	
	ИмяФайлаМодуля = ?(НРег(ТипМодуля) = "manager", "ManagerModule", "ObjectModule");
	ИмяКаталогаМодуля = МаппингМнEng(ИмяКоллекции, Маппинг);
	ИмяКоллекцииРедактора = МаппингConsole(ИмяКоллекции, Маппинг);
	
	Если НастройкиКонфигурации.ЭтоИсходникиEDT Тогда
		ИмяФайлаБезКаталога = СтрШаблон("src%1%2%1%3%1%4.bsl", РазделительПути, ИмяКаталогаМодуля, ИмяОбъекта, ИмяФайлаМодуля);
	Иначе
		ИмяФайлаБезКаталога = СтрШаблон("%2%1%3%1Ext%1%4.bsl", РазделительПути, ИмяКаталогаМодуля, ИмяОбъекта, ИмяФайлаМодуля);
	КонецЕсли;
	
	Результат = Новый Структура;
	Результат.Вставить("Данные", Новый СписокЗначений);
	Результат.Вставить("Тип", "Модуль");
	Результат.Вставить("Обработан", Ложь);
	Результат.Вставить("Адрес", СтрШаблон("%1.items.%2.%3", ИмяКоллекцииРедактора, ИмяОбъектаМетаданных, НРег(ТипМодуля)));
	
	ПрочитатьТекстыМодуля(Результат.Данные, ИмяФайлаБезКаталога, Ложь, НастройкиКонфигурации);
	
	Если ЗначениеЗаполнено(НастройкиКонфигурации.ОбработчикМодулей) Тогда
		Результат.Данные = ОбработатьМодули(Результат.Данные, НастройкиКонфигурации.ОбработчикМодулей);
		Результат.Обработан = Истина;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция МаппингИменМетаданных(Маппинг)
	
	Если Маппинг <> Неопределено Тогда
		Возврат Маппинг;
	КонецЕсли;
	
	Маппинг = рк_РедакторКодаПовтИсп.МаппингИменМетаданных();
	
	Возврат Маппинг;
	
КонецФункции

Функция МаппингМнRus(ИмяМнRus, Маппинг)
	Возврат МаппингИменМетаданных(Маппинг).МнRus[НРег(ИмяМнRus)];
КонецФункции

Функция МаппингЕдEng(ИмяМнRus, Маппинг)
	Возврат МаппингИменМетаданных(Маппинг).ЕдEng[НРег(ИмяМнRus)];
КонецФункции

Функция МаппингМнEng(ИмяМнRus, Маппинг)
	Возврат МаппингИменМетаданных(Маппинг).МнEng[НРег(ИмяМнRus)];
КонецФункции

Функция МаппингConsole(ИмяМнRus, Маппинг)
	Возврат МаппингИменМетаданных(Маппинг).console[НРег(ИмяМнRus)];
КонецФункции

Функция ЕстьПредопределенные(ИмяМнRus, Маппинг)
	Возврат МаппингИменМетаданных(Маппинг).ЕстьПредопределенные[НРег(ИмяМнRus)] = Истина;
КонецФункции

Функция ЕстьОбщиеРеквизиты(ИмяМнRus, Маппинг)
	Возврат МаппингИменМетаданных(Маппинг).ЕстьОбщиеРеквизиты[НРег(ИмяМнRus)] = Истина;
КонецФункции

Функция ЕстьТЧ(ИмяМнRus, Маппинг)
	Возврат МаппингИменМетаданных(Маппинг).ЕстьТЧ[НРег(ИмяМнRus)] = Истина;
КонецФункции

Процедура ПрочитатьТекстыМодуля(ТекстыМодуля, ИмяФайлаБезКаталога, БезРасширений, НастройкиКонфигурации)
	
	ТекстМодуля = ПрочитатьТекстФайла(НастройкиКонфигурации.ПутьКИсходникамКонфигурации + ИмяФайлаБезКаталога);
	Если ТекстМодуля <> Неопределено Тогда
		ТекстыМодуля.Добавить(ТекстМодуля);
	КонецЕсли;
	
	Если БезРасширений Тогда
		Возврат;
	КонецЕсли;
	
	Для Каждого ПутьКИсходникамРасширения Из НастройкиКонфигурации.ПутьКИсходникамРасширений Цикл
		
		ТекстМодуля = ПрочитатьТекстФайла(ПутьКИсходникамРасширения + ИмяФайлаБезКаталога);
		Если ТекстМодуля <> Неопределено Тогда
			ТекстыМодуля.Добавить(ТекстМодуля);
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

Функция ПрочитатьТекстФайла(ПутьКФайлу)
	
	Попытка
		Текст = Новый ЧтениеТекста(ПутьКФайлу, КодировкаТекста.UTF8,,, Ложь);
		Возврат Текст.Прочитать();
	Исключение
		инфо = ИнформацияОбОшибке();
		Возврат Неопределено;
	КонецПопытки;
	
КонецФункции

#КонецОбласти

#Область МетаданныеИБ

Функция ОписаниеОбъектаМетаданныхИБ(ИмяКоллекции, ИмяОбъекта)
	
	Перем Маппинг;
	
	ИмяКоллекцииРедактора = МаппингConsole(ИмяКоллекции, Маппинг);
	
	Если НЕ ЗначениеЗаполнено(ИмяКоллекцииРедактора) Тогда
		Возврат Неопределено; // Объект не поддерживается в консоли
	КонецЕсли;
	
	Попытка
		ОбъектМетаданных = Метаданные.НайтиПоПолномуИмени(СтрШаблон("%1.%2", ИмяКоллекции, ИмяОбъекта));
	Исключение
		ОбъектМетаданных = Неопределено;
	КонецПопытки;
	Если ОбъектМетаданных = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Результат = Новый Структура;
	Результат.Вставить("Данные", Новый Структура);
	Результат.Вставить("ИмяКоллекцииРедактора", ИмяКоллекцииРедактора);
	Результат.Вставить("ИмяОбъектаМетаданных", ОбъектМетаданных.Имя);
	
	КорневойТип = СтрРазделить(ОбъектМетаданных.ПолноеИмя(), ".")[0];
	
	ОписанияТипов = Новый Структура;
	ОписанияТипов.Вставить("Типы", Новый Соответствие);
	ОписанияТипов.Вставить("Маппинг", Маппинг);
	ОписанияТипов.Вставить("ИмяКоллекцииМетаданных",  МаппингМнRus(КорневойТип, Маппинг));
	
	ОписаниеРеквизитов = Новый Структура;
	ОписаниеРесурсов = Новый Структура;
	ОписаниеПредопределенных = Новый Структура;
	ОписаниеТабличныхЧастей = Новый Структура;
	СлужебныеДанные = Новый Структура;
	
	// Проверяем тип метаданных - для перечислений особая обработка
	Если ИмяКоллекции = "Перечисления" Тогда
		Для Каждого Реквизит Из ОбъектМетаданных.ЗначенияПеречисления Цикл
			ОписаниеРеквизитов.Вставить(Реквизит.Имя, Новый Структура("name", Реквизит.Синоним));
		КонецЦикла;
	Иначе
		Попытка
			Для Каждого Реквизит Из ОбъектМетаданных.СтандартныеРеквизиты Цикл
				ДобавитьРеквизитИБ(ОписаниеРеквизитов, Реквизит, ОписанияТипов);
			КонецЦикла;
		Исключение
			// Нет стандартных реквизитов
		КонецПопытки;
		
		Попытка
			Для Каждого Реквизит Из ОбъектМетаданных.Реквизиты Цикл
				ДобавитьРеквизитИБ(ОписаниеРеквизитов, Реквизит, ОписанияТипов);
			КонецЦикла;
		Исключение
			// Нет реквизитов
		КонецПопытки;
		
		Если ЕстьОбщиеРеквизиты(ИмяКоллекции, Маппинг) Тогда
			
			АвтоИспользованиеОбщегоРеквизита = Метаданные.СвойстваОбъектов.АвтоИспользованиеОбщегоРеквизита.Использовать;
			НеИспользоватьОбщийРеквизит = Метаданные.СвойстваОбъектов.ИспользованиеОбщегоРеквизита.НеИспользовать;
			
			Для Каждого Реквизит Из Метаданные.ОбщиеРеквизиты Цикл
				Автоиспользование = (Реквизит.АвтоИспользование = АвтоИспользованиеОбщегоРеквизита);
				ЭлементСостава = Реквизит.Состав.Найти(ОбъектМетаданных);
				ИспользованиеОбъекта = ?(ЭлементСостава = Неопределено, Неопределено, ЭлементСостава.Использование);
				
				Если (АвтоИспользование И ИспользованиеОбъекта <> НеИспользоватьОбщийРеквизит)
				 ИЛИ (НЕ АвтоИспользование И ИспользованиеОбъекта <> Метаданные.СвойстваОбъектов.ИспользованиеОбщегоРеквизита.Использовать) Тогда
					ДобавитьРеквизитИБ(ОписаниеРеквизитов, Реквизит, ОписанияТипов);
				КонецЕсли;
			КонецЦикла;
			
		КонецЕсли;
		
		Если ИмяКоллекции = "РегистрыСведений"
		 ИЛИ ИмяКоллекции = "РегистрыНакопления"
		 ИЛИ ИмяКоллекции = "РегистрыБухгалтерии"
		 ИЛИ ИмяКоллекции = "РегистрыРасчета" Тогда
			ЗаполнитьИзмеренияРесурсыИБ(ОбъектМетаданных, ОписаниеРеквизитов, ОписаниеРесурсов, СлужебныеДанные, ОписанияТипов);
		КонецЕсли;
		
		Если ЕстьТЧ(ИмяКоллекции, Маппинг) Тогда
			ЗаполнитьТабличныеЧастиИБ(ОбъектМетаданных, ОписаниеРеквизитов, ОписаниеТабличныхЧастей, ОписанияТипов);
		КонецЕсли;
		
		Если ЕстьПредопределенные(ИмяКоллекции, Маппинг) Тогда
			Для Каждого Имя Из ОбъектМетаданных.ПолучитьИменаПредопределенных() Цикл
				ОписаниеПредопределенных.Вставить(Имя, "");
			КонецЦикла;
		КонецЕсли;
	
	КонецЕсли;
	
	Результат.Данные.Вставить("properties", ОписаниеРеквизитов);
	
	Для Каждого КлючИЗначение Из СлужебныеДанные Цикл
		Результат.Данные.Вставить(КлючИЗначение.Ключ, КлючИЗначение.Значение);
	КонецЦикла;
	
	Если ОписаниеРесурсов.Количество() > 0 Тогда
		Результат.Данные.Вставить("resources", ОписаниеРесурсов);
	КонецЕсли;
	
	Если ОписаниеПредопределенных.Количество() > 0 Тогда
		Результат.Данные.Вставить("predefined", ОписаниеПредопределенных);
	КонецЕсли;
	
	Если ОписаниеТабличныхЧастей.Количество() > 0 Тогда
		Результат.Данные.Вставить("tabulars", ОписаниеТабличныхЧастей);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Добавляет описание реквизита в структуру.
Процедура ДобавитьРеквизитИБ(ОписаниеРеквизитов, Реквизит, ОписанияТипов)
	
	МассивТипов = Новый Массив;
	
	Для Каждого ТипСвойства Из Реквизит.Тип.Типы() Цикл
		
		ОбработанныйТип = ОписанияТипов.Типы[ТипСвойства];
		Если ОбработанныйТип <> Неопределено Тогда
			МассивТипов.Добавить(ОбработанныйТип);
			Продолжить;
		КонецЕсли;
		
		ОбъектМД = Метаданные.НайтиПоТипу(ТипСвойства);
		Если ОбъектМД = Неопределено Тогда
			Продолжить;
		КонецЕсли;
			
		КорневойТип = СтрРазделить(ОбъектМД.ПолноеИмя(), ".")[0];
		ИмяДляРедактораEд = МаппингConsole(КорневойТип, ОписанияТипов.Маппинг);
		Если ИмяДляРедактораEд = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		ОбработанныйТип = ИмяДляРедактораEд + "." + ОбъектМД.Имя;
		МассивТипов.Добавить(ОбработанныйТип);
		ОписанияТипов.Типы[ТипСвойства] = ОбработанныйТип;
		
	КонецЦикла;
	
	ОписаниеРеквизита = Новый Структура("name", Реквизит.Синоним);
	
	Если МассивТипов.Количество() > 0 Тогда
		ОписаниеРеквизита.Вставить("ref", СтрСоединить(МассивТипов, ","));
	КонецЕсли;
	
	ОписаниеРеквизитов.Вставить(Реквизит.Имя, ОписаниеРеквизита);
	
КонецПроцедуры

Процедура ЗаполнитьИзмеренияРесурсыИБ(ОбъектМД, ОписаниеРеквизитов, ОписаниеРесурсов, СлужебныеДанные, ОписанияТипов)
	
	Для Каждого Реквизит Из ОбъектМД.Измерения Цикл
		ДобавитьРеквизитИБ(ОписаниеРеквизитов, Реквизит, ОписанияТипов);
	КонецЦикла;
	
	Для Каждого Реквизит Из ОбъектМД.Ресурсы Цикл
		ДобавитьРеквизитИБ(ОписаниеРесурсов, Реквизит, ОписанияТипов);
	КонецЦикла;
	
	Если ОписанияТипов.ИмяКоллекцииМетаданных = "РегистрыСведений" Тогда
		
		Если ОбъектМД.ПериодичностьРегистраСведений = Метаданные.СвойстваОбъектов.ПериодичностьРегистраСведений.Непериодический Тогда
			ТипРегистра = "nonperiodical";
		Иначе
			ТипРегистра = "periodical";
		КонецЕсли;
		СлужебныеДанные.Вставить("type", ТипРегистра);
		
	ИначеЕсли ОписанияТипов.ИмяКоллекцииМетаданных = "РегистрыНакопления" Тогда
		
		Если ОбъектМД.ВидРегистра = Метаданные.СвойстваОбъектов.ВидРегистраНакопления.Остатки Тогда
			ТипРегистра = "balance";
		Иначе
			ТипРегистра = "turnovers";
		КонецЕсли;
		СлужебныеДанные.Вставить("type", ТипРегистра);
		
	КонецЕсли;
	
КонецПроцедуры

// Заполняет описание табличных частей.
Процедура ЗаполнитьТабличныеЧастиИБ(ОбъектМД, ОписаниеРеквизитов, ОписаниеТабличныхЧастей, ОписанияТипов)
	
	Для Каждого ТабличнаяЧасть Из ОбъектМД.ТабличныеЧасти Цикл
		
		ОписаниеРеквизитов.Вставить(ТабличнаяЧасть.Имя, Новый Структура("name", "ТЧ: " + ТабличнаяЧасть.Синоним));
		
		ОписаниеТабличнойЧасти = Новый Структура;
		
		Для Каждого РеквизитТЧ Из ТабличнаяЧасть.СтандартныеРеквизиты Цикл
			ОписаниеТабличнойЧасти.Вставить(РеквизитТЧ.Имя, РеквизитТЧ.Синоним);
		КонецЦикла;
		
		Для Каждого РеквизитТЧ Из ТабличнаяЧасть.Реквизиты Цикл
			ДобавитьРеквизитИБ(ОписаниеТабличнойЧасти, РеквизитТЧ, ОписанияТипов);
		КонецЦикла;
		
		СтруктураТабличнойЧасти = Новый Структура;
		СтруктураТабличнойЧасти.Вставить("properties", ОписаниеТабличнойЧасти);
		
		Если ОписаниеТабличнойЧасти.Количество() > 0 Тогда
			ОписаниеТабличныхЧастей.Вставить(ТабличнаяЧасть.Имя, СтруктураТабличнойЧасти);
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти

#Область ВнешниеМетаданные

#Если НЕ ВебКлиент Тогда

Функция ОписаниеОбъектаМетаданныхXML(ИмяКоллекции, ИмяОбъекта, НастройкиКонфигурации)
	
	Перем Маппинг;
	
	ИмяКоллекцииРедактора = МаппингConsole(ИмяКоллекции, Маппинг);
	
	Если НЕ ЗначениеЗаполнено(ИмяКоллекцииРедактора) Тогда
		Возврат Неопределено; // Объект не поддерживается в консоли
	КонецЕсли;
	
	РазделительПути = ПолучитьРазделительПути();
	
	ИмяКаталогаКоллекции = МаппингМнEng(ИмяКоллекции, Маппинг);
	
	Если НастройкиКонфигурации.ЭтоИсходникиEDT Тогда
		ИмяФайлаБезКаталога = СтрШаблон("src%1%2%1%3%1%3.mdo", РазделительПути, ИмяКаталогаКоллекции, ИмяОбъекта);
		ИмяФайлаПредопределенныхБезКаталога = Неопределено;
	Иначе
		ИмяФайлаБезКаталога = СтрШаблон("%2%1%3.xml", РазделительПути, ИмяКаталогаКоллекции, ИмяОбъекта);
		Если ЕстьПредопределенные(ИмяКоллекции, Маппинг) Тогда
			ИмяФайлаПредопределенныхБезКаталога = СтрШаблон("%2%1%3%1Ext%1Predefined.xml", РазделительПути, ИмяКаталогаКоллекции, ИмяОбъекта);
		Иначе
			ИмяФайлаПредопределенныхБезКаталога = Неопределено;
		КонецЕсли;
	КонецЕсли;
	
	Результат = Новый Структура;
	Результат.Вставить("Данные", Новый Структура);
	Результат.Вставить("ИмяКоллекцииРедактора", ИмяКоллекцииРедактора);
	Результат.Вставить("ИмяОбъектаМетаданных");
	
	ОписанияТипов = Новый Структура;
	ОписанияТипов.Вставить("Маппинг", Маппинг);
	ОписанияТипов.Вставить("Типы", Новый Соответствие);
	ОписанияТипов.Вставить("ИмяКоллекцииМетаданных", МаппингМнRus(ИмяКоллекции, Маппинг));
	
	Попытка
		ПрочитатьСведенияОбъектаXML(НастройкиКонфигурации.ПутьКИсходникамКонфигурации + ИмяФайлаБезКаталога, Результат, НастройкиКонфигурации.ЭтоИсходникиEDT, ОписанияТипов);
		
		Если ИмяФайлаПредопределенныхБезКаталога <> Неопределено Тогда
			ПрочитатьОписаниеПредопределенныхXML(НастройкиКонфигурации.ПутьКИсходникамКонфигурации + ИмяФайлаПредопределенныхБезКаталога, Результат, ИмяКоллекции, Маппинг);
		КонецЕсли;
		
		Если ЕстьОбщиеРеквизиты(ИмяКоллекции, Маппинг) Тогда
			Если ТипЗнч(НастройкиКонфигурации.ОбщиеРеквизиты) = Тип("Строка") Тогда
				// Общие реквизиты еще не получались из хранилища
				ОбщиеРеквизиты = ПолучитьИзВременногоХранилища(НастройкиКонфигурации.ОбщиеРеквизиты);
				Если ОбщиеРеквизиты = Неопределено Тогда
					// Общие реквизиты еще не получались из метаданных
					ОбщиеРеквизиты = ПрочитатьОписанияВсехОбщихРеквизитовXML(НастройкиКонфигурации);
					ПоместитьВоВременноеХранилище(ОбщиеРеквизиты, НастройкиКонфигурации.ОбщиеРеквизиты);
					НастройкиКонфигурации.ОбщиеРеквизиты = ОбщиеРеквизиты;
				КонецЕсли;
			КонецЕсли;
			ЗаполнитьОбщиеРеквизитыXML(НастройкиКонфигурации.ОбщиеРеквизиты, Результат, ОписанияТипов);
		КонецЕсли;
	Исключение
		Инфо = ИнформацияОбОшибке();
	КонецПопытки;
	
	Для Каждого ПутьКИсходникамРасширения Из НастройкиКонфигурации.ПутьКИсходникамРасширений Цикл
		Попытка
			ПрочитатьСведенияОбъектаXML(ПутьКИсходникамРасширения + ИмяФайлаБезКаталога, Результат, НастройкиКонфигурации.ЭтоИсходникиEDT, ОписанияТипов);
			
			Если ИмяФайлаПредопределенныхБезКаталога <> Неопределено Тогда
				ПрочитатьОписаниеПредопределенныхXML(ПутьКИсходникамРасширения + ИмяФайлаПредопределенныхБезКаталога, Результат.Данные, ИмяКоллекции, Маппинг);
			КонецЕсли;
		Исключение
			Инфо = ИнформацияОбОшибке();
		КонецПопытки;
	КонецЦикла;
	
	Если Результат.ИмяОбъектаМетаданных = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Процедура ПрочитатьОбъектыКоллекцииXML(Коллекция, ИмяКаталогаКоллекции, ЭтоОбщиеМодули, ЭтоИсходникиEDT)
	
	РазделительПути = ПолучитьРазделительПути();
	
	Если ЭтоИсходникиEDT Тогда
		НайденныеФайлы = НайтиФайлы(ИмяКаталогаКоллекции, "*.mdo", Истина);
	Иначе
		НайденныеФайлы = НайтиФайлы(ИмяКаталогаКоллекции, "*.xml", Ложь);
	КонецЕсли;
	
	Для Каждого НайденныйФайл Из НайденныеФайлы Цикл
		
		ЭлементСписка = Коллекция.Добавить(НайденныйФайл.ИмяБезРасширения);
		
		Если ЭтоОбщиеМодули Тогда
			// Для общих модулей дополнительно нужно прочитать признак "Глобальный"
			Если ЭтоИсходникиEDT Тогда
				ПолноеИмяФайла = СтрШаблон("%2%1%3%1%3.mdo", РазделительПути, ИмяКаталогаКоллекции, НайденныйФайл.ИмяБезРасширения);
			Иначе
				ПолноеИмяФайла = СтрШаблон("%2%1%3.xml", РазделительПути, ИмяКаталогаКоллекции, НайденныйФайл.ИмяБезРасширения);
			КонецЕсли;
			
			ОписаниеОбъекта = Новый Структура("Global", "false");
			ПрочитатьКраткиеСведенияОбъектаXML(ПолноеИмяФайла, ОписаниеОбъекта, ЭтоИсходникиEDT);
			
			ЭлементСписка.Пометка = Булево(ОписаниеОбъекта.Global);
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

Процедура ПрочитатьКраткиеСведенияОбъектаXML(ПолноеИмяФайла, ОписаниеОбъекта, ЭтоИсходникиEDT)
	
	ЧтениеXML = Новый ЧтениеXML;
	ЧтениеXML.ОткрытьФайл(ПолноеИмяФайла);
	
	ЧтениеXML.Прочитать();
	
	Если ЭтоИсходникиEDT Тогда
		ЧтениеXML.Прочитать(); // mdclass:Объект
	Иначе
		ЧтениеXML.Прочитать(); // MetaDataObject
		ЧтениеXML.Прочитать(); // Объект
	КонецЕсли;
	
	Если ЭтоУзелXML(ЧтениеXML, "InternalInfo") ИЛИ ЭтоУзелXML(ЧтениеXML, "producedTypes") Тогда
		ЧтениеXML.Пропустить(); // InternalInfo или producedTypes
		ЧтениеXML.Прочитать();
	КонецЕсли;
	
	ОсталосьСвойств = ОписаниеОбъекта.Количество();
	
	Если НЕ ЭтоИсходникиEDT Тогда
		ПрочитатьСвойстваXML(ЧтениеXML, ОписаниеОбъекта, ОсталосьСвойств);
	КонецЕсли;
	
	Если ОсталосьСвойств <> 0 Тогда
	
		Пока НЕ ЧтениеXML.ТипУзла = ТипУзлаXML.КонецЭлемента Цикл
			ЗначениеПоУмолчанию = Неопределено;
			Если ЭтоИсходникиEDT И ОписаниеОбъекта.Свойство(ЧтениеXML.Имя, ЗначениеПоУмолчанию) Тогда
				ПрочитатьСвойствоСтруктурыXML(ЧтениеXML, ОписаниеОбъекта, ОсталосьСвойств);
				Если ОсталосьСвойств = 0 Тогда
					Прервать;
				КонецЕсли;
			Иначе
				ЧтениеXML.Пропустить();
				ЧтениеXML.Прочитать();
			КонецЕсли;
		КонецЦикла;
		
	КонецЕсли;
	
	ЧтениеXML.Закрыть();
	
КонецПроцедуры

Процедура ПрочитатьСведенияОбъектаXML(ПолноеИмяФайла, Результат, ЭтоИсходникиEDT, ОписанияТипов)
	
	// TODO Поддержка расширения типа в расширениях
	
	Файл = Новый Файл(ПолноеИмяФайла);
	Если НЕ Файл.Существует() Тогда
		Возврат;
	КонецЕсли;
	
	ЧтениеXML = Новый ЧтениеXML;
	
	Попытка
		ЧтениеXML.ОткрытьФайл(ПолноеИмяФайла);
		
		ОписаниеРеквизитов = рк_РедакторКодаКлиентСервер.СвойствоСтруктуры(Результат.Данные, "properties", Новый Структура);
		ОписаниеРесурсов = рк_РедакторКодаКлиентСервер.СвойствоСтруктуры(Результат.Данные, "resources", Новый Структура);
		ОписаниеТабличныхЧастей = рк_РедакторКодаКлиентСервер.СвойствоСтруктуры(Результат.Данные, "tabulars", Новый Структура);
		ОписаниеПредопределенных = рк_РедакторКодаКлиентСервер.СвойствоСтруктуры(Результат.Данные, "predefined", Новый Структура);
		
		// Значения по умолчанию
		СлужебныеДанные = Новый Структура;
		СлужебныеДанные.Вставить("Name");
		СлужебныеДанные.Вставить("Hierarchical", Ложь);
		СлужебныеДанные.Вставить("HierarchyType");
		СлужебныеДанные.Вставить("Type", Новый Массив);
		СлужебныеДанные.Вставить("Owners", Новый Массив);
		СлужебныеДанные.Вставить("CodeLength", 0);
		СлужебныеДанные.Вставить("DescriptionLength", 0);
		СлужебныеДанные.Вставить("RegisterType");
		СлужебныеДанные.Вставить("InformationRegisterPeriodicity");
		СлужебныеДанные.Вставить("WriteMode");
		СлужебныеДанные.Вставить("Correspondence", Ложь);
		СлужебныеДанные.Вставить("ActionPeriod", Ложь);
		СлужебныеДанные.Вставить("BasePeriod", Ложь);
		СлужебныеДанные.Вставить("ActionPeriodUse", Ложь);
		СлужебныеДанные.Вставить("ChartOfAccounts");

		ЧтениеXML.Прочитать();
		
		Если ЭтоИсходникиEDT Тогда
			ЧтениеXML.Прочитать(); // mdclass:Объект
			
			ИменаГрупп = Новый Структура;
			ИменаГрупп.Вставить("Атрибуты", "attributes");
			ИменаГрупп.Вставить("Измерения", "dimensions");
			ИменаГрупп.Вставить("Ресурсы", "resources");
			ИменаГрупп.Вставить("ТЧ", "tabularSections");
		Иначе
			ЧтениеXML.Прочитать(); // MetaDataObject
			ЧтениеXML.Прочитать(); // Объект
			
			ИменаГрупп = Новый Структура;
			ИменаГрупп.Вставить("Атрибуты", "Attribute");
			ИменаГрупп.Вставить("Измерения", "Dimension");
			ИменаГрупп.Вставить("Ресурсы", "Resource");
			ИменаГрупп.Вставить("ТЧ", "TabularSection");
		КонецЕсли;
		
		ЧтениеXML.Пропустить(); // InternalInfo или producedTypes
		ЧтениеXML.Прочитать();
		
		Если НЕ ЭтоИсходникиEDT Тогда
			ПрочитатьСвойстваXML(ЧтениеXML, СлужебныеДанные);
		КонецЕсли;
		
		Пока НЕ ЧтениеXML.ТипУзла = ТипУзлаXML.КонецЭлемента Цикл
			ЗначениеПоУмолчанию = Неопределено;
			Если ЭтоИсходникиEDT И СлужебныеДанные.Свойство(ЧтениеXML.Имя, ЗначениеПоУмолчанию) Тогда
				ПрочитатьСвойствоСтруктурыXML(ЧтениеXML, СлужебныеДанные);
			ИначеЕсли ЭтоУзелXML(ЧтениеXML, ИменаГрупп.Атрибуты) Тогда
				ПрочитатьАтрибутыXML(ЧтениеXML, ОписаниеРеквизитов, ОписанияТипов, ИменаГрупп.Атрибуты)
			ИначеЕсли ЭтоУзелXML(ЧтениеXML, ИменаГрупп.Измерения) Тогда
				ПрочитатьАтрибутыXML(ЧтениеXML, ОписаниеРеквизитов, ОписанияТипов, ИменаГрупп.Измерения)
			ИначеЕсли ЭтоУзелXML(ЧтениеXML, ИменаГрупп.Ресурсы) Тогда
				ПрочитатьАтрибутыXML(ЧтениеXML, ОписаниеРесурсов, ОписанияТипов, ИменаГрупп.Ресурсы);
			ИначеЕсли ЭтоУзелXML(ЧтениеXML, ИменаГрупп.ТЧ) Тогда
				ПрочитатьТабличныеЧастиXML(ЧтениеXML, ОписаниеРеквизитов, ОписаниеТабличныхЧастей, ОписанияТипов, ИменаГрупп.ТЧ, ИменаГрупп.Атрибуты);
			ИначеЕсли ЧтениеXML.Имя = "ChildObjects" Тогда
				ЧтениеXML.Прочитать();
			ИначеЕсли ЭтоИсходникиEDT И ЭтоУзелXML(ЧтениеXML, "predefined") Тогда
				ПрочитатьПредопределенныеXML(ЧтениеXML, ОписаниеПредопределенных, "items", ОписанияТипов);
				ЧтениеXML.Прочитать();
			Иначе
				ЧтениеXML.Пропустить();
				ЧтениеXML.Прочитать();
			КонецЕсли;
		КонецЦикла;
		
		ЧтениеXML.Закрыть();
	Исключение
		Инфо = ИнформацияОбОшибке();
		Возврат;
	КонецПопытки;
	
	ЗаполнитьСтандартныеРеквизитыXML(ОписаниеРеквизитов, СлужебныеДанные, ОписанияТипов, Результат.ИмяКоллекцииРедактора);
	
	Если ОписанияТипов.ИмяКоллекцииМетаданных = "РегистрыСведений" Тогда
		
		Если СлужебныеДанные.InformationRegisterPeriodicity = "Nonperiodical" Тогда
			ТипРегистра = "nonperiodical";
		Иначе
			ТипРегистра = "periodical";
		КонецЕсли;
		Результат.Данные.Вставить("type", ТипРегистра);
		
	ИначеЕсли ОписанияТипов.ИмяКоллекцииМетаданных = "РегистрыНакопления" Тогда
		
		Если СлужебныеДанные.RegisterType = "Turnovers" Тогда
			ТипРегистра = "turnovers";
		Иначе
			ТипРегистра = "balance";
		КонецЕсли;
		Результат.Данные.Вставить("type", ТипРегистра);
	КонецЕсли;
	
	Если ОписаниеРеквизитов.Количество() > 0 Тогда
		Результат.Данные.Вставить("properties", ОписаниеРеквизитов);
	КонецЕсли;
	Если ОписаниеРесурсов.Количество() > 0 Тогда
		Результат.Данные.Вставить("resources", ОписаниеРесурсов);
	КонецЕсли;
	Если ОписаниеТабличныхЧастей.Количество() > 0 Тогда
		Результат.Данные.Вставить("tabulars", ОписаниеТабличныхЧастей);
	КонецЕсли;
	Если ОписаниеПредопределенных.Количество() > 0 Тогда
		Результат.Данные.Вставить("predefined", ОписаниеПредопределенных);
	КонецЕсли;
	
	Результат.ИмяОбъектаМетаданных = СлужебныеДанные.Name;
	
КонецПроцедуры

Функция ПрочитатьОписанияВсехОбщихРеквизитовXML(НастройкиКонфигурации)
	
	ОбщиеРеквизитыОбъектов = Новый Структура;
	
	Если НЕ НастройкиКонфигурации.ВнешниеМетаданные Тогда
		Возврат ОбщиеРеквизитыОбъектов;
	КонецЕсли;
	
	Если НастройкиКонфигурации.ЭтоИсходникиEDT Тогда
		НайденныеФайлы = НайтиФайлы(СтрШаблон("%2src%1CommonAttributes", ПолучитьРазделительПути(), НастройкиКонфигурации.ПутьКИсходникамКонфигурации), "*.mdo", Истина);
	Иначе
		НайденныеФайлы = НайтиФайлы(СтрШаблон("%1CommonAttributes", НастройкиКонфигурации.ПутьКИсходникамКонфигурации), "*.xml", Ложь);
	КонецЕсли;
	
	Для Каждого НайденныйФайл Из НайденныеФайлы Цикл
		Попытка
			ЧтениеXML = Новый ЧтениеXML;
			ЧтениеXML.ОткрытьФайл(НайденныйФайл.ПолноеИмя);
			
			Если НастройкиКонфигурации.ЭтоИсходникиEDT Тогда
				ЧтениеXML.Прочитать();
				ЧтениеXML.Прочитать(); // mdclass:Объект
				
				ИмяУзлаСостава = "content";
			Иначе
				ЧтениеXML.Прочитать(); // MetaDataObject
				ЧтениеXML.Прочитать(); // Объект
				ЧтениеXML.Прочитать(); // CommonAttribute
				ЧтениеXML.Прочитать(); // Properties
				
				ИмяУзлаСостава = "Content";
			КонецЕсли;
			
			ОбъектИспользование = Неопределено;
			
			ОписаниеЭлемента = Новый Структура("Name,Synonym,Type");
			ОписаниеЭлемента.Вставить("AutoUse", "Use");
			ОсталосьСвойств = ОписаниеЭлемента.Количество();
			СоставРеквизита = Новый Соответствие;
			
			Пока НЕ ЧтениеXML.ТипУзла = ТипУзлаXML.КонецЭлемента Цикл
				Если ЭтоУзелXML(ЧтениеXML, ИмяУзлаСостава) Тогда
					Если НастройкиКонфигурации.ЭтоИсходникиEDT Тогда
						Пока ЭтоУзелXML(ЧтениеXML, ИмяУзлаСостава) Цикл
							ЧтениеXML.Прочитать();
							
							ЭлементМетаданные = ПрочитатьЗначениеXML(ЧтениеXML);
							ЭлементИспользование = ПрочитатьЗначениеXML(ЧтениеXML);
							СоставРеквизита.Вставить(ЭлементМетаданные, ЭлементИспользование = "Use");
							
							ЧтениеXML.Прочитать();
						КонецЦикла;
					Иначе
						ЧтениеXML.Прочитать();
						Пока НЕ ЧтениеXML.ТипУзла = ТипУзлаXML.КонецЭлемента Цикл
							ЧтениеXML.Прочитать();
							
							ЭлементМетаданные = ПрочитатьЗначениеXML(ЧтениеXML);
							ЭлементИспользование = ПрочитатьЗначениеXML(ЧтениеXML);
							СоставРеквизита.Вставить(ЭлементМетаданные, ЭлементИспользование = "Use");
							
							ЧтениеXML.Пропустить(); // ConditionalSeparation
							ЧтениеXML.Прочитать();
							ЧтениеXML.Прочитать();
						КонецЦикла;
						ЧтениеXML.Прочитать();
					КонецЕсли;
				Иначе
					ПрочитатьСвойствоСтруктурыXML(ЧтениеXML, ОписаниеЭлемента, ОсталосьСвойств);
					Если ОсталосьСвойств = 0 Тогда
						Прервать;
					КонецЕсли;
				КонецЕсли;
			КонецЦикла;
			
			ОписаниеРеквизита = Новый Структура;
			ОписаниеРеквизита.Вставить("Состав", Новый Соответствие);
			ОписаниеРеквизита.Вставить("АвтоИспользование", ОписаниеЭлемента.AutoUse = "Use");
			ОписаниеРеквизита.Вставить("Синоним", ОписаниеЭлемента.Synonym);
			ОписаниеРеквизита.Вставить("Тип", ОписаниеЭлемента.Type);
			
			Для Каждого КлючИЗначение Из СоставРеквизита Цикл
				Если ОписаниеРеквизита.АвтоИспользование <> КлючИЗначение.Значение Тогда
					ОписаниеРеквизита.Состав.Вставить(КлючИЗначение.Ключ, КлючИЗначение.Значение);
				КонецЕсли;
			КонецЦикла;
			
			ОбщиеРеквизитыОбъектов.Вставить(ОписаниеЭлемента.Name, ОписаниеРеквизита);
		Исключение
			Инфо = ИнформацияОбОшибке();
		КонецПопытки;
	КонецЦикла;
	
	Возврат ОбщиеРеквизитыОбъектов;
	
КонецФункции

Процедура ЗаполнитьОбщиеРеквизитыXML(ВсеОбщиеРеквизиты, Результат, ОписанияТипов)
	
	ОписаниеСвойств = рк_РедакторКодаКлиентСервер.СвойствоСтруктуры(Результат.Данные, "properties", Новый Структура);
	
	ПолноеИмяОбъекта = СтрШаблон("%1.%2", МаппингЕдEng(ОписанияТипов.ИмяКоллекцииМетаданных, ОписанияТипов.Маппинг), Результат.ИмяОбъектаМетаданных);
	Для Каждого КлючИЗначение Из ВсеОбщиеРеквизиты Цикл
		ОписаниеРеквизита = КлючИЗначение.Значение;
		ИспользованиеОбъекта = ОписаниеРеквизита.Состав[ПолноеИмяОбъекта];
		
		Если (ОписаниеРеквизита.АвтоИспользование И ИспользованиеОбъекта <> Ложь)
		 ИЛИ (НЕ ОписаниеРеквизита.АвтоИспользование И ИспользованиеОбъекта <> Истина) Тогда
			ДобавитьРеквизитXML(ОписаниеСвойств, ОписанияТипов, КлючИЗначение.Ключ, ОписаниеРеквизита.Синоним, ОписаниеРеквизита.Тип);
		КонецЕсли;
	КонецЦикла;
	
	Результат.Данные.Вставить("properties", ОписаниеСвойств);
	
КонецПроцедуры

Процедура ПрочитатьОписаниеПредопределенныхXML(ПолноеИмяФайла, Результат, ИмяКоллекции, Маппинг)
	
	Файл = Новый Файл(ПолноеИмяФайла);
	Если НЕ Файл.Существует() Тогда
		Возврат;
	КонецЕсли;
	
	ОписаниеПредопределенных = рк_РедакторКодаКлиентСервер.СвойствоСтруктуры(Результат.Данные, "predefined", Новый Структура);
	
	ЧтениеXML = Новый ЧтениеXML;
	
	Попытка
		ЧтениеXML.ОткрытьФайл(ПолноеИмяФайла);
		ЧтениеXML.Прочитать();
		
		ПрочитатьПредопределенныеXML(ЧтениеXML, ОписаниеПредопределенных, "Item", МаппингМнRus(ИмяКоллекции, Маппинг));
		
		ЧтениеXML.Закрыть();
	Исключение
		Возврат;
	КонецПопытки;
	
	Результат.Данные.Вставить("predefined", ОписаниеПредопределенных);
	
КонецПроцедуры

Процедура ПрочитатьСвойстваXML(ЧтениеXML, ОписаниеЭлемента, ОсталосьСвойств = Неопределено)
	
	Если ЭтоУзелXML(ЧтениеXML, "Properties") Тогда
		ЧтениеXML.Прочитать();
	КонецЕсли;
	
	Если ОсталосьСвойств = Неопределено Тогда
		Пока ЧтениеXML.ТипУзла <> ТипУзлаXML.КонецЭлемента Цикл
			ПрочитатьСвойствоСтруктурыXML(ЧтениеXML, ОписаниеЭлемента);
		КонецЦикла;
	Иначе
		Пока ЧтениеXML.ТипУзла <> ТипУзлаXML.КонецЭлемента Цикл
			Если ОсталосьСвойств = 0 Тогда
				Возврат;
			КонецЕсли;
			ПрочитатьСвойствоСтруктурыXML(ЧтениеXML, ОписаниеЭлемента, ОсталосьСвойств);
		КонецЦикла;
	КонецЕсли;
	
	Если ЭтоКонецУзлаXML(ЧтениеXML, "Properties") Тогда
		ЧтениеXML.Прочитать();
	КонецЕсли;
	
КонецПроцедуры

Процедура ПрочитатьПредопределенныеXML(ЧтениеXML, СтруктураПредопределенных, ИмяГруппы, ОписанияТипов)
	
	ЧтениеXML.Прочитать(); // PredefinedData или predefined
	
	Пока ЭтоУзелXML(ЧтениеXML, ИмяГруппы) Цикл
		ЧтениеXML.Прочитать();
		
		ОписаниеЭлемента = Новый Структура("IsFolder,Name,Code", Ложь);
		ПрочитатьСвойстваXML(ЧтениеXML, ОписаниеЭлемента);
		Если НЕ ОписаниеЭлемента.IsFolder Тогда
			Если ОписанияТипов.ИмяКоллекцииМетаданных = "ПланыСчетов" Тогда
				СтруктураПредопределенных.Вставить(ОписаниеЭлемента.Name, СтрШаблон("%1 (%2)", ОписаниеЭлемента.Name, ОписаниеЭлемента.Code));
			Иначе
				СтруктураПредопределенных.Вставить(ОписаниеЭлемента.Name, "");
			КонецЕсли;
		КонецЕсли;
		
		ЧтениеXML.Прочитать();
	КонецЦикла;
	
КонецПроцедуры

Процедура ПрочитатьАтрибутыXML(ЧтениеXML, СтруктураРеквизитов, ОписанияТипов, ИмяГруппы)
	
	Пока ЭтоУзелXML(ЧтениеXML, ИмяГруппы) Цикл
		ЧтениеXML.Прочитать();
		
		ОписаниеЭлемента = Новый Структура("Name,Synonym,Type");
		ПрочитатьСвойстваXML(ЧтениеXML, ОписаниеЭлемента);
		ДобавитьРеквизитXML(СтруктураРеквизитов, ОписанияТипов, ОписаниеЭлемента.Name, ОписаниеЭлемента.Synonym, ОписаниеЭлемента.Type);
		
		ЧтениеXML.Прочитать();
	КонецЦикла;
	
КонецПроцедуры

Процедура ПрочитатьТабличныеЧастиXML(ЧтениеXML, СтруктураРеквизитов, СтруктураТЧ, ОписанияТипов, ИмяГруппыТЧ, ИмяГруппыАтрибуты)
	
	Пока ЭтоУзелXML(ЧтениеXML, ИмяГруппыТЧ) Цикл
		ЧтениеXML.Прочитать();
		
		ЧтениеXML.Пропустить(); // InternalInfo или producedTypes
		ЧтениеXML.Прочитать();
		
		ОписаниеТЧ = Новый Структура("Name,Synonym");
		ОписаниеРеквизитовТЧ = Неопределено;
		Пока НЕ ЭтоКонецУзлаXML(ЧтениеXML, ИмяГруппыТЧ) Цикл
			Если ЭтоУзелXML(ЧтениеXML, ИмяГруппыАтрибуты) Тогда
				ДобавитьРеквизитXML(СтруктураРеквизитов, ОписанияТипов, ОписаниеТЧ.Name, "ТЧ: " + ОписаниеТЧ.Synonym, Неопределено);
				
				ОписаниеРеквизитовТЧ = Новый Структура;
				ПрочитатьАтрибутыXML(ЧтениеXML, ОписаниеРеквизитовТЧ, ОписанияТипов, ИмяГруппыАтрибуты);
				СтруктураТЧ.Вставить(ОписаниеТЧ.Name, Новый Структура("properties", ОписаниеРеквизитовТЧ));
				
				ОписаниеТЧ = Новый Структура("Name,Synonym");
				
			ИначеЕсли ЧтениеXML.Имя = "Properties" Тогда
				ЧтениеXML.Прочитать();
			ИначеЕсли ЧтениеXML.Имя = "ChildObjects" Тогда
				ЧтениеXML.Прочитать();
			Иначе
				ПрочитатьСвойствоСтруктурыXML(ЧтениеXML, ОписаниеТЧ);
			КонецЕсли;
		КонецЦикла;
		ЧтениеXML.Прочитать();
	КонецЦикла;
	
КонецПроцедуры

Процедура ДобавитьРеквизитXML(СтруктураРеквизитов, ОписанияТипов, ИмяРеквизита, СинонимРеквизита, ТипыРеквизита)
	
	ОписаниеТипаРеквизита = "";
	
	Если ТипЗнч(ТипыРеквизита) = Тип("Строка") Тогда
		// Явно заданный готовый тип
		ОписаниеТипаРеквизита = ТипыРеквизита;
		
	ИначеЕсли ТипыРеквизита <> Неопределено Тогда
		// Прочитанный из XML массив типов
		МассивТипов = Новый Массив;
		Для Каждого ТипСвойства Из ТипыРеквизита Цикл
			
			ОбработанныйТип = ОписанияТипов.Типы[ТипСвойства];
			Если ОбработанныйТип <> Неопределено Тогда
				МассивТипов.Добавить(ОбработанныйТип);
				Продолжить;
			КонецЕсли;
			
			ПозТочки = СтрНайти(ТипСвойства, ".");
			Если ПозТочки > 0 Тогда
				Имя = Сред(ТипСвойства, ПозТочки + 1);
				КорневойТип = Лев(ТипСвойства, ПозТочки - 1);
				Если СтрНачинаетсяС(КорневойТип, "cfg:") Тогда
					КорневойТип = Сред(КорневойТип, 5);
				КонецЕсли; 
				Если СтрЗаканчиваетсяНа(КорневойТип, "Ref") Тогда
					КорневойТип = Лев(КорневойТип, СтрДлина(КорневойТип) - 3);
				КонецЕсли; 
				ИмяДляРедактораEд = МаппингConsole(КорневойТип, ОписанияТипов.Маппинг);
				Если ИмяДляРедактораEд <> Неопределено Тогда
					ОбработанныйТип = ИмяДляРедактораEд + "." + Имя;
					МассивТипов.Добавить(ОбработанныйТип);
					ОписанияТипов.Типы[ТипСвойства] = ОбработанныйТип;
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
		Если МассивТипов.Количество() > 0 Тогда
			ОписаниеТипаРеквизита = СтрСоединить(МассивТипов, ",");
		КонецЕсли;
	КонецЕсли;
	
	ОписаниеРеквизита = Новый Структура("name", СинонимРеквизита);
	
	Если НЕ ПустаяСтрока(ОписаниеТипаРеквизита) Тогда
		ОписаниеРеквизита.Вставить("ref", ОписаниеТипаРеквизита);
	КонецЕсли;
	
	СтруктураРеквизитов.Вставить(ИмяРеквизита, ОписаниеРеквизита);
	
КонецПроцедуры

Процедура ЗаполнитьСтандартныеРеквизитыXML(СтруктураРеквизитов, СлужебныеДанные, ОписанияТипов, ИмяКоллекцииРедактора)
	
	СсылкаНаОбъект = ИмяКоллекцииРедактора + "." + СлужебныеДанные.Name;
	
	Если СлужебныеДанные.CodeLength > 0 Тогда
		ДобавитьРеквизитXML(СтруктураРеквизитов, ОписанияТипов, "Код", "", Неопределено);
	КонецЕсли;
	
	Если СлужебныеДанные.DescriptionLength > 0 Тогда
		ДобавитьРеквизитXML(СтруктураРеквизитов, ОписанияТипов, "Наименование", "", Неопределено);
	КонецЕсли;
	
	Если СлужебныеДанные.Owners.Количество() > 0 Тогда
		ДобавитьРеквизитXML(СтруктураРеквизитов, ОписанияТипов, "Владелец", "", СлужебныеДанные.Owners);
	КонецЕсли;
	
	Если СлужебныеДанные.Hierarchical Тогда
		Если СлужебныеДанные.HierarchyType <> "HierarchyOfItems" Тогда
			ДобавитьРеквизитXML(СтруктураРеквизитов, ОписанияТипов, "ЭтоГруппа", "", Неопределено);
		КонецЕсли;
		ДобавитьРеквизитXML(СтруктураРеквизитов, ОписанияТипов, "Родитель", "", СсылкаНаОбъект);
	КонецЕсли;
	
	Если ОписанияТипов.ИмяКоллекцииМетаданных = "Документы" Тогда
		ДобавитьРеквизитXML(СтруктураРеквизитов, ОписанияТипов, "Ссылка", "", СсылкаНаОбъект);
		ДобавитьРеквизитXML(СтруктураРеквизитов, ОписанияТипов, "Проведен", "", Неопределено);
		ДобавитьРеквизитXML(СтруктураРеквизитов, ОписанияТипов, "ПометкаУдаления", "", Неопределено);
		ДобавитьРеквизитXML(СтруктураРеквизитов, ОписанияТипов, "Дата", "", Неопределено);
		
	ИначеЕсли ОписанияТипов.ИмяКоллекцииМетаданных = "Справочники" Тогда
		ДобавитьРеквизитXML(СтруктураРеквизитов, ОписанияТипов, "Ссылка", "", СсылкаНаОбъект);
		ДобавитьРеквизитXML(СтруктураРеквизитов, ОписанияТипов, "ПометкаУдаления", "", Неопределено);
		ДобавитьРеквизитXML(СтруктураРеквизитов, ОписанияТипов, "Предопределенный", "", Неопределено);
		
