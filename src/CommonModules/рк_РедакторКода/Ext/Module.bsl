#Область Модуль_КД3_РедакторКода

Процедура КД3_ОбработчикПриСозданииНаСервере(Форма) Экспорт
	
	КонтекстФормы = КД3_ОпределитьКонтекстФормы(Форма);
	
	Если КонтекстФормы.ИмяКонтекста = Неопределено Тогда
		ОбщегоНазначения.СообщитьПользователю("КД3: Форма не поддерживается. Имя формы: " + Форма.ИмяФормы);
		Возврат;
	КонецЕсли;
	
	Если КонтекстФормы.Обработчики.Количество() = 0 Тогда
		Возврат; // Для текущих настроек формы редакторы не доступны
	КонецЕсли;
	
	// Получение данных конфигураций
	
	КД3_ЗаполнитьДоступныеКонфигурации(Форма, КонтекстФормы);
	
	// Обработка параметров инициализации
	
	НовыеРедакторы = Новый Массив;
	НовыеРеквизиты = Новый Массив;
	НастройкиКонфигураций = Новый Соответствие;
	
	Для Каждого КлючИЗначение Из рк_РедакторКодаКлиентСервер.ИменаСлужебныхРеквизитов() Цикл
		НовыеРеквизиты.Добавить(Новый РеквизитФормы(КлючИЗначение.Значение.Имя, КлючИЗначение.Значение.Тип));
	КонецЦикла;
	
	КонтекстФормы.Вставить("ЕстьКорреспондент", Ложь);
	
	Для Каждого ЭлементСписка Из КонтекстФормы.Обработчики Цикл
		
		ДляКорреспондента = ЭлементСписка.Пометка;
		ЭлементТекст = ЭлементСписка.Значение;
		ИмяЭлементаHTML = ?(ПустаяСтрока(ЭлементСписка.Представление), "КД3_" + ЭлементТекст.Имя, ЭлементСписка.Представление);
		
		ПараметрыИнициализации = НовыеПараметрыИнициализации(ЭлементТекст,,ИмяЭлементаHTML);
		ПараметрыИнициализации.РежимЯзыка = КонтекстФормы.РежимЯзыка;
		
		Если ТипЗнч(ЭлементТекст.Родитель) <> Тип("ФормаКлиентскогоПриложения") Тогда
			ПараметрыИнициализации.ЭлементСтраница = ЭлементТекст.Родитель;
		КонецЕсли;
		
		Если ДляКорреспондента Тогда
			КонтекстФормы.ЕстьКорреспондент = Истина;
			ПараметрыИнициализации.Конфигурация = КонтекстФормы.КонфигурацияКорреспондент;
		Иначе
			ПараметрыИнициализации.Конфигурация = КонтекстФормы.Конфигурация;
		КонецЕсли;
		
		ПараметрыИнициализации.Параметры.Вставить("КД3_ДляКорреспондента", ДляКорреспондента);
		
		НовыеРедакторы.Добавить(ПараметрыИнициализации);
		
		НовыеРеквизиты.Добавить(Новый РеквизитФормы(ПараметрыИнициализации.РеквизитHTML, Новый ОписаниеТипов("Строка")));
	КонецЦикла;
	
	НастройкиКонфигураций[КонтекстФормы.Конфигурация] = КД3_НастройкиКонфигурации(КонтекстФормы.Конфигурация);
	Если КонтекстФормы.ЕстьКорреспондент Тогда
		НастройкиКонфигураций[КонтекстФормы.КонфигурацияКорреспондент] = КД3_НастройкиКонфигурации(КонтекстФормы.КонфигурацияКорреспондент);
	КонецЕсли;
	
	Попытка
		Форма.ИзменитьРеквизиты(НовыеРеквизиты, Новый Массив);
	Исключение
		Инфо = ИнформацияОбОшибке();
		Сообщить("КД3_ОбработчикПриСозданииНаСервере ИзменитьРеквизиты " + Символы.ПС + ПодробноеПредставлениеОшибки(Инфо));
		Возврат;
	КонецПопытки;
	
	Если КонтекстФормы.ИмяКонтекста = "Запросы" ИЛИ КонтекстФормы.ИмяКонтекста = "Алгоритмы" И НЕ КонтекстФормы.ЭтоКонвертацияXDTO Тогда
		
		// Для запросов и конвертации XML алгоритмов создается 2 страницы на один и тот же реквизит Текст для ускорения обработки флага "Используется при загрузке"
		
		ЭлементСтраницы = Форма.Элементы.Добавить("КД3_СтраницыОбработчики", Тип("ГруппаФормы"), НовыеРедакторы[0].ЭлементТекст.Родитель);
		ЭлементСтраницы.Вид = ВидГруппыФормы.Страницы;
		ЭлементСтраницы.УстановитьДействие("ПриСменеСтраницы", "Подключаемый_КД3_СтраницыОбработчикиПриСменеСтраницы");
		ЭлементСтраницы.ОтображениеСтраниц = ОтображениеСтраницФормы.Нет;
		
		Для Каждого ПараметрыИнициализации Из НовыеРедакторы Цикл
			ИмяЭлементаHTML = ПараметрыИнициализации.РеквизитHTML;
			
			ЭлементСтраница = Форма.Элементы.Добавить(ИмяЭлементаHTML + "Страница", Тип("ГруппаФормы"), ЭлементСтраницы);
			ЭлементСтраница.Вид = ВидГруппыФормы.Страница;
			
			ПараметрыИнициализации.ЭлементСтраница = ЭлементСтраница;
			
			Если Форма.Объект.ИспользуетсяПриЗагрузке = ПараметрыИнициализации.Параметры.КД3_ДляКорреспондента Тогда
				ЭлементСтраницы.ТекущаяСтраница = ЭлементСтраница;
			КонецЕсли;
		КонецЦикла;
		
	КонецЕсли;

	ОбщиеПараметры = рк_РедакторКодаКлиентСервер.ОбщиеПараметры(Форма);
	ОбщиеПараметры.Вставить("КД3_ИмяКонтекста", КонтекстФормы.ИмяКонтекста);
	ОбщиеПараметры.Вставить("КД3_ЭтоКонвертацияXDTO", КонтекстФормы.ЭтоКонвертацияXDTO);
	
	ОбработчикПриСозданииНаСервере(Форма, НовыеРедакторы, НастройкиКонфигураций);
	
	КД3_ЗаполнитьЛокальныйКонтекст(Форма, КонтекстФормы);
	
КонецПроцедуры

Функция КД3_НастройкиКонфигурации(Релиз) Экспорт
	
	ОщиеНастройки = НастройкиКонфигурации();
	
	Если НЕ ЗначениеЗаполнено(Релиз) Тогда
		Возврат ОщиеНастройки; // Настройки текущей конфигурации
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Релизы.ИсточникДанных КАК ИсточникДанных,
	|	Релизы.КаталогЗагрузки КАК КаталогЗагрузки,
	|	Релизы.Расширения.(
	|		ИмяКаталогаЗагрузки КАК ИмяКаталогаЗагрузки
	|	) КАК Расширения
	|ИЗ
	|	Справочник.Релизы КАК Релизы
	|ГДЕ
	|	Релизы.Ссылка = &Релиз";
	
	Запрос.УстановитьПараметр("Релиз", Релиз);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Выборка.Следующий();
	
	Настройки = НовыеНастройкиКонфигурации();
	
	Настройки.ОбработчикМодулей = ОщиеНастройки.ОбработчикМодулей; // Обработчик модулей общий для всех конфигураций
	Настройки.ВнешниеМетаданные = Истина;
	Настройки.ЭтоИсходникиEDT = Выборка.ИсточникДанных <> 0;
	Настройки.ПутьКИсходникамКонфигурации = рк_РедакторКодаКлиентСервер.НормализоватьПутьФайла(Выборка.КаталогЗагрузки);
	
	Если НЕ Настройки.ЭтоИсходникиEDT Тогда
		ВыборкаРасширения = Выборка.Расширения.Выбрать();
		Пока ВыборкаРасширения.Следующий() Цикл
			Настройки.ПутьКИсходникамРасширений.Добавить(рк_РедакторКодаКлиентСервер.НормализоватьПутьФайла(ВыборкаРасширения.ИмяКаталогаЗагрузки));
		КонецЦикла;
	КонецЕсли;
	
	Возврат Настройки;
	
КонецФункции

Функция КД3_ОпределитьКонтекстФормы(Форма)
	
	Обработчики = Новый СписокЗначений; // Значение - ЭлементТекст, Пометка - для корреспондента, Представление [Не обязательно] - имя элемента HTML
	ФормаЭлементы = Форма.Элементы;
	ИмяФормы = Форма.ИмяФормы;
	
	КонтекстФормы = Новый Структура;
	КонтекстФормы.Вставить("ИмяКонтекста");
	КонтекстФормы.Вставить("ЭтоКонвертацияXDTO");
	КонтекстФормы.Вставить("Обработчики", Обработчики);
	КонтекстФормы.Вставить("РежимЯзыка", "bsl");
	
	Если ИмяФормы = "Справочник.Конвертации.Форма.ФормаЭлемента" Тогда
		
		КонтекстФормы.ИмяКонтекста = "Конвертации";
		КонтекстФормы.ЭтоКонвертацияXDTO = Форма.КонвертацияXDTO;
		
		Если КонтекстФормы.ЭтоКонвертацияXDTO Тогда
			Обработчики.Добавить(ФормаЭлементы.АлгоритмПередКонвертацией);
			Обработчики.Добавить(ФормаЭлементы.АлгоритмПередОтложеннымЗаполнением);
			Обработчики.Добавить(ФормаЭлементы.АлгоритмПередОбработкойУдаления);
			Обработчики.Добавить(ФормаЭлементы.АлгоритмПослеКонвертации);
		Иначе
			Обработчики.Добавить(ФормаЭлементы.АлгоритмПослеЗагрузкиПравилОбмена);
			Обработчики.Добавить(ФормаЭлементы.АлгоритмПередВыгрузкойДанных);
			Обработчики.Добавить(ФормаЭлементы.АлгоритмПередПолучениемИзмененныхОбъектов);
			Обработчики.Добавить(ФормаЭлементы.АлгоритмПередВыгрузкойОбъекта);
			Обработчики.Добавить(ФормаЭлементы.АлгоритмПередОтправкойИнформацииОбУдалении);
			Обработчики.Добавить(ФормаЭлементы.АлгоритмПередКонвертациейОбъекта);
			Обработчики.Добавить(ФормаЭлементы.АлгоритмПослеВыгрузкиОбъекта);
			Обработчики.Добавить(ФормаЭлементы.АлгоритмПослеВыгрузкиДанных);
			Обработчики.Добавить(ФормаЭлементы.АлгоритмПередЗагрузкойДанных,, Истина);
			Обработчики.Добавить(ФормаЭлементы.АлгоритмПослеЗагрузкиПараметров,, Истина);
			Обработчики.Добавить(ФормаЭлементы.АлгоритмПослеПолученияИнформацииОбУзлахОбмена,, Истина);
			Обработчики.Добавить(ФормаЭлементы.АлгоритмПередЗагрузкойОбъекта,, Истина);
			Обработчики.Добавить(ФормаЭлементы.АлгоритмПриПолученииИнформацииОбУдалении,, Истина);
			Обработчики.Добавить(ФормаЭлементы.АлгоритмПослеЗагрузкиОбъекта,, Истина);
			Обработчики.Добавить(ФормаЭлементы.АлгоритмПослеЗагрузкиДанных,, Истина);
		КонецЕсли;
		
	ИначеЕсли ИмяФормы = "Справочник.ПравилаКонвертацииОбъектов.Форма.ФормаЭлемента" Тогда
		
		КонтекстФормы.ИмяКонтекста = "ПКО";
		КонтекстФормы.ЭтоКонвертацияXDTO = Форма.ЭтоКонвертацияXDTO;
		
		Если КонтекстФормы.ЭтоКонвертацияXDTO Тогда
			КД3_ВидимостьПакетныеСтраницы =
					Форма.ОтборСобытийПоМоделиXDTO = Перечисления.ВариантыМоделейОбмена.ПакетнаяМодель
				ИЛИ Форма.ОтборСобытийПоМоделиXDTO = Перечисления.ВариантыМоделейОбмена.КомбинированнаяМодель;
			
			Если КД3_ВидимостьПакетныеСтраницы Тогда
				Если Форма.Объект.ИспользоватьДляОтправки Тогда
					Обработчики.Добавить(ФормаЭлементы.АлгоритмПакетноеСобытиеПриОтправкеДанных);
				КонецЕсли;
				Если Форма.Объект.ИспользоватьДляПолучения Тогда
					Обработчики.Добавить(ФормаЭлементы.АлгоритмПакетноеСобытиеПриПолученииЗапросаВыгрузкиОбъекта);
					Обработчики.Добавить(ФормаЭлементы.АлгоритмПакетноеСобытиеПередПолучениемДанных);
					Обработчики.Добавить(ФормаЭлементы.АлгоритмПакетноеСобытиеПриПолученииДанных);
				КонецЕсли;
				//Обработчики.Добавить(Форма.Элементы.АлгоритмПакетноеСобытиеПослеЗагрузкиВсехДанных, );
			КонецЕсли;
			
			КД3_ВидимостьОбъектныеСтраницы =
					Форма.ОтборСобытийПоМоделиXDTO = Перечисления.ВариантыМоделейОбмена.ОбъектнаяМодель
				ИЛИ Форма.ОтборСобытийПоМоделиXDTO = Перечисления.ВариантыМоделейОбмена.КомбинированнаяМодель;
			
			Если КД3_ВидимостьОбъектныеСтраницы Тогда
				Если Форма.Объект.ИспользоватьДляОтправки Тогда
					Обработчики.Добавить(ФормаЭлементы.АлгоритмОбъектноеСобытиеПриОтправкеДанных);
				КонецЕсли;
				Если Форма.Объект.ИспользоватьДляПолучения Тогда
					Обработчики.Добавить(ФормаЭлементы.АлгоритмОбъектноеСобытиеПриПолученииЗапросаВыгрузкиОбъекта);
					Обработчики.Добавить(ФормаЭлементы.АлгоритмОбъектноеСобытиеПриУдаленииОбъектаИБ);
					Обработчики.Добавить(ФормаЭлементы.АлгоритмОбъектноеСобытиеПередПолучениемДанных);
					Обработчики.Добавить(ФормаЭлементы.АлгоритмОбъектноеСобытиеПриПолученииДанных);
					Обработчики.Добавить(ФормаЭлементы.АлгоритмОбъектноеСобытиеПослеКонвертацииОбъекта);
				КонецЕсли;
			КонецЕсли;
		Иначе
			Обработчики.Добавить(ФормаЭлементы.АлгоритмПередВыгрузкойОбъекта);
			Обработчики.Добавить(ФормаЭлементы.АлгоритмПриВыгрузкеОбъекта);
			Обработчики.Добавить(ФормаЭлементы.АлгоритмПослеВыгрузкиОбъекта);
			Обработчики.Добавить(ФормаЭлементы.АлгоритмПослеВыгрузкиОбъектаВФайлОбмена);
			Обработчики.Добавить(ФормаЭлементы.АлгоритмПоследовательностьПолейПоиска,, Истина);
			Обработчики.Добавить(ФормаЭлементы.АлгоритмПередЗагрузкойОбъекта,, Истина);
			Обработчики.Добавить(ФормаЭлементы.АлгоритмПриЗагрузкеОбъекта,, Истина);
			Обработчики.Добавить(ФормаЭлементы.АлгоритмПослеЗагрузкиОбъекта,, Истина);
		КонецЕсли;
		
	ИначеЕсли ИмяФормы = "Справочник.ПравилаКонвертацииПредопределенныхДанных.Форма.ФормаЭлементаXML" Тогда
		
		КонтекстФормы.ИмяКонтекста = "ПКПД";
		КонтекстФормы.ЭтоКонвертацияXDTO = Ложь;
		
		Обработчики.Добавить(ФормаЭлементы.АлгоритмПередВыгрузкойОбъекта);
		Обработчики.Добавить(ФормаЭлементы.АлгоритмПриВыгрузкеОбъекта);
		Обработчики.Добавить(ФормаЭлементы.АлгоритмПослеВыгрузкиОбъекта);
		Обработчики.Добавить(ФормаЭлементы.АлгоритмПослеВыгрузкиОбъектаВФайлОбмена);
		Обработчики.Добавить(ФормаЭлементы.АлгоритмПередЗагрузкойОбъекта,, Истина);
		Обработчики.Добавить(ФормаЭлементы.АлгоритмПриЗагрузкеОбъекта,, Истина);
		Обработчики.Добавить(ФормаЭлементы.АлгоритмПослеЗагрузкиОбъекта,, Истина);
		
	ИначеЕсли ИмяФормы = "Справочник.ПравилаКонвертацииСвойств.Форма.ФормаЭлемента" Тогда
		
		КонтекстФормы.ИмяКонтекста = "ПКС";
		КонтекстФормы.ЭтоКонвертацияXDTO = Форма.ЭтоКонвертацияXDTO;
		
		Если НЕ КонтекстФормы.ЭтоКонвертацияXDTO Тогда
			Обработчики.Добавить(ФормаЭлементы.АлгоритмПередВыгрузкойСвойства);
			Обработчики.Добавить(ФормаЭлементы.АлгоритмПриВыгрузкеСвойства);
			Обработчики.Добавить(ФормаЭлементы.АлгоритмПослеВыгрузкиСвойства);
		КонецЕсли;
		
	ИначеЕсли ИмяФормы = "Справочник.ПравилаКонвертацииСвойств.Форма.ФормаГруппы" Тогда
		
		КонтекстФормы.ИмяКонтекста = "ПКГС";
		КонтекстФормы.ЭтоКонвертацияXDTO = Форма.ЭтоКонвертацияXDTO;
		
		Если НЕ КонтекстФормы.ЭтоКонвертацияXDTO Тогда
			Обработчики.Добавить(ФормаЭлементы.АлгоритмПередОбработкойВыгрузки);
			Обработчики.Добавить(ФормаЭлементы.АлгоритмПередВыгрузкойСвойства);
			Обработчики.Добавить(ФормаЭлементы.АлгоритмПриВыгрузкеСвойства);
			Обработчики.Добавить(ФормаЭлементы.АлгоритмПослеВыгрузкиСвойства);
			Обработчики.Добавить(ФормаЭлементы.АлгоритмПослеОбработкиВыгрузки);
		КонецЕсли;
		
	ИначеЕсли ИмяФормы = "Справочник.ПравилаОбработкиДанных.Форма.ФормаЭлемента" Тогда
		
		КонтекстФормы.ИмяКонтекста = "ПОД";
		КонтекстФормы.ЭтоКонвертацияXDTO = Форма.КонвертацияXDTO;
		
		Если КонтекстФормы.ЭтоКонвертацияXDTO Тогда
			Обработчики.Добавить(ФормаЭлементы.АлгоритмПриОбработке);
			Обработчики.Добавить(ФормаЭлементы.АлгоритмВыборкаДанных);
		Иначе
			Обработчики.Добавить(ФормаЭлементы.АлгоритмПередОбработкойПравила);
			Обработчики.Добавить(ФормаЭлементы.АлгоритмПередВыгрузкойОбъекта);
			Обработчики.Добавить(ФормаЭлементы.АлгоритмПослеВыгрузкиОбъекта);
			Обработчики.Добавить(ФормаЭлементы.АлгоритмПослеОбработкиПравила);
		КонецЕсли;
		
	ИначеЕсли ИмяФормы = "Справочник.ПравилаРегистрацииОбъектов.Форма.ФормаЭлемента" Тогда
		
		КонтекстФормы.ИмяКонтекста = "ПРО";
		КонтекстФормы.ЭтоКонвертацияXDTO = Ложь;
		
		Обработчики.Добавить(ФормаЭлементы.АлгоритмПередОбработкойПравила);
		Обработчики.Добавить(ФормаЭлементы.АлгоритмПриОбработкеПравила);
		Обработчики.Добавить(ФормаЭлементы.АлгоритмПриОбработкеДополнительныйПравила);
		Обработчики.Добавить(ФормаЭлементы.АлгоритмПослеОбработкиПравила);
		Если Форма.ЭтоСсылочныйТип Тогда
			Обработчики.Добавить(ФормаЭлементы.АлгоритмПакетнаяОбработкаРегистрации);
		КонецЕсли;
		
	ИначеЕсли ИмяФормы = "Справочник.Алгоритмы.Форма.ФормаЭлемента" Тогда
		
		КонтекстФормы.ИмяКонтекста = "Алгоритмы";
		КонтекстФормы.ЭтоКонвертацияXDTO = Форма.ЭтоКонвертацияXDTO;
		
		Обработчики.Добавить(ФормаЭлементы.Алгоритм, "КД3_ОбработчикПриВыгрузке");
		Если НЕ Форма.ЭтоКонвертацияXDTO Тогда
			// Для одного элемента Текст добавляются два обработчика для переключения флагом "Используется при загрузке"
			Обработчики.Добавить(ФормаЭлементы.Алгоритм, "КД3_ОбработчикПриЗагрузке", Истина);
		КонецЕсли;
		
	ИначеЕсли ИмяФормы = "Справочник.Запросы.Форма.ФормаЭлемента" Тогда
		
		КонтекстФормы.ИмяКонтекста = "Запросы";
		КонтекстФормы.ЭтоКонвертацияXDTO = Ложь;
		КонтекстФормы.РежимЯзыка = "bsl_query";
		
		// Для одного элемента Текст добавляются два обработчика для переключения флагом "Используется при загрузке"
		Обработчики.Добавить(ФормаЭлементы.ТекстЗапроса, "КД3_ОбработчикПриВыгрузке");
		Обработчики.Добавить(ФормаЭлементы.ТекстЗапроса, "КД3_ОбработчикПриЗагрузке", Истина);
		
	КонецЕсли;
	
	Возврат КонтекстФормы;
	
КонецФункции

Процедура КД3_ЗаполнитьДоступныеКонфигурации(Форма, КонтекстФормы)
	
	КонтекстФормы.Вставить("Конфигурация");
	КонтекстФормы.Вставить("Конфигурации");
	КонтекстФормы.Вставить("Конвертации");
	Если НЕ КонтекстФормы.ЭтоКонвертацияXDTO Тогда
		КонтекстФормы.Вставить("КонфигурацияКорреспондент");
		КонтекстФормы.Вставить("КонфигурацииКорреспондент");
	КонецЕсли;
	
	Если КонтекстФормы.ИмяКонтекста = "ПРО" Тогда
		КонтекстФормы.Конфигурация = Форма.Конфигурация;
		
	ИначеЕсли КонтекстФормы.ИмяКонтекста = "Конвертации" Тогда
		КонтекстФормы.Конфигурация = Форма.Объект.Конфигурация;
		Если НЕ КонтекстФормы.ЭтоКонвертацияXDTO Тогда
			КонтекстФормы.КонфигурацияКорреспондент = Форма.Объект.КонфигурацияКорреспондент;
		КонецЕсли;
		КонтекстФормы.Конвертации = Новый Массив;
		КонтекстФормы.Конвертации.Добавить(Форма.Объект.Ссылка);
	Иначе
		ДанныеОбъекта = Новый Структура("ОбъектКонфигурации,ОбъектКонфигурацииКорреспондент");
		
		Если КонтекстФормы.ИмяКонтекста = "ПКС" Тогда
			СписокКонвертаций = Новый СписокЗначений;
			КонвертацияДанныхXDTOВызовСервера.ПолучитьВхожденияВКонвертацииДляЭлементаКонвертации(Форма.Объект.Владелец, СписокКонвертаций);
			
			ЗаполнитьЗначенияСвойств(ДанныеОбъекта, Форма);
			
		ИначеЕсли КонтекстФормы.ИмяКонтекста = "ПКГС" Тогда
			СписокКонвертаций = Новый СписокЗначений;
			КонвертацияДанныхXDTOВызовСервера.ПолучитьВхожденияВКонвертацииДляЭлементаКонвертации(Форма.Объект.Владелец, СписокКонвертаций);
			
			ЗаполнитьЗначенияСвойств(ДанныеОбъекта, ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Форма.Объект.Владелец, "ОбъектКонфигурации,ОбъектКонфигурацииКорреспондент"));
		Иначе
			СписокКонвертаций = Форма.СписокКонвертаций;
			
			Если КонтекстФормы.ИмяКонтекста = "ПКО" ИЛИ КонтекстФормы.ИмяКонтекста = "ПКПД" Тогда
				ЗаполнитьЗначенияСвойств(ДанныеОбъекта, Форма.Объект);
				
				// Список конфигураций уже есть на форме и получать его дополнительно не надо
				Если Форма.СписокКонфигураций.Количество() > 0 Тогда
					КонтекстФормы.Конфигурации = Форма.СписокКонфигураций.ВыгрузитьЗначения();
				КонецЕсли;
				Если НЕ КонтекстФормы.ЭтоКонвертацияXDTO И Форма.СписокКонфигурацийКорреспондент.Количество() > 0 Тогда
					КонтекстФормы.КонфигурацииКорреспондент = Форма.СписокКонфигурацийКорреспондент.ВыгрузитьЗначения();
				КонецЕсли;
				
			ИначеЕсли КонтекстФормы.ИмяКонтекста = "ПОД" Тогда
				ДанныеОбъекта.ОбъектКонфигурации = Форма.Объект.ОбъектВыборки;
			КонецЕсли;
		КонецЕсли;
		
		КонтекстФормы.Конвертации = СписокКонвертаций.ВыгрузитьЗначения();
		
		Если КонтекстФормы.Конфигурации = Неопределено Тогда
			КонтекстФормы.Конфигурации = КонвертацияДанныхXDTOВызовСервера.ПолучитьКонфигурацииДляКонвертаций(СписокКонвертаций);
		КонецЕсли;
		
		Если НЕ КонтекстФормы.ЭтоКонвертацияXDTO И КонтекстФормы.КонфигурацииКорреспондент = Неопределено Тогда
			КонтекстФормы.КонфигурацииКорреспондент = КонвертацияДанныхXDTOВызовСервера.ПолучитьКонфигурацииДляКонвертаций(СписокКонвертаций, "КонфигурацияКорреспондент");
		КонецЕсли;
		
		// Если есть выбор конкретного объекта конфигурации, то определяем текущую конфигурацию по нему
		Если ЗначениеЗаполнено(ДанныеОбъекта.ОбъектКонфигурации) Тогда
			Конфигурация = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ДанныеОбъекта.ОбъектКонфигурации, "Владелец");
			Если КонтекстФормы.Конфигурации.Найти(Конфигурация) <> Неопределено Тогда
				КонтекстФормы.Конфигурация = Конфигурация;
			КонецЕсли;
		КонецЕсли;
		Если НЕ КонтекстФормы.ЭтоКонвертацияXDTO И ЗначениеЗаполнено(ДанныеОбъекта.ОбъектКонфигурацииКорреспондент) Тогда
			Конфигурация = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ДанныеОбъекта.ОбъектКонфигурацииКорреспондент, "Владелец");
			Если КонтекстФормы.КонфигурацииКорреспондент.Найти(Конфигурация) <> Неопределено Тогда
				КонтекстФормы.КонфигурацияКорреспондент = Конфигурация;
			КонецЕсли;
		КонецЕсли;
		
		Если КонтекстФормы.Конфигурация = Неопределено Тогда
			КонтекстФормы.Конфигурация = КонтекстФормы.Конфигурации[0];
		КонецЕсли;
		Если НЕ КонтекстФормы.ЭтоКонвертацияXDTO И КонтекстФормы.КонфигурацияКорреспондент = Неопределено Тогда
			КонтекстФормы.КонфигурацияКорреспондент = КонтекстФормы.КонфигурацииКорреспондент[0];
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

Процедура КД3_ЗаполнитьЛокальныйКонтекст(Форма, КонтекстФормы)
	
	Если КонтекстФормы = Неопределено Тогда
		КонтекстФормы = КД3_ОпределитьКонтекстФормы(Форма);
	КонецЕсли;
	
	Если КонтекстФормы.ИмяКонтекста = "Запросы" Тогда
		Возврат; // Для запросов нет контекста
	КонецЕсли;
	
	ВсеРедакторы = рк_РедакторКодаКлиентСервер.ПараметрыВсехРедакторов(Форма);
	УникальныйИдентификаторФормы = Форма.УникальныйИдентификатор;
	
	// Общий контекст для всех обработчиков
	
	КонтекстОбщий = Новый Соответствие; // Ключ Истина - контекст для корреспондента
	
	// Общий контекст для всех обработчиков
	
	Если КонтекстФормы.ИмяКонтекста = "ПРО" Тогда
		КонтекстОбщий[Ложь] = НовыйКонтекст();
		
	ИначеЕсли КонтекстФормы.ЭтоКонвертацияXDTO Тогда
		
		КонтекстОбщий[Ложь] = ДанныеИзJSON(ПолучитьОбщийМакет("КД3_ЛокальныйКонтекстXDTO").ПолучитьТекст());
		
		ПараметрыКонвертации = КД3_ЛокальныйКонтекст_ПараметрыКонвертации(КонтекстФормы, Форма.Объект);
		ДобавитьПеременную(КонтекстОбщий[Ложь], "КомпонентыОбмена.ПараметрыКонвертации", ПараметрыКонвертации[Ложь]);
		
		КД3_ЛокальныйКонтекстXDTO_ДобавитьАлгоритмы(КонтекстОбщий[Ложь], КонтекстФормы);
	Иначе
		КонтекстОбщий[Ложь] = ДанныеИзJSON(ПолучитьОбщийМакет("КД3_ЛокальныйКонтекстXML").ПолучитьТекст());
		
		Если КонтекстФормы.ЕстьКорреспондент Тогда
			КонтекстОбщий[Истина] = НовыйКонтекст();
			ДополнитьКонтекст(КонтекстОбщий[Истина], КонтекстОбщий[Ложь]);
		КонецЕсли;
		
		ПараметрыКонвертации = КД3_ЛокальныйКонтекст_ПараметрыКонвертации(КонтекстФормы, Форма.Объект);
		ДобавитьПеременную(КонтекстОбщий[Ложь], "Параметры", ПараметрыКонвертации[Ложь]);
		Если КонтекстФормы.ЕстьКорреспондент Тогда
			ДобавитьПеременную(КонтекстОбщий[Истина], "Параметры", ПараметрыКонвертации[Истина]);
		КонецЕсли;
		
		АлгоритмыКонвертации = КД3_ЛокальныйКонтекстXML_ЗапросыАлгоритмы(КонтекстФормы, "Алгоритмы");
		ДобавитьПеременную(КонтекстОбщий[Ложь], "Алгоритмы", АлгоритмыКонвертации[Ложь]);
		Если КонтекстФормы.ЕстьКорреспондент Тогда
			ДобавитьПеременную(КонтекстОбщий[Истина], "Алгоритмы", АлгоритмыКонвертации[Истина]);
		КонецЕсли;
		
		ЗапросыКонвертации = КД3_ЛокальныйКонтекстXML_ЗапросыАлгоритмы(КонтекстФормы, "Запросы");
		ДобавитьПеременную(КонтекстОбщий[Ложь], "Запросы", ЗапросыКонвертации[Ложь]);
		Если КонтекстФормы.ЕстьКорреспондент Тогда
			ДобавитьПеременную(КонтекстОбщий[Истина], "Запросы", ЗапросыКонвертации[Истина]);
		КонецЕсли;
	КонецЕсли;
	
	// Контекст для каждого обработчика
	
	Для Каждого ЭлементСписка Из ВсеРедакторы Цикл
		ПараметрыРедактора = ЭлементСписка.Значение;
		
		КонтекстОбработчика = НовыйКонтекст();
		
		ДополнитьКонтекст(КонтекстОбработчика, КонтекстОбщий[ПараметрыРедактора.КД3_ДляКорреспондента]);
		
		ИмяОбработчика = ПараметрыРедактора.ИмяЭлементаТекст;
		
		Если КонтекстФормы.ИмяКонтекста = "ПРО" Тогда
			
			Если ИмяОбработчика = "АлгоритмПередОбработкойПравила" Тогда
				ДобавитьПеременную(КонтекстОбработчика, "Отказ");
				ДобавитьПеременную(КонтекстОбработчика, "Объект");
				ДобавитьПеременную(КонтекстОбработчика, "ОбъектМетаданных");
				ДобавитьПеременную(КонтекстОбработчика, "Выгрузка");
				ДобавитьПеременную(КонтекстОбработчика, "ПРО");
			ИначеЕсли ИмяОбработчика = "АлгоритмПередОбработкойПравила" Тогда
				ДобавитьПеременную(КонтекстОбработчика, "Отказ");
				ДобавитьПеременную(КонтекстОбработчика, "Объект");
				ДобавитьПеременную(КонтекстОбработчика, "ТекстЗапроса");
				ДобавитьПеременную(КонтекстОбработчика, "ПараметрыЗапроса");
				ДобавитьПеременную(КонтекстОбработчика, "ИспользоватьКэш");
				ДобавитьПеременную(КонтекстОбработчика, "Выгрузка");
			ИначеЕсли ИмяОбработчика = "АлгоритмПриОбработкеПравила" Тогда
				ДобавитьПеременную(КонтекстОбработчика, "Отказ");
				ДобавитьПеременную(КонтекстОбработчика, "Объект");
				ДобавитьПеременную(КонтекстОбработчика, "ТекстЗапроса");
				ДобавитьПеременную(КонтекстОбработчика, "ПараметрыЗапроса");
				ДобавитьПеременную(КонтекстОбработчика, "ИспользоватьКэш");
			ИначеЕсли ИмяОбработчика = "АлгоритмПослеОбработкиПравила" Тогда
				ДобавитьПеременную(КонтекстОбработчика, "Отказ");
				ДобавитьПеременную(КонтекстОбработчика, "Объект");
				ДобавитьПеременную(КонтекстОбработчика, "ОбъектМетаданных");
				ДобавитьПеременную(КонтекстОбработчика, "Выгрузка");
				ДобавитьПеременную(КонтекстОбработчика, "Получатели");
			КонецЕсли;
			
		ИначеЕсли КонтекстФормы.ЭтоКонвертацияXDTO Тогда
			
			Если КонтекстФормы.ИмяКонтекста = "ПКО" Тогда
				
				Если ИмяОбработчика = "АлгоритмПриОтправкеДанных" Тогда
					ДобавитьПеременную(КонтекстОбработчика, "ДанныеИБ");
					ДобавитьПеременную(КонтекстОбработчика, "ДанныеXDTO", Новый Структура);
					ДобавитьПеременную(КонтекстОбработчика, "СтекВыгрузки");
					ДобавитьПеременную(КонтекстОбработчика, "ДанныеИБ");
				ИначеЕсли ИмяОбработчика = "АлгоритмПередПолучениемДанных" Тогда
					ДобавитьПеременную(КонтекстОбработчика, "ДанныеXDTO", Новый Структура);
					ДобавитьПеременную(КонтекстОбработчика, "ПолученныеДанные");
				ИначеЕсли ИмяОбработчика = "АлгоритмПриПолученииДанных" Тогда
					ДобавитьПеременную(КонтекстОбработчика, "ПолученныеДанные");
					ДобавитьПеременную(КонтекстОбработчика, "ДанныеИБ");
					ДобавитьПеременную(КонтекстОбработчика, "КонвертацияСвойств", Новый ТаблицаЗначений);
				КонецЕсли;
				
			ИначеЕсли КонтекстФормы.ИмяКонтекста = "ПОД" Тогда
				
				Если ИмяОбработчика = "АлгоритмПриОбработке" Тогда
					ДобавитьПеременную(КонтекстОбработчика, "ОбъектОбработки");
					ДобавитьПеременную(КонтекстОбработчика, "ИспользованиеПКО", Новый Структура);
				КонецЕсли;
			КонецЕсли;
			
		Иначе // Конвертация XML
			
			Если КонтекстФормы.ИмяКонтекста = "ПКО" Тогда
				
				Если ИмяОбработчика = "АлгоритмПередВыгрузкойОбъекта" Тогда
					ДобавитьПеременную(КонтекстОбработчика, "ФайлОбмена");
					ДобавитьПеременную(КонтекстОбработчика, "Источник");
					ДобавитьПеременную(КонтекстОбработчика, "ВходящиеДанные");
					ДобавитьПеременную(КонтекстОбработчика, "ИсходящиеДанные");
					ДобавитьПеременную(КонтекстОбработчика, "ИмяПКО");
					ДобавитьПеременную(КонтекстОбработчика, "ПКО");
					ДобавитьПеременную(КонтекстОбработчика, "ВыгруженныеОбъекты");
					ДобавитьПеременную(КонтекстОбработчика, "Отказ");
					ДобавитьПеременную(КонтекстОбработчика, "КлючВыгружаемыхДанных");
					ДобавитьПеременную(КонтекстОбработчика, "ЗапоминатьВыгруженные");
					ДобавитьПеременную(КонтекстОбработчика, "НеЗамещатьОбъектПриЗагрузке");
					ДобавитьПеременную(КонтекстОбработчика, "ВсеОбъектыВыгружены");
					ДобавитьПеременную(КонтекстОбработчика, "ТолькоПолучитьУзелСсылки");
					ДобавитьПеременную(КонтекстОбработчика, "Приемник");
					ДобавитьПеременную(КонтекстОбработчика, "РежимЗаписи");
