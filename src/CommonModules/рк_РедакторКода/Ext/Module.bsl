Функция НовыйКонтекст() Экспорт
	
	Результат = Новый Структура;
	Результат.Вставить("customObjects", Новый Структура);
	Результат.Вставить("customFunctions", Новый Структура);
	
	Возврат Результат;
	
КонецФункции

Процедура ДополнитьКонтекст(КонтекстПрименик, КонтекстИсточник) Экспорт
	
	Для Каждого КлючИЗначение Из КонтекстИсточник.customObjects Цикл
		КонтекстПрименик.customObjects.Вставить(КлючИЗначение.Ключ, КлючИЗначение.Значение);
	КонецЦикла;
	Для Каждого КлючИЗначение Из КонтекстИсточник.customFunctions Цикл
		КонтекстПрименик.customFunctions.Вставить(КлючИЗначение.Ключ, КлючИЗначение.Значение);
	КонецЦикла;
	
КонецПроцедуры

Процедура УстановитьКонтекстРедактора(Форма, ПараметрыРедактора, Контекст) Экспорт
	
	ОписаниеЗапроса = Новый Структура;
	ОписаниеЗапроса.Вставить("Тип", "Контекст");
	ОписаниеЗапроса.Вставить("Данные", ДанныеВJSON(Контекст));
	
	РезультатыЗапроса = Новый Соответствие;
	РезультатыЗапроса["Контекст"] = ОписаниеЗапроса;
	
	ПараметрыРедактора.Вставить("АдресКонтекст", ПоместитьВоВременноеХранилище(РезультатыЗапроса, Форма.УникальныйИдентификатор));
	
КонецПроцедуры

Процедура ДобавитьПеременную(Контекст, ИмяПеременной, ЗначениеПеременной = Неопределено) Экспорт
	
	Если ЗначениеПеременной = Неопределено Тогда
		ОписаниеЗначения = Новый Структура;
	Иначе
		ОписаниеЗначения = НовоеЗначение(ЗначениеПеременной, 1);
	КонецЕсли;
	
	ЧастиИмени = СтрРазделить(ИмяПеременной, ".");
	Если ЧастиИмени.Количество() = 1 Тогда
		Контекст.customObjects.Вставить(ИмяПеременной, ОписаниеЗначения);
	Иначе
		ВладелецЗначения = Контекст.customObjects;
		Для Ном = 0 По ЧастиИмени.ВГраница() - 1 Цикл
			ИмяСвойства = ЧастиИмени[Ном];
			Если НЕ ВладелецЗначения.Свойство(ИмяСвойства) Тогда
				ВладелецЗначения.Вставить(ИмяСвойства);
			КонецЕсли;
			ВладелецЗначения = ВладелецЗначения[ИмяСвойства];
			Если НЕ ВладелецЗначения.Свойство("properties") Тогда
				ВладелецЗначения.Вставить("properties", Новый Структура);
			КонецЕсли;
			ВладелецЗначения = ВладелецЗначения.properties;
		КонецЦикла;
		ВладелецЗначения.Вставить(ЧастиИмени[Ном], ОписаниеЗначения);
	КонецЕсли;
	
КонецПроцедуры

Процедура ДобавитьФункцию(Контекст, Имя, Параметры = "", Описание = "") Экспорт
	
	ОписаниеПараметров = Новый Структура;
	
	Для Каждого ИмяПараметра Из СтрРазделить(Параметры, ",", Ложь) Цикл
		
		ИмяПараметра = СокрЛ(ИмяПараметра);
		Если НРег(Лев(ИмяПараметра, 5)) = "знач " Тогда
			ИмяПараметра = Сред(ИмяПараметра, 5);
		КонецЕсли;
		ПозРавно = СтрНайти(ИмяПараметра, "=");
		Если ПозРавно <> 0 Тогда
			ИмяПараметра = Лев(ИмяПараметра, ПозРавно - 1);
		КонецЕсли;
		ОписаниеПараметров.Вставить(ИмяПараметра, СокрЛП(ИмяПараметра));
		
	КонецЦикла;
	
	ОписаниеМетода = Новый Структура;
	ОписаниеМетода.Вставить("name", Имя);
	ОписаниеМетода.Вставить("description", Описание);
	ОписаниеМетода.Вставить("signature", Новый Структура("default", Новый Структура));
	
	ОписаниеМетода.signature.default.Вставить("СтрокаПараметров", СтрШаблон("(%1)", Параметры));
	ОписаниеМетода.signature.default.Вставить("Параметры", ОписаниеПараметров);
	
	Контекст.customFunctions.Вставить(Имя, ОписаниеМетода);
	
КонецПроцедуры

