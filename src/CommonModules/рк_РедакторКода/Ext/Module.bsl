Процедура ОбработчикПриСозданииНаСервере(Форма, НовыеРедакторы, НастройкиКонфигураций = Неопределено) Экспорт
	
	НормализованныеПараметры = НормализоватьПараметрыИнициализации(Форма, НовыеРедакторы);
	
	ДобавитьРеквизитыФормы(Форма, НормализованныеПараметры);
	
	ОбщиеПараметры = рк_РедакторКодаКлиентСервер.ОбщиеПараметры(Форма);
	ОбщиеПараметры.Вставить("АдресНастройки", ПоместитьВоВременноеХранилище(Настройки(), Форма.УникальныйИдентификатор));
	ОбщиеПараметры.Вставить("ИспользоватьРедактор", ИспользоватьРедактор());
	ОбщиеПараметры.Вставить("ПодсказкаПоМетаданным", ПодсказкаПоМетаданным());
	
	Если НормализованныеПараметры.Количество() = 1 И НормализованныеПараметры[0].ЭлементТекст = Неопределено Тогда
		// Если указан только один редактор HTML, то он будет доступен по-умолчанию
		ОбщиеПараметры.ИспользоватьРедактор = Истина;
	КонецЕсли;
	
	КонфигурацииРедакторов = ДобавитьРедакторы(Форма, НормализованныеПараметры);
	
	СохранитьНастройкиКонфигураций(Форма, КонфигурацииРедакторов, НастройкиКонфигураций);
	
	Если ОбщиеПараметры.ИспользоватьРедактор Тогда
		УстановитьВебСтраницыРедакторов(Форма, ОбщиеПараметры);
	КонецЕсли;
	
КонецПроцедуры

// Необходим для обновления текста редактора при нажатии кнопки "Перечитать" в форме объекта
