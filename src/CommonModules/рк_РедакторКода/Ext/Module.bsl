// Получает настройки редактора кода для текущего пользователя
// 
// Возвращаемое значение:
//   Структура - Настройки редактора:
//     * ПодсказкаПоМетаданным - Булево - получать и отображать метаданные для подсказки
//     * ОбработчикМодуулей - Строка - имя обработчика для разбора кода модулей или Неопределено, если используется обработчик bsl_console
//     * Тема - Строка - название темы
//     * БыстрыеПодсказки - Булево - включены ли быстрые подсказки
//     * КартаКода - Булево - отображать ли карту кода
//     * ПробелыИТабуляции - Булево - отображать ли пробелы и табуляции
//     * СтрокаСостояния - Булево - отображать ли строку состояния
//     * ЯзыкПодсказок - Строка - имя языка подсказок
//     * ОтключитьВстроенныеСниппеты - Булево - использовать встроенные в bsl_console сниппеты или нет
//     * ПутьКШаблонамКода - Строка - путь к файлу шаблонов кода
//
Функция НовыеНастройки() Экспорт
	
	Настройки = Новый Структура;
	
	Настройки.Вставить("Тема", "bsl-white");
	Настройки.Вставить("БыстрыеПодсказки", Истина);
	Настройки.Вставить("КартаКода", Истина);
	Настройки.Вставить("ПробелыИТабуляции", Ложь);
	Настройки.Вставить("СтрокаСостояния", Истина);
	Настройки.Вставить("ЯзыкПодсказок", "ru");
	Настройки.Вставить("ОтключитьВстроенныеСниппеты", Ложь);
	Настройки.Вставить("ПутьКШаблонамКода", "");
	
	Возврат Настройки;
	
КонецФункции

