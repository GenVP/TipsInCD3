		Если СлужебныеДанные.BasePeriod Тогда
			ДобавитьРеквизитXML(СтруктураРеквизитов, ОписанияТипов, "БазовыйПериодНачало", "", Неопределено);
			ДобавитьРеквизитXML(СтруктураРеквизитов, ОписанияТипов, "БазовыйПериодКонец", "", Неопределено);
		КонецЕсли;
		
	ИначеЕсли ОписанияТипов.ИмяКоллекцииМетаданных = "ПланыВидовРасчета" Тогда
		ДобавитьРеквизитXML(СтруктураРеквизитов, ОписанияТипов, "Ссылка", "", СсылкаНаОбъект);
		Если СлужебныеДанные.ActionPeriodUse Тогда
			ДобавитьРеквизитXML(СтруктураРеквизитов, ОписанияТипов, "ПериодДействияБазовый", "", Неопределено);
