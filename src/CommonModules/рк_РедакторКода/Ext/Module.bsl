Функция КД3_ЛокальныйКонтекст_ПараметрыКонвертации(КонтекстФормы, ФормаОбъект)
	
	Переменные = Новый Соответствие;
	Переменные[Ложь] = Новый Структура;
	Если НЕ КонтекстФормы.ЭтоКонвертацияXDTO Тогда
		Переменные[Истина] = Новый Структура;
	КонецЕсли;
	
	Если КонтекстФормы.ИмяКонтекста = "Конвертации" Тогда
		ТаблицаПараметров = ФормаОбъект.Параметры;
	Иначе
		Запрос = Новый Запрос;
		Запрос.Текст =
		"ВЫБРАТЬ
		|	КонвертацииПараметры.Параметр КАК Параметр,
		|	КонвертацииПараметры.ИспользуетсяПриЗагрузке КАК ИспользуетсяПриЗагрузке,
		|	КонвертацииПараметры.ПередаватьПараметрПриВыгрузке КАК ПередаватьПараметрПриВыгрузке,
		|	КонвертацииПараметры.ТипОбъекта КАК ТипОбъекта
		|ИЗ
		|	Справочник.Конвертации.Параметры КАК КонвертацииПараметры
		|ГДЕ
		|	КонвертацииПараметры.Ссылка В(&Конвертации)";
		Запрос.УстановитьПараметр("Конвертации", КонтекстФормы.Конвертации);
		ТаблицаПараметров = Запрос.Выполнить().Выгрузить();
	КонецЕсли;
	
	Для Каждого СтрокаПараметра Из ТаблицаПараметров Цикл
		
		ДляКорреспондента = НЕ КонтекстФормы.ЭтоКонвертацияXDTO И (СтрокаПараметра.ИспользуетсяПриЗагрузке ИЛИ СтрокаПараметра.ПередаватьПараметрПриВыгрузке);
		Переменные[ДляКорреспондента].Вставить(СокрЛП(СтрокаПараметра.Параметр));
		
	КонецЦикла;
	
	Возврат Переменные;
	
КонецФункции

Функция КД3_ЛокальныйКонтекстXML_ЗапросыАлгоритмы(КонтекстФормы, ИмяСправочника)
	
	Переменные = Новый Соответствие;
	Переменные[Ложь] = Новый Структура;
	Если НЕ КонтекстФормы.ЭтоКонвертацияXDTO Тогда
		Переменные[Истина] = Новый Структура;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Правила.Код КАК Имя,
	|	Правила.ИспользуетсяПриЗагрузке КАК ИспользуетсяПриЗагрузке
	|ИЗ
	|	Справочник.СоставыКонвертаций КАК СоставыКонвертаций
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник." + ИмяСправочника + " КАК Правила
	|		ПО СоставыКонвертаций.ЭлементКонвертации = Правила.Ссылка
	|ГДЕ
	|	СоставыКонвертаций.Владелец В (&Конвертации)
	|	И НЕ Правила.ПометкаУдаления";
	Запрос.УстановитьПараметр("Конвертации", КонтекстФормы.Конвертации);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		ДляКорреспондента = НЕ КонтекстФормы.ЭтоКонвертацияXDTO И Выборка.ИспользуетсяПриЗагрузке;
		Переменные[ДляКорреспондента].Вставить(СокрЛП(Выборка.Имя));
	КонецЦикла;
	
	Возврат Переменные;
	
КонецФункции

Процедура КД3_ЛокальныйКонтекстXDTO_ДобавитьАлгоритмы(Контекст, КонтекстФормы)
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Правила.Код КАК Имя,
	|	Правила.Параметры КАК Параметры
	|ИЗ
	|	Справочник.СоставыКонвертаций КАК СоставыКонвертаций
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Алгоритмы КАК Правила
	|		ПО СоставыКонвертаций.ЭлементКонвертации = Правила.Ссылка
	|ГДЕ
	|	СоставыКонвертаций.Владелец В(&Конвертации)
	|	И НЕ Правила.ПометкаУдаления";
	
	Запрос.УстановитьПараметр("Конвертации", КонтекстФормы.Конвертации);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		ДобавитьФункцию(Контекст, СокрЛП(Выборка.Имя), Выборка.Параметры, "");
	КонецЦикла;
	
