	Результат.Вставить("ЭлементСтраница");
	
	Результат.Вставить("Конфигурация");
	Результат.Вставить("Параметры", Новый Структура); // Произвольные параметры для сохранения в редакторе
	Результат.Вставить("Настройки", Новый Структура); // Переопределяемые общие настройки
	Результат.Вставить("Контекст", Новый Структура);
	
	Возврат Результат;
	
