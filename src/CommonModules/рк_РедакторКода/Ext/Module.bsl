КонецПроцедуры

Функция ЭтоУзелXML(ЧтениеXML, ИмяУзла)
	Возврат ЧтениеXML.Имя = ИмяУзла И ЧтениеXML.ТипУзла = ТипУзлаXML.НачалоЭлемента;
КонецФункции

Функция ЭтоКонецУзлаXML(ЧтениеXML, ИмяУзла)
	Возврат ЧтениеXML.Имя = ИмяУзла И ЧтениеXML.ТипУзла = ТипУзлаXML.КонецЭлемента;
КонецФункции

Процедура ПрочитатьСвойствоСтруктурыXML(ЧтениеXML, ОписаниеЭлемента, ОсталосьСвойств = 0)
	
	ИмяЭлемента = ЧтениеXML.Имя;
	ЗначениеПоУмолчанию = Неопределено;
	Если ОписаниеЭлемента.Свойство(ИмяЭлемента, ЗначениеПоУмолчанию) Тогда
		Если НРег(ИмяЭлемента) = "synonym" Тогда
			ПрочитатьМультистрокуXML(ЧтениеXML, ОписаниеЭлемента, "ru", ОсталосьСвойств);
		ИначеЕсли НРег(ИмяЭлемента) = "type" Тогда
			ПрочитатьТипыXML(ЧтениеXML, ОписаниеЭлемента, ОсталосьСвойств);
		ИначеЕсли НРег(ИмяЭлемента) = "owners" Тогда
			ПрочитатьВладельцевXML(ЧтениеXML, ОписаниеЭлемента, ОсталосьСвойств);
		Иначе
			ОписаниеЭлемента.Вставить(ИмяЭлемента, ПрочитатьЗначениеXML(ЧтениеXML, ЗначениеПоУмолчанию));
			ОсталосьСвойств = ОсталосьСвойств - 1;
		КонецЕсли;
	Иначе
		ЧтениеXML.Пропустить();
		ЧтениеXML.Прочитать();
	КонецЕсли;
	
КонецПроцедуры

Функция ПрочитатьЗначениеXML(ЧтениеXML, ЗначениеПоУмолчанию = Неопределено)
	
	ИмяЭлемента = ЧтениеXML.Имя;
	
	Значение = ЗначениеПоУмолчанию;
	Пока НЕ ЭтоКонецУзлаXML(ЧтениеXML, ИмяЭлемента) Цикл
		Если ЧтениеXML.ТипУзла = ТипУзлаXML.Текст Тогда
			Значение = ЧтениеXML.Значение;
		КонецЕсли;
		ЧтениеXML.Прочитать();
	КонецЦикла;
	ЧтениеXML.Прочитать();
	
	Если ЗначениеПоУмолчанию <> Неопределено Тогда
		Значение = XMLЗначение(ТипЗнч(ЗначениеПоУмолчанию), Значение);
	КонецЕсли;
	
	Возврат Значение;
	
КонецФункции

Процедура ПрочитатьМультистрокуXML(ЧтениеXML, СтруктураДляЗначения, КодЯзыка, ОсталосьСвойств)
	
	ИмяЭлемента = ЧтениеXML.Имя;
	ЧтениеXML.Прочитать();
	
	Значение = "";
	Пока НЕ ЭтоКонецУзлаXML(ЧтениеXML, ИмяЭлемента) Цикл
		Если ЧтениеXML.Имя = "v8:item" Тогда
			ЧтениеXML.Прочитать();
		Иначе
			langKey = ПрочитатьЗначениеXML(ЧтениеXML);
			contentValue = ПрочитатьЗначениеXML(ЧтениеXML);
			Если langKey = КодЯзыка Тогда
				Значение = contentValue;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	ЧтениеXML.Прочитать();
	
	СтруктураДляЗначения.Вставить(ИмяЭлемента, Значение);
	ОсталосьСвойств = ОсталосьСвойств - 1;
	
КонецПроцедуры

Процедура ПрочитатьВладельцевXML(ЧтениеXML, СтруктураДляЗначения, ОсталосьСвойств)
	
	ИмяЭлемента = ЧтениеXML.Имя;
	
	МассивТипов = Новый Массив;
	Пока ЭтоУзелXML(ЧтениеXML, ИмяЭлемента) Цикл
		ЧтениеXML.Прочитать();
		Если ЧтениеXML.ТипУзла = ТипУзлаXML.КонецЭлемента Тогда
			ЧтениеXML.Прочитать();
			Прервать;
		ИначеЕсли ЧтениеXML.ТипУзла = ТипУзлаXML.Текст Тогда
			// Формат EDT
			МассивТипов.Добавить(ЧтениеXML.Значение);
			ЧтениеXML.Прочитать();
			ЧтениеXML.Прочитать();
		Иначе
			// Формат XML
			МассивТипов.Добавить(ПрочитатьЗначениеXML(ЧтениеXML));
		КонецЕсли;
	КонецЦикла;
	
	СтруктураДляЗначения.Вставить(ИмяЭлемента, МассивТипов);
	ОсталосьСвойств = ОсталосьСвойств - 1;
	
КонецПроцедуры

Процедура ПрочитатьТипыXML(ЧтениеXML, СтруктураДляЗначения, ОсталосьСвойств)
	
	ИмяЭлемента = ЧтениеXML.Имя;
	ЧтениеXML.Прочитать();
	
	МассивТипов = Новый Массив;
	Пока НЕ ЭтоКонецУзлаXML(ЧтениеXML, ИмяЭлемента) Цикл
		Если ЭтоУзелXML(ЧтениеXML, "v8:Type") ИЛИ ЭтоУзелXML(ЧтениеXML, "types") Тогда
			МассивТипов.Добавить(ПрочитатьЗначениеXML(ЧтениеXML));
		Иначе
			ЧтениеXML.Пропустить();
			ЧтениеXML.Прочитать();
		КонецЕсли;
	КонецЦикла;
	ЧтениеXML.Прочитать();
	
	СтруктураДляЗначения.Вставить(ИмяЭлемента, МассивТипов);
	ОсталосьСвойств = ОсталосьСвойств - 1;
	
КонецПроцедуры

#КонецЕсли

#КонецОбласти

#Область ПользовательскийКонтекст

Функция НовыйТипЗначения(ТипЗначения)
	
	ОписаниеЗначения = Новый Структура;
	
	Если ТипЗнч(ТипЗначения) = Тип("Строка") Тогда
		ОписаниеЗначения.Вставить("ref", ТипЗначения);
	ИначеЕсли ТипЗначения = Тип("Структура") Тогда
		ОписаниеЗначения.Вставить("ref", "classes.Структура");
	ИначеЕсли ТипЗначения = Тип("Массив") Тогда
		ОписаниеЗначения.Вставить("ref", "classes.Массив");
	ИначеЕсли ТипЗначения = Тип("Соответствие") Тогда
		ОписаниеЗначения.Вставить("ref", "classes.Соответствие");
	ИначеЕсли ТипЗначения = Тип("ТаблицаЗначений") Тогда
		ОписаниеЗначения.Вставить("ref", "classes.ТаблицаЗначений");
	КонецЕсли;
	
	Возврат ОписаниеЗначения;
	
КонецФункции

Функция НовоеЗначение(ЗначениеПеременной, Знач УровеньВложенности)
	
	ОписаниеЗначения = НовыйТипЗначения(ТипЗнч(ЗначениеПеременной));
	
	Если ТипЗнч(ЗначениеПеременной) = Тип("Структура") И ЗначениеПеременной.Количество() > 0 Тогда
		
		УровеньВложенности = УровеньВложенности + 1;
		Если УровеньВложенности < 4 Тогда
			
			ОписаниеЗначения.Вставить("properties", Новый Структура);
			Для Каждого КлючИЗначение Из ЗначениеПеременной Цикл
				ОписаниеЗначения.properties.Вставить(КлючИЗначение.Ключ, НовоеЗначение(КлючИЗначение.Значение, УровеньВложенности));
			КонецЦикла;
			
		КонецЕсли;
	КонецЕсли;
	
	Возврат ОписаниеЗначения;
	
КонецФункции

#КонецОбласти

#КонецОбласти
