	ИначеЕсли ОписанияТипов.ИмяКоллекцииМетаданных = "РегистрыРасчета" Тогда
		ДобавитьРеквизитXML(СтруктураРеквизитов, ОписанияТипов, "ПериодРегистрации", "", Неопределено);
		ДобавитьРеквизитXML(СтруктураРеквизитов, ОписанияТипов, "Активность", "", Неопределено);
		ДобавитьРеквизитXML(СтруктураРеквизитов, ОписанияТипов, "Сторно", "", Неопределено);
		ДобавитьРеквизитXML(СтруктураРеквизитов, ОписанияТипов, "Регистратор", "", Неопределено);
		ДобавитьРеквизитXML(СтруктураРеквизитов, ОписанияТипов, "ВидРасчета", "", Неопределено);
		Если СлужебныеДанные.ActionPeriod Тогда
			ДобавитьРеквизитXML(СтруктураРеквизитов, ОписанияТипов, "ПериодДействия", "", Неопределено);
