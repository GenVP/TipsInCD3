// Проверяет версию платформы 1С на соответствие требуемой
//
// Параметры:
//  ТребуемаяВерсия - Строка - версия в формате "X.Y.Z"
//
// Возвращаемое значение:
// Булево - Истина, если номер ерсии платформы 1С больше или равна требуемой
//
Функция СравнитьВерсиюПлатформы(ТребуемаяВерсия) Экспорт
	
	Инфо = Новый СистемнаяИнформация;
	
	ЧастиВерсии1 = СтрРазделить(Инфо.ВерсияПриложения, ".");
	ЧастиВерсии2 = СтрРазделить(ТребуемаяВерсия, ".");
	
	Для НомРазряда = 0 По 2 Цикл
		Разница = Число(ЧастиВерсии1[НомРазряда]) - Число(ЧастиВерсии2[НомРазряда]);
		Если Разница <> 0 Тогда
			Возврат Разница >= 0;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Истина;
	
КонецФункции

