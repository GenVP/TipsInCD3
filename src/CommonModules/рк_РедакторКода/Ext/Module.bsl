Функция ЗагрузитьНастройкиИзХранилища(КлючНастроек, НовыеНастройки)
	
	КлючОбъекта = "рк_РедакторКода";
	СохраненныеНастройки = ХранилищеОбщихНастроек.Загрузить(КлючОбъекта, КлючНастроек);
	Если ТипЗнч(СохраненныеНастройки) = Тип("Структура") Тогда
		ЗаполнитьЗначенияСвойств(НовыеНастройки, СохраненныеНастройки);
	ИначеЕсли ТипЗнч(СохраненныеНастройки) = ТипЗнч(НовыеНастройки) Тогда
		НовыеНастройки = СохраненныеНастройки;
	КонецЕсли;
	Возврат НовыеНастройки;
	
КонецФункции

Функция СохранитьНастройкиВХранилище(КлючНастроек, Настройки)
	
	КлючОбъекта = "рк_РедакторКода";
	ХранилищеОбщихНастроек.Сохранить(КлючОбъекта, КлючНастроек, Настройки);
	Возврат Настройки;
	
КонецФункции

