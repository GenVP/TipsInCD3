		ДобавитьРеквизитXML(СтруктураРеквизитов, ОписанияТипов, "ПометкаУдаления", "", Неопределено);
		
	ИначеЕсли ОписанияТипов.ИмяКоллекцииМетаданных = "ПланыОбмена" Тогда
